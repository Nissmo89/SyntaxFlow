    "oracle": {
      "python3": {
        "call": "Checker().findLHS(nums, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def findLHS(self, nums, result):\n        counts = Counter(nums)\n        best = 0\n        for x in counts:\n            if x + 1 in counts:\n                best = max(best, counts[x] + counts[x + 1])\n        return result == best\n"
      }
    },
