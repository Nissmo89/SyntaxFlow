      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().findMaxAverage(nums, k, {result})",
        "checker": "class Checker:\n    def findMaxAverage(self, nums, k, result):\n        if not isinstance(result, (int, float)):\n            return False\n        window_sum = sum(nums[:k])\n        max_sum = window_sum\n        for i in range(k, len(nums)):\n            window_sum = window_sum - nums[i - k] + nums[i]\n            if window_sum > max_sum:\n                max_sum = window_sum\n        expected = max_sum / k\n        return abs(result - expected) <= 1e-5\n"
      }
    },
