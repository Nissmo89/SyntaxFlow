    "oracle": {
      "python3": {
        "call": "Checker().check(num, {result})",
        "checker": "class Checker:\n    def check(self, num, result):\n        if not isinstance(num, int) or not isinstance(result, int):\n            return False\n        if num < 1 or num >= 2 ** 31:\n            return False\n        bit = 1\n        curr = num\n        expected = num\n        while curr > 0:\n            expected ^= bit\n            bit <<= 1\n            curr >>= 1\n        return expected == result\n"
      }
    },
