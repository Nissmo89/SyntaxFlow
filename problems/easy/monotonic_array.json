    "oracle": {
      "python3": {
        "call": "Checker().isMonotonic(nums, {result})",
        "checker": "class Checker:\n    def isMonotonic(self, nums, result):\n        inc = True\n        dec = True\n        for i in range(1, len(nums)):\n            if nums[i] < nums[i - 1]:\n                inc = False\n            if nums[i] > nums[i - 1]:\n                dec = False\n        return result == (inc or dec)\n"
      }
    },
