    "oracle": {
      "python3": {
        "call": "Checker().isUgly(n, {result})",
        "checker": "class Checker:\n    def isUgly(self, n, result):\n        if not isinstance(n, int) or isinstance(n, bool):\n            return False\n        if not isinstance(result, bool):\n            return False\n        expected = self._is_ugly(n)\n        return result == expected\n\n    def _is_ugly(self, n):\n        if n <= 0:\n            return False\n        for p in (2, 3, 5):\n            while n % p == 0:\n                n //= p\n        return n == 1\n"
      }
    },
