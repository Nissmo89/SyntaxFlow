    "oracle": {
      "python3": {
        "call": "Checker().binaryGap(n, {result})",
        "checker": "from typing import Any\n\nclass Checker:\n    def binaryGap(self, n: int, result: Any) -> bool:\n        if not isinstance(result, int):\n            return False\n        bits = []\n        x = n\n        while x > 0:\n            bits.append(x & 1)\n            x >>= 1\n        last = None\n        best = 0\n        for i, bit in enumerate(bits):\n            if bit == 1:\n                if last is not None:\n                    best = max(best, i - last)\n                last = i\n        return result == best\n"
      }
    },
