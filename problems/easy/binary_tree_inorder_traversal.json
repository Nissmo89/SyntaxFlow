    "oracle": {
      "python3": {
        "call": "Checker().inorderTraversal(root, {result})",
        "checker": "class Checker:\n    def inorderTraversal(self, root, result):\n        ans = []\n        def dfs(node):\n            if node is None:\n                return\n            dfs(node.left)\n            ans.append(node.val)\n            dfs(node.right)\n        dfs(root)\n        return ans == result\n"
      }
    },
