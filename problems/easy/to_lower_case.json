    "oracle": {
      "python3": {
        "call": "Checker().toLowerCase(s, {result})",
        "checker": "class Checker:\n    def toLowerCase(self, s, result):\n        if not isinstance(result, str):\n            return False\n        if len(result) != len(s):\n            return False\n        for a, b in zip(s, result):\n            if not isinstance(a, str) or not isinstance(b, str):\n                return False\n            if len(a) != 1 or len(b) != 1:\n                return False\n        return result == s.lower()\n"
      }
    },
