{
  "id": "excel_sheet_column_title",
  "title": "Excel Sheet Column Title",
  "difficulty": "Easy",
  "category": "Algorithms",
  "tags": [
    "Math",
    "String"
  ],
  "description": "<p>Given an integer <code>columnNumber</code>, return <em>its corresponding column title as it appears in an Excel sheet</em>.</p> <p>For example:</p> <pre>A -&gt; 1\nB -&gt; 2\nC -&gt; 3\n...\nZ -&gt; 26\nAA -&gt; 27\nAB -&gt; 28 \n...\n</pre> <p> </p> <p><strong class=\"example\">Example 1:</strong></p> <pre><strong>Input:</strong> columnNumber = 1\n<strong>Output:</strong> \"A\"\n</pre> <p><strong class=\"example\">Example 2:</strong></p> <pre><strong>Input:</strong> columnNumber = 28\n<strong>Output:</strong> \"AB\"\n</pre> <p><strong class=\"example\">Example 3:</strong></p> <pre><strong>Input:</strong> columnNumber = 701\n<strong>Output:</strong> \"ZY\"\n</pre> <p> </p> <p><strong>Constraints:</strong></p> <ul> <li><code>1 &lt;= columnNumber &lt;= 2<sup>31</sup> - 1</code></li> </ul>",
  "hints": [],
  "method": {
    "name": "convertToTitle",
    "returnType": "auto",
    "params": [
      {
        "name": "columnNumber",
        "type": "int"
      }
    ]
  },
