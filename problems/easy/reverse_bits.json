    "oracle": {
      "python3": {
        "call": "Checker().reverseBits(n, {result})",
        "checker": "class Checker:\n    def reverseBits(self, n, result):\n        if not isinstance(n, int) or not isinstance(result, int):\n            return False\n        if n < 0 or n > 2147483646 or (n & 1) != 0:\n            return False\n        expected = 0\n        x = n\n        for _ in range(32):\n            expected = (expected << 1) | (x & 1)\n            x >>= 1\n        return result == expected\n"
      }
    },
