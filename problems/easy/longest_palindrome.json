      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(s, {result})",
        "checker": "class Checker:\n    def check(self, s, result):\n        if not isinstance(result, int):\n            return False\n        if result < 1 or result > len(s):\n            return False\n        counts = {}\n        for c in s:\n            counts[c] = counts.get(c, 0) + 1\n        expected = 0\n        odd = False\n        for freq in counts.values():\n            if freq % 2 == 0:\n                expected += freq\n            else:\n                expected += freq - 1\n                odd = True\n        expected += 1 if odd else 0\n        return result == expected\n"
      }
    },
