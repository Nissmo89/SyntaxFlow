      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().mergeTrees(root1, root2, {result})",
        "checker": "class Checker:\n    def _build_tree(self, values):\n        if not isinstance(values, list) or not values:\n            return None\n        nodes = [None if v is None else type(\"Node\", (), {\"val\": v, \"left\": None, \"right\": None})() for v in values]\n        kids = nodes[::-1]\n        root = kids.pop()\n        for node in nodes:\n            if node is not None:\n                if kids:\n                    node.left = kids.pop()\n                if kids:\n                    node.right = kids.pop()\n        return root\n\n    def _serialize(self, node):\n        if node is None:\n            return []\n        out = []\n        queue = [node]\n        while queue:\n            cur = queue.pop(0)\n            if cur is None:\n                out.append(None)\n                continue\n            out.append(cur.val)\n            queue.append(cur.left)\n            queue.append(cur.right)\n        while out and out[-1] is None:\n            out.pop()\n        return out\n\n    def _merge(self, a, b):\n        if a is None:\n            return b\n        if b is None:\n            return a\n        a.val += b.val\n        a.left = self._merge(a.left, b.left)\n        a.right = self._merge(a.right, b.right)\n        return a\n\n    def mergeTrees(self, root1, root2, result):\n        if not isinstance(result, list):\n            return False\n        expected = self._serialize(self._merge(self._build_tree(root1), self._build_tree(root2)))\n        return result == expected\n"
      }
    },
