      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().reverseList(head, {result})",
        "checker": "class Checker:\n    def reverseList(self, head, result):\n        if head is None:\n            expected = []\n        else:\n            expected = list(head)[::-1]\n\n        if result is None:\n            actual = []\n        elif isinstance(result, list):\n            actual = result\n        else:\n            actual = []\n            seen = 0\n            node = result\n            while node is not None:\n                actual.append(getattr(node, \"val\", None))\n                node = getattr(node, \"next\", None)\n                seen += 1\n                if seen > 20000:\n                    return False\n\n        return actual == expected\n"
      }
    },
