    "judge": {
      "type": "exact"
    },
    "limits": {
      "time_ms": 200,
      "memory_mb": 300
    },
    "oracle": {
      "python3": {
        "call": "Checker().removeDuplicates(s, {result})",
        "checker": "class Checker:\n    def removeDuplicates(self, s, result) -> bool:\n        stack = []\n        for ch in s:\n            if stack and stack[-1] == ch:\n                stack.pop()\n            else:\n                stack.append(ch)\n        return result == \"\".join(stack)\n"
      }
    },
