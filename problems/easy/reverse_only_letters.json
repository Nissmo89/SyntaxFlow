    "oracle": {
      "python3": {
        "call": "Checker().reverseOnlyLetters(s, {result})",
        "checker": "class Checker:\n    def reverseOnlyLetters(self, s, result):\n        if not isinstance(result, str):\n            return False\n        letters = [ch for ch in s if ch.isalpha()]\n        expected = []\n        idx = len(letters) - 1\n        for ch in s:\n            if ch.isalpha():\n                expected.append(letters[idx])\n                idx -= 1\n            else:\n                expected.append(ch)\n        return ''.join(expected) == result\n"
      }
    },
