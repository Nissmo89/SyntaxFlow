    "oracle": {
      "python3": {
        "call": "Checker().majorityElement(nums, {result})",
        "checker": "class Checker:\n    def majorityElement(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        count = 0\n        for num in nums:\n            if num == result:\n                count += 1\n        return count > len(nums) // 2\n"
      }
    },
