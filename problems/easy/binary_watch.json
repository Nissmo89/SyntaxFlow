      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().readBinaryWatch(turnedOn, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def readBinaryWatch(self, turnedOn: int, result: Any) -> bool:\n        if not isinstance(result, list):\n            return False\n        if any(not isinstance(x, str) for x in result):\n            return False\n        expected = [\n            f\"{hour}:{minute:02d}\"\n            for hour in range(12)\n            for minute in range(60)\n            if (bin(hour).count(\"1\") + bin(minute).count(\"1\")) == turnedOn\n        ]\n        return sorted(result) == sorted(expected)\n"
      }
    },
