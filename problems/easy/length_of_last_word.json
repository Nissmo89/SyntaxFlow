    "oracle": {
      "python3": {
        "call": "Checker().lengthOfLastWord(s, {result})",
        "checker": "import json\n\nclass Checker:\n    def lengthOfLastWord(self, s, result):\n        try:\n            result = json.loads(result) if isinstance(result, str) else result\n        except Exception:\n            return False\n        if not isinstance(s, str):\n            return False\n        if not isinstance(result, int):\n            return False\n        if any(ch not in \"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz \" for ch in s):\n            return False\n        if len(s) < 1 or len(s) > 10000:\n            return False\n        words = s.split()\n        expected = len(words[-1]) if words else 0\n        return expected == result\n"
      }
    },
