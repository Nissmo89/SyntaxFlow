      "python3": {
        "call": "Checker().selfDividingNumbers(left, right, {result})",
        "checker": "class Checker:\n    def selfDividingNumbers(self, left, right, result):\n        if not isinstance(result, list):\n            return False\n        if any(type(x) is not int for x in result):\n            return False\n\n        def is_self_dividing(n):\n            value = n\n            while value > 0:\n                digit = value % 10\n                if digit == 0 or n % digit != 0:\n                    return False\n                value //= 10\n            return True\n\n        expected = [n for n in range(left, right + 1) if is_self_dividing(n)]\n        return result == expected\n"
      }
    },
