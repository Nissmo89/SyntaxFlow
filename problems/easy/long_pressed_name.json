      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().isLongPressedName(name, typed, {result})",
        "checker": "class Checker:\n    def isLongPressedName(self, name, typed, result):\n        i = j = 0\n        while j < len(typed):\n            if i < len(name) and name[i] == typed[j]:\n                i += 1\n                j += 1\n            elif j > 0 and typed[j] == typed[j - 1]:\n                j += 1\n            else:\n                return result == False\n        return result == (i == len(name))\n"
      }
    },
