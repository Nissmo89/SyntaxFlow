    "oracle": {
      "python3": {
        "call": "Checker().backspaceCompare(s, t, {result})",
        "checker": "class Checker:\n    def _reduce(self, text):\n        stack = []\n        for ch in text:\n            if ch == '#':\n                if stack:\n                    stack.pop()\n            else:\n                stack.append(ch)\n        return ''.join(stack)\n\n    def backspaceCompare(self, s, t, result):\n        if not isinstance(result, bool):\n            return False\n        return result == (self._reduce(s) == self._reduce(t))\n"
      }
    },
