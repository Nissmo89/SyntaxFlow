    "oracle": {
      "python3": {
        "call": "Checker().calPoints(operations, {result})",
        "checker": "class Checker:\n    def calPoints(self, operations, result):\n        stack = []\n        for op in operations:\n            if op == \"C\":\n                if not stack:\n                    return False\n                stack.pop()\n            elif op == \"D\":\n                if not stack:\n                    return False\n                stack.append(stack[-1] * 2)\n            elif op == \"+\":\n                if len(stack) < 2:\n                    return False\n                stack.append(stack[-1] + stack[-2])\n            else:\n                try:\n                    value = int(op)\n                except Exception:\n                    return False\n                if value < -30000 or value > 30000:\n                    return False\n                stack.append(value)\n        return sum(stack) == result\n"
      }
    },
