    "oracle": {
      "python3": {
        "call": "Checker().intersection(nums1, nums2, {result})",
        "checker": "class Checker:\n    def intersection(self, nums1, nums2, result):\n        if not isinstance(result, list):\n            return False\n        if len(result) != len(set(result)):\n            return False\n        if any(type(x) is not int for x in result):\n            return False\n        return set(result) == (set(nums1) & set(nums2))\n"
      }
    },
