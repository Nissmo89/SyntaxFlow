    "oracle": {
      "python3": {
        "call": "Checker().findContentChildren(g, s, {result})",
        "checker": "class Checker:\n    def findContentChildren(self, g, s, result):\n        if not isinstance(result, int):\n            return False\n        if result < 0:\n            return False\n        g2 = sorted(list(g))\n        s2 = sorted(list(s))\n        i = 0\n        j = 0\n        expected = 0\n        while i < len(g2) and j < len(s2):\n            if s2[j] >= g2[i]:\n                expected += 1\n                i += 1\n            j += 1\n        return result == expected\n"
      }
    },
