      "python3": {
        "call": "Checker().isAnagram(s, t, {result})",
        "checker": "from collections import Counter\nfrom typing import Any\n\nclass Checker:\n    def isAnagram(self, s: Any, t: Any, result: Any) -> bool:\n        if not isinstance(result, bool):\n            return False\n        if not isinstance(s, str) or not isinstance(t, str):\n            return False\n        return result == (len(s) == len(t) and Counter(s) == Counter(t))\n"
      }
    },
