        "checker": "class Checker:\n    def fairCandySwap(self, aliceSizes, bobSizes, result):\n        if not isinstance(result, list) or len(result) != 2:\n            return False\n        a, b = result\n        if a not in aliceSizes or b not in bobSizes:\n            return False\n        return sum(aliceSizes) - a + b == sum(bobSizes) - b + a\n"
      }
