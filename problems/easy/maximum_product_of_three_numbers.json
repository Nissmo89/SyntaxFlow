        "call": "Checker().maximumProduct(nums, {result})",
        "checker": "class Checker:\n    def maximumProduct(self, nums, result):\n        if not isinstance(nums, list):\n            return False\n        if len(nums) < 3:\n            return False\n        if not isinstance(result, int):\n            return False\n        for value in nums:\n            if not isinstance(value, int):\n                return False\n        nums = sorted(nums)\n        expected = max(nums[-1] * nums[-2] * nums[-3], nums[-1] * nums[0] * nums[1])\n        return result == expected\n"
      }
    },
