    "oracle": {
      "python3": {
        "call": "Checker().searchBST(root, val, {result})",
        "checker": "class Checker:\n    def _is_nullish(self, node):\n        return node is None or node == []\n\n    def _has_tree_shape(self, node):\n        return isinstance(node, (list, tuple, dict)) or hasattr(node, 'val')\n\n    def _from_level_order(self, values):\n        if not values:\n            return None\n        nodes = [None if v is None else [v, None, None] for v in values]\n        for i, node in enumerate(nodes):\n            if node is None:\n                continue\n            left = 2 * i + 1\n            right = 2 * i + 2\n            if left < len(nodes):\n                node[1] = nodes[left]\n            if right < len(nodes):\n                node[2] = nodes[right]\n        return nodes[0]\n\n    def _to_tree(self, node):\n        if self._is_nullish(node):\n            return None\n        if hasattr(node, 'val'):\n            return [\n                node.val,\n                self._to_tree(getattr(node, 'left', None)),\n                self._to_tree(getattr(node, 'right', None)),\n            ]\n        if isinstance(node, dict) and 'val' in node:\n            return [\n                node['val'],\n                self._to_tree(node.get('left')),\n                self._to_tree(node.get('right')),\n            ]\n        if isinstance(node, tuple):\n            node = list(node)\n        if isinstance(node, list):\n            if not node:\n                return None\n            if len(node) == 3 and any(self._has_tree_shape(x) for x in node[1:]):\n                return [\n                    node[0],\n                    self._to_tree(node[1]),\n                    self._to_tree(node[2]),\n                ]\n            if len(node) == 1 and not self._has_tree_shape(node[0]):\n                return [node[0], None, None]\n            if all(not self._has_tree_shape(x) for x in node):\n                return self._from_level_order(node)\n            return self._from_level_order(node)\n        return [node, None, None]\n\n    def _search(self, node, target):\n        if node is None:\n            return None\n        if node[0] == target:\n            return node\n        if target < node[0]:\n            return self._search(node[1], target)\n        return self._search(node[2], target)\n\n    def searchBST(self, root, val, result):\n        root_arr = self._to_tree(root)\n        expected = self._search(root_arr, val)\n        actual = self._to_tree(result)\n        return expected == actual\n"
      }
    },
