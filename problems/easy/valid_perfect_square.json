    "oracle": {
      "python3": {
        "call": "Checker().isPerfectSquare(num, {result})",
        "checker": "class Checker:\n    def isPerfectSquare(self, num, result):\n        if not isinstance(result, bool):\n            return False\n        if num < 1:\n            return False\n        left, right = 1, num\n        while left <= right:\n            mid = (left + right) // 2\n            sq = mid * mid\n            if sq == num:\n                return result is True\n            if sq < num:\n                left = mid + 1\n            else:\n                right = mid - 1\n        return result is False\n"
      }
    },
