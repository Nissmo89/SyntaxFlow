    "oracle": {
      "python3": {
        "call": "Checker().findLengthOfLCIS(nums, {result})",
        "checker": "class Checker:\n    def findLengthOfLCIS(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        if not isinstance(nums, list) or len(nums) == 0:\n            return False\n        if any(not isinstance(x, int) for x in nums):\n            return False\n        best = 1\n        cur = 1\n        for i in range(1, len(nums)):\n            if nums[i] > nums[i - 1]:\n                cur += 1\n            else:\n                if cur > best:\n                    best = cur\n                cur = 1\n        if cur > best:\n            best = cur\n        return result == best\n"
      }
    },
