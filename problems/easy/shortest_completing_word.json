      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().shortestCompletingWord(licensePlate, words, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def shortestCompletingWord(self, licensePlate, words, result):\n        if not isinstance(result, str):\n            return False\n        if result not in words:\n            return False\n        need = Counter(c for c in licensePlate.lower() if c.isalpha())\n        counts = Counter(result)\n        if any(counts.get(c, 0) < need[c] for c in need):\n            return False\n        best = None\n        for word in words:\n            word_counts = Counter(word)\n            if all(word_counts.get(c, 0) >= need[c] for c in need):\n                if best is None or len(word) < len(best):\n                    best = word\n        return result == best\n"
      }
    },
