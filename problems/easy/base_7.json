  "description": "<p>Given an integer <code>num</code>, return <em>a string of its <strong>base 7</strong> representation</em>.</p> <p> </p> <p><strong class=\"example\">Example 1:</strong></p> <pre><strong>Input:</strong> num = 100\n<strong>Output:</strong> \"202\"\n</pre><p><strong class=\"example\">Example 2:</strong></p> <pre><strong>Input:</strong> num = -7\n<strong>Output:</strong> \"-10\"\n</pre> <p> </p> <p><strong>Constraints:</strong></p> <ul> <li><code>-10<sup>7</sup> &lt;= num &lt;= 10<sup>7</sup></code></li> </ul>",
  "hints": [],
  "method": {
    "name": "convertToBase7",
    "returnType": "auto",
    "params": [
      {
        "name": "num",
        "type": "int"
      }
    ]
  },
