    "oracle": {
      "python3": {
        "call": "Checker().findTilt(root, {result})",
        "checker": "class Checker:\n    def findTilt(self, root, result):\n        if not isinstance(result, int):\n            return False\n        total = 0\n        def dfs(node):\n            nonlocal total\n            if node is None:\n                return 0\n            left = dfs(node.left)\n            right = dfs(node.right)\n            total += abs(left - right)\n            return left + right + node.val\n        dfs(root)\n        return total == result\n"
      }
    },
