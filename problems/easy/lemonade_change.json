    "oracle": {
      "python3": {
        "call": "Checker().lemonadeChange(bills, {result})",
        "checker": "class Checker:\n    def lemonadeChange(self, bills, result):\n        f = t = 0\n        for bill in bills:\n            if bill == 5:\n                f += 1\n            elif bill == 10:\n                if f < 1:\n                    return result is False\n                f -= 1\n                t += 1\n            else:\n                if f >= 1 and t >= 1:\n                    f -= 1\n                    t -= 1\n                elif f >= 3:\n                    f -= 3\n                else:\n                    return result is False\n        return result is True\n"
      }
    },
