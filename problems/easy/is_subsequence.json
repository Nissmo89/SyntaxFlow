    "oracle": {
      "python3": {
        "call": "Checker().check(s, t, {result})",
        "checker": "class Checker:\n    def check(self, s, t, result):\n        def is_subsequence(a, b):\n            i = 0\n            for ch in b:\n                if i < len(a) and a[i] == ch:\n                    i += 1\n            return i == len(a)\n\n        return result == is_subsequence(s, t)\n"
      }
    },
