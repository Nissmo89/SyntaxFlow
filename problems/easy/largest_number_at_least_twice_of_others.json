    "oracle": {
      "python3": {
        "call": "Checker().dominantIndex(nums, {result})",
        "checker": "class Checker:\n    def dominantIndex(self, nums, result):\n        if not isinstance(nums, list):\n            return False\n        if len(nums) < 2 or len(nums) > 50:\n            return False\n        if not isinstance(result, int):\n            return False\n        if any((not isinstance(x, int)) or x < 0 or x > 100 for x in nums):\n            return False\n        max_value = max(nums)\n        if nums.count(max_value) != 1:\n            return False\n        max_index = nums.index(max_value)\n        second = max(x for i, x in enumerate(nums) if i != max_index)\n        expected = max_index if max_value >= 2 * second else -1\n        return result == expected\n"
      }
    },
