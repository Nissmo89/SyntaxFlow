    },
    "limits": {
      "time_ms": 200,
      "memory_mb": 300
    },
    "oracle": {
      "python3": {
        "call": "Checker().binaryTreePaths(root, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def binaryTreePaths(self, root: Any, result: Any) -> bool:\n        if not isinstance(result, list):\n            return False\n\n        if not isinstance(root, list) or not root:\n            return False\n\n        class Node:\n            def __init__(self, val):\n                self.val = val\n                self.left = None\n                self.right = None\n\n        nodes = [None if value is None else Node(value) for value in root]\n        kids = nodes[1:]\n        for node in nodes:\n            if node is not None:\n                if kids:\n                    node.left = kids.pop(0)\n                if kids:\n                    node.right = kids.pop(0)\n\n        expected = []\n\n        def dfs(node, path):\n            if node is None:\n                return\n            val = node.val\n            next_path = f\"{path}->{val}\" if path else str(val)\n            if node.left is None and node.right is None:\n                expected.append(next_path)\n                return\n            dfs(node.left, next_path)\n            dfs(node.right, next_path)\n\n        dfs(nodes[0], \"\")\n        return sorted(expected) == sorted(result) and all(isinstance(x, str) for x in result)\n"
      }
    },
