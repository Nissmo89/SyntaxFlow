      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().longestCommonPrefix(strs, {result})",
        "checker": "class Checker:\n    def longestCommonPrefix(self, strs, result):\n        if not isinstance(result, str):\n            return False\n        if not strs:\n            return result == \"\"\n        prefix = strs[0]\n        for s in strs[1:]:\n            i = 0\n            limit = min(len(prefix), len(s))\n            while i < limit and prefix[i] == s[i]:\n                i += 1\n            prefix = prefix[:i]\n            if not prefix:\n                break\n        return result == prefix\n"
      }
    },
