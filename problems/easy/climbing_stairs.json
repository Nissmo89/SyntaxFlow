    "oracle": {
      "python3": {
        "call": "Checker().climbStairs(n, {result})",
        "checker": "class Checker:\n    def climbStairs(self, n, result):\n        if not isinstance(n, int) or n < 0:\n            return False\n        if n <= 3:\n            return result == n\n\n        prev2 = 2\n        prev1 = 3\n        cur = 0\n        for _ in range(3, n):\n            cur = prev1 + prev2\n            prev2 = prev1\n            prev1 = cur\n        return result == cur\n"
      }
    },
