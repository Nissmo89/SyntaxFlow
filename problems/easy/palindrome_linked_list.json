    "oracle": {
      "python3": {
        "call": "Checker().isPalindrome(head, {result})",
        "checker": "from typing import Any\n\nclass Checker:\n    def isPalindrome(self, head: Any, result: Any) -> bool:\n        if not isinstance(result, bool):\n            return False\n\n        def to_values(node: Any) -> list:\n            if node is None:\n                return []\n            if hasattr(node, \"val\") and hasattr(node, \"next\"):\n                values = []\n                seen = 0\n                while node is not None:\n                    values.append(node.val)\n                    node = node.next\n                    seen += 1\n                    if seen > 100000:\n                        return []\n                return values\n            if isinstance(node, list) or isinstance(node, tuple):\n                if len(node) == 0:\n                    return []\n                if len(node) == 2 and not all(isinstance(x, (int, bool, float, str)) for x in node):\n                    return [node[0]] + to_values(node[1])\n                return list(node)\n            return []\n\n        values = to_values(head)\n        return result == (values == values[::-1])\n"
      }
    },
