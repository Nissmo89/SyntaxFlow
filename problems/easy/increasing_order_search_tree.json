{
  "id": "increasing_order_search_tree",
  "title": "Increasing Order Search Tree",
  "difficulty": "Easy",
  "category": "Algorithms",
  "tags": [
    "Stack",
    "Tree",
    "Depth-First Search",
    "Binary Search Tree",
    "Binary Tree"
  ],
  "description": "<p>Given the <code>root</code> of a binary search tree, rearrange the tree in <strong>in-order</strong> so that the leftmost node in the tree is now the root of the tree, and every node has no left child and only one right child.</p> <p> </p> <p><strong class=\"example\">Example 1:</strong></p> <img alt=\"\" src=\"assets/problem_images/b2e3dbe230611d515643c9c9c97a162ef3da4d654326122a0e698b58ef67d6a3.jpg\" style=\"width: 600px; height: 350px;\"/> <pre><strong>Input:</strong> root = [5,3,6,2,4,null,8,1,null,null,null,7,9]\n<strong>Output:</strong> [1,null,2,null,3,null,4,null,5,null,6,null,7,null,8,null,9]\n</pre> <p><strong class=\"example\">Example 2:</strong></p> <img alt=\"\" src=\"assets/problem_images/3138c457dca3f172a812851a738a29cb33a5f9eb9ed93b1a51472af4f750f18a.jpg\" style=\"width: 300px; height: 114px;\"/> <pre><strong>Input:</strong> root = [5,1,7]\n<strong>Output:</strong> [1,null,5,null,7]\n</pre> <p> </p> <p><strong>Constraints:</strong></p> <ul> <li>The number of nodes in the given tree will be in the range <code>[1, 100]</code>.</li> <li><code>0 &lt;= Node.val &lt;= 1000</code></li> </ul>",
  "hints": [],
  "method": {
    "name": "increasingBST",
    "returnType": "auto",
    "params": [
      {
        "name": "root",
        "type": "tree_node"
      }
    ]
  },
  "manifest": {
    "entry": {
      "id": 897,
      "title": "increasing-order-search-tree",
      "params": {
        "root": {
          "type": "tree_node"
        }
      },
      "call": {
        "cpp": "treeNodeToArray(Solution().increasingBST({root}))",
        "rust": "Solution::increasing_bst({root})",
        "python3": "tree_node_to_array(Solution().increasingBST({root}))",
        "python2": "tree_node_to_array(Solution().increasingBST({root}))",
        "ruby": "tree_node_to_array(increasing_bst({root}))",
        "java": "TreeNode.treeNodeToArray(new Solution().increasingBST({root}))",
        "csharp": "new Solution().IncreasingBST({root})",
        "kotlin": "treeNodeToArray(Solution().increasingBST({root}))",
        "go": "treeNodeToArray(increasingBST({root}))",
        "dart": "tree_node_to_array(Solution().increasingBST({root}))",
        "swift": "tree_node_to_array(Solution().increasingBST({root}))",
        "typescript": "treeNodeToArray(increasingBST({root}))"
      }
    },
    "judge": {
      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().increasingBST(root, {result})",
        "checker": "class Checker:\n    def increasingBST(self, root, result):\n        def inorder(node):\n            if not node:\n                return []\n            return inorder(node.left) + [node.val] + inorder(node.right)\n\n        expected = inorder(root)\n\n        out = []\n        for i, val in enumerate(expected):\n            out.append(val)\n            if i + 1 != len(expected):\n                out.append(None)\n\n        return result == out\n"
      }
    },
