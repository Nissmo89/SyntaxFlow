    "oracle": {
      "python3": {
        "call": "Checker().nextGreaterElement(nums1, nums2, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def nextGreaterElement(self, nums1: List[int], nums2: List[int], result: Any) -> bool:\n        if not isinstance(result, list):\n            return False\n        if len(result) != len(nums1):\n            return False\n        positions = {}\n        for i, num in enumerate(nums2):\n            if num in positions:\n                return False\n            positions[num] = i\n        if len(set(nums1)) != len(nums1):\n            return False\n        if not set(nums1).issubset(set(nums2)):\n            return False\n        for i, num in enumerate(nums1):\n            idx = positions.get(num)\n            if idx is None:\n                return False\n            expected = -1\n            for j in range(idx + 1, len(nums2)):\n                if nums2[j] > num:\n                    expected = nums2[j]\n                    break\n            if result[i] != expected:\n                return False\n        return True\n"
      }
    },
