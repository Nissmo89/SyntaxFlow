          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "call": {
        "cpp": "Solution().findWords({words})",
        "rust": "Solution::find_words({words})",
        "python3": "Solution().findWords({words})",
        "python2": "Solution().findWords({words})",
        "ruby": "find_words({words})",
        "java": "new Solution().findWords({words})",
        "csharp": "new Solution().FindWords({words})",
        "kotlin": "Solution().findWords({words})",
        "go": "findWords({words})",
        "dart": "Solution().findWords({words})",
        "swift": "Solution().findWords({words})",
        "typescript": "findWords({words})"
      }
    },
    "judge": {
      "type": "exact"
    },
    "limits": {
      "time_ms": 200,
      "memory_mb": 300
    },
    "oracle": {
      "python3": {
        "call": "Checker().findWords(words, {result})",
        "checker": "class Checker:\n    def findWords(self, words, result):\n        if not isinstance(result, list):\n            return False\n\n        rows = {\n            **{c: 1 for c in \"qwertyuiop\"},\n            **{c: 2 for c in \"asdfghjkl\"},\n            **{c: 3 for c in \"zxcvbnm\"},\n        }\n\n        expected = []\n        for w in words:\n            if not isinstance(w, str) or not w:\n                return False\n            lw = w.lower()\n            row = rows.get(lw[0])\n            if row is None or any(rows.get(ch) != row for ch in lw):\n                continue\n            expected.append(w)\n\n        return result == expected\n"
      }
    },
    "seed": 500,
