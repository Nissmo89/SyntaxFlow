    "judge": {
      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().nextGreatestLetter(letters, target, {result})",
        "checker": "class Checker:\n    def nextGreatestLetter(self, letters, target, result):\n        if not isinstance(result, str) or len(result) != 1:\n            return False\n        if not isinstance(letters, list) or len(letters) < 2:\n            return False\n        prev = None\n        distinct = set()\n        for ch in letters:\n            if not isinstance(ch, str) or len(ch) != 1:\n                return False\n            if prev is not None and ch < prev:\n                return False\n            prev = ch\n            distinct.add(ch)\n        if len(distinct) < 2:\n            return False\n        expected = letters[0]\n        for ch in letters:\n            if ch > target:\n                expected = ch\n                break\n        return result == expected\n"
      }
    },
