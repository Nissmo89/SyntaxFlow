    "oracle": {
      "python3": {
        "call": "Checker().check({root}, {k}, {result})",
        "checker": "class Checker:\n    def check(self, root, k, result):\n        seen = set()\n\n        def dfs(node):\n            if not node:\n                return False\n            if k - node.val in seen:\n                return True\n            seen.add(node.val)\n            return dfs(node.left) or dfs(node.right)\n\n        return dfs(root) == result\n"
      }
    },
