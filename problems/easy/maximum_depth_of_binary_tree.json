    "oracle": {
      "python3": {
        "call": "Checker().maxDepth(root, {result})",
        "checker": "class Checker:\n    def maxDepth(self, root_arr, result):\n        def depth(idx):\n            if idx >= len(root_arr) or root_arr[idx] is None:\n                return 0\n            return 1 + max(depth(2 * idx + 1), depth(2 * idx + 2))\n\n        return depth(0) == result\n"
      }
    },
