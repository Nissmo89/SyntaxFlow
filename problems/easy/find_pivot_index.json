    "oracle": {
      "python3": {
        "call": "Checker().pivotIndex(nums, {result})",
        "checker": "class Checker:\n    def pivotIndex(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        n = len(nums)\n        if result < -1 or result >= n:\n            return False\n        total = sum(nums)\n        if result == -1:\n            left = 0\n            for x in nums:\n                if left == total - left - x:\n                    return False\n                left += x\n            return True\n        left = sum(nums[:result])\n        right = total - left - nums[result]\n        if left != right:\n            return False\n        running = 0\n        for i, x in enumerate(nums):\n            if i >= result:\n                break\n            if running == total - running - x:\n                return False\n            running += x\n        return True\n"
      }
    },
