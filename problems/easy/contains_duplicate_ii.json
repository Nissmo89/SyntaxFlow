    "oracle": {
      "python3": {
        "call": "Checker().containsNearbyDuplicate(nums, k, {result})",
        "checker": "class Checker:\n    def containsNearbyDuplicate(self, nums, k, result):\n        if not isinstance(result, bool):\n            return False\n\n        window_set = set()\n        for i, value in enumerate(nums):\n            if i > k:\n                window_set.remove(nums[i - k - 1])\n            if value in window_set:\n                return result is True\n            window_set.add(value)\n\n        return result is False\n"
      }
    },
