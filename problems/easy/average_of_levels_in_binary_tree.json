    "oracle": {
      "python3": {
        "call": "Checker().averageOfLevels(root, {result})",
        "checker": "from collections import deque\n\nclass Checker:\n    def averageOfLevels(self, root_arr, result):\n        if root_arr is None or root_arr == []:\n            return result == []\n        if not isinstance(root_arr, list) or not isinstance(result, list):\n            return False\n        if root_arr[0] is None:\n            return result == []\n\n        expected = []\n        queue = deque([root_arr[0]])\n        idx = 1\n        while queue:\n            level_sum = 0\n            count = 0\n            next_queue = deque()\n            while queue:\n                val = queue.popleft()\n                if val is None:\n                    continue\n                if not isinstance(val, int):\n                    return False\n                level_sum += val\n                count += 1\n                if idx < len(root_arr):\n                    next_queue.append(root_arr[idx])\n                    idx += 1\n                if idx < len(root_arr):\n                    next_queue.append(root_arr[idx])\n                    idx += 1\n            if count == 0:\n                break\n            expected.append(level_sum / count)\n            queue = next_queue\n        if len(result) != len(expected):\n            return False\n        for actual, exp in zip(result, expected):\n            if not isinstance(actual, (int, float)):\n                return False\n            if abs(float(actual) - exp) > 1e-5:\n                return False\n        return True\n"
      }
    },
