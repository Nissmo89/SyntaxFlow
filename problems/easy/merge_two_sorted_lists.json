    "oracle": {
      "python3": {
        "call": "Checker().check([{l1}], [{l2}], {result})",
        "checker": "import json\n\nclass Checker:\n    def check(self, l1, l2, res):\n        expected = sorted(l1 + l2)\n        try:\n            got = json.loads(res) if isinstance(res, str) else res\n        except Exception:\n            return False\n        return got == expected\n"
      }
    },
