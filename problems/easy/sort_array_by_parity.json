    "oracle": {
      "python3": {
        "call": "Checker().sortArrayByParity(nums, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def sortArrayByParity(self, nums, result):\n        if not isinstance(result, list) or len(result) != len(nums):\n            return False\n        if Counter(nums) != Counter(result):\n            return False\n        seen_odd = False\n        for x in result:\n            if x % 2 == 0:\n                if seen_odd:\n                    return False\n            else:\n                seen_odd = True\n        return True\n"
      }
    },
