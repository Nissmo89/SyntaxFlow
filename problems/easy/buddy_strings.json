        "call": "Checker().buddyStrings(s, goal, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def buddyStrings(self, s, goal, result):\n        if len(s) != len(goal):\n            return result is False\n        if s == goal:\n            return (len(set(s)) < len(s)) == result\n        diffs = [i for i, (a, b) in enumerate(zip(s, goal)) if a != b]\n        expected = len(diffs) == 2 and s[diffs[0]] == goal[diffs[1]] and s[diffs[1]] == goal[diffs[0]]\n        return expected == result\n"
      }
    },
