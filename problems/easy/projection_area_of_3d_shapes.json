    "oracle": {
      "python3": {
        "call": "Checker().projectionArea(grid, {result})",
        "checker": "class Checker:\n    def projectionArea(self, grid, result):\n        xy = sum(1 for row in grid for v in row if v > 0)\n        yz = sum(max(row) for row in grid)\n        zx = sum(max(col) for col in zip(*grid))\n        return xy + yz + zx == result\n"
      }
    },
