      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(m, n, i, j, {result})",
        "checker": "class Checker:\n    def check(self, m, n, i, j, result):\n        if not isinstance(result, list) or len(result) != m * n:\n            return False\n        seen = set()\n        prev = None\n        for cell in result:\n            if not isinstance(cell, list) or len(cell) != 2:\n                return False\n            r, c = cell\n            if not (0 <= r < m and 0 <= c < n):\n                return False\n            if (r, c) in seen:\n                return False\n            seen.add((r, c))\n            key = (abs(r - i) + abs(c - j), r, c)\n            if prev is not None and prev > key:\n                return False\n            prev = key\n        return len(seen) == m * n\n"
      }
    },
