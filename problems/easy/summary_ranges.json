    "oracle": {
      "python3": {
        "call": "Checker().summaryRanges(nums, {result})",
        "checker": "class Checker:\n    def summaryRanges(self, nums, result):\n        expected = []\n        i = 0\n        while i < len(nums):\n            start = nums[i]\n            j = i\n            while j + 1 < len(nums) and nums[j + 1] == nums[j] + 1:\n                j += 1\n            if nums[j] == start:\n                expected.append(str(start))\n            else:\n                expected.append(f\"{start}->{nums[j]}\")\n            i = j + 1\n        return result == expected\n"
      }
    },
