        "call": "Checker().fizzBuzz(n, {result})",
        "checker": "class Checker:\n    def fizzBuzz(self, n, result):\n        if not isinstance(result, list) or len(result) != n:\n            return False\n        expected = []\n        for i in range(1, n + 1):\n            if i % 15 == 0:\n                expected.append(\"FizzBuzz\")\n            elif i % 3 == 0:\n                expected.append(\"Fizz\")\n            elif i % 5 == 0:\n                expected.append(\"Buzz\")\n            else:\n                expected.append(str(i))\n        return result == expected\n"
      }
    },
