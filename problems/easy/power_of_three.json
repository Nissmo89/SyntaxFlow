        "call": "Checker().isPowerOfThree(n, {result})",
        "checker": "class Checker:\n    def isPowerOfThree(self, n, result):\n        if n <= 0:\n            return result is False\n        while n % 3 == 0:\n            n //= 3\n        return result == (n == 1)\n"
      }
    },
