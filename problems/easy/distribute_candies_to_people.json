    "oracle": {
      "python3": {
        "call": "Checker().check(candies, num_people, {result})",
        "checker": "class Checker(object):\n    def check(self, candies, num_people, result):\n        if not isinstance(result, list) or len(result) != num_people:\n            return False\n        if any((not isinstance(x, int)) for x in result):\n            return False\n        if sum(result) != candies:\n            return False\n        exp = [0] * num_people\n        give = 1\n        i = 0\n        while candies > 0:\n            exp[i % num_people] += min(give, candies)\n            candies -= give\n            give += 1\n            i += 1\n        return exp == result\n"
      }
    },
