      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().repeatedSubstringPattern(s, {result})",
        "checker": "class Checker:\n    def repeatedSubstringPattern(self, s, result):\n        n = len(s)\n        expected = False\n        for length in range(1, n // 2 + 1):\n            if n % length == 0:\n                piece = s[:length]\n                if piece * (n // length) == s:\n                    expected = True\n                    break\n        return result == expected\n"
      }
    },
