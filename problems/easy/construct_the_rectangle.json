      "memory_mb": 300
    },
    "oracle": {
      "python3": {
        "call": "Checker().constructRectangle(area, {result})",
        "checker": "import math\n\nclass Checker:\n    def constructRectangle(self, area, result):\n        if not isinstance(result, list) or len(result) != 2:\n            return False\n        l, w = result\n        if not isinstance(l, int) or not isinstance(w, int):\n            return False\n        if l < w:\n            return False\n        if l * w != area:\n            return False\n        x = int(math.isqrt(area))\n        while x > 0 and area % x != 0:\n            x -= 1\n        return l == area // x and w == x\n"
      }
    },
