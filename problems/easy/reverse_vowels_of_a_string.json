    "oracle": {
      "python3": {
        "call": "Checker().reverseVowels(s, {result})",
        "checker": "\nclass Checker:\n    def reverseVowels(self, s, result):\n        vowels = set(\"aeiouAEIOU\")\n        if not isinstance(result, str):\n            return False\n        if len(result) != len(s):\n            return False\n        s_vowels = [c for c in s if c in vowels]\n        result_vowels = [c for c in result if c in vowels]\n        if s_vowels[::-1] != result_vowels:\n            return False\n        for a, b in zip(s, result):\n            if a not in vowels and a != b:\n                return False\n        return True\n"
      }
    },
