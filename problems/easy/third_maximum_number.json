        "checker": "class Checker:\n    def thirdMax(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        distinct = sorted(set(nums), reverse=True)\n        expected = distinct[2] if len(distinct) >= 3 else distinct[0]\n        return result == expected\n"
      }
