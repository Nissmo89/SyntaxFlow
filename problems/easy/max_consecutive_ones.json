    "oracle": {
      "python3": {
        "call": "Checker().findMaxConsecutiveOnes(nums, {result})",
        "checker": "class Checker:\n    def findMaxConsecutiveOnes(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        best = 0\n        current = 0\n        for value in nums:\n            if value == 1:\n                current += 1\n                if current > best:\n                    best = current\n            else:\n                current = 0\n        return result == best\n"
      }
    },
