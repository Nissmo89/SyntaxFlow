    "oracle": {
      "python3": {
        "call": "Checker().isPalindrome(x, {result})",
        "checker": "class Checker:\n    def isPalindrome(self, x, result):\n        if not isinstance(result, bool):\n            return False\n        if x < 0:\n            expected = False\n        else:\n            num = x\n            rev = 0\n            while num != 0:\n                rev = rev * 10 + num % 10\n                num //= 10\n            expected = rev == x\n        return result == expected\n"
      }
    },
