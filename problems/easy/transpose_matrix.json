    "oracle": {
      "python3": {
        "call": "Checker().transpose(matrix, {result})",
        "checker": "from typing import Any\n\nclass Checker:\n    def transpose(self, matrix: list[list[int]], result: Any) -> bool:\n        if not isinstance(result, list):\n            return False\n        if len(matrix) == 0 or len(matrix[0]) == 0:\n            return False\n        rows = len(matrix)\n        cols = len(matrix[0])\n        if len(result) != cols:\n            return False\n        for row in result:\n            if not isinstance(row, list) or len(row) != rows:\n                return False\n        for i in range(cols):\n            for j in range(rows):\n                if result[i][j] != matrix[j][i]:\n                    return False\n        return True\n"
      }
    },
