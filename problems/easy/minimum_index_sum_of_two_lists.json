    "oracle": {
      "python3": {
        "call": "Checker().findRestaurant(list1, list2, {result})",
        "checker": "from typing import Any, List\nclass Checker:\n    def findRestaurant(self, list1: List[str], list2: List[str], result: Any) -> bool:\n        if not isinstance(result, list):\n            return False\n        pos1 = {s: i for i, s in enumerate(list1)}\n        pos2 = {s: i for i, s in enumerate(list2)}\n        common = [s for s in list1 if s in pos2]\n        if not common:\n            return False\n        best = min(pos1[s] + pos2[s] for s in common)\n        expected = {s for s in common if pos1[s] + pos2[s] == best}\n        return set(result) == expected and len(result) == len(expected)\n"
      }
    },
