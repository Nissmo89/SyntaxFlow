    "oracle": {
      "python3": {
        "call": "Checker().romanToInt(s, {result})",
        "checker": "class Checker:\n    def romanToInt(self, s, result):\n        roman = {\n            \"I\": 1,\n            \"V\": 5,\n            \"X\": 10,\n            \"L\": 50,\n            \"C\": 100,\n            \"D\": 500,\n            \"M\": 1000,\n        }\n        if not isinstance(result, int):\n            return False\n        if not (1 <= len(s) <= 15):\n            return False\n        if any(ch not in roman for ch in s):\n            return False\n        total = 0\n        for a, b in zip(s, s[1:]):\n            if roman[a] < roman[b]:\n                total -= roman[a]\n            else:\n                total += roman[a]\n        total += roman[s[-1]]\n        return 1 <= total <= 3999 and total == result\n"
      }
    },
