      "time_ms": 1000,
      "memory_mb": 128
    },
    "oracle": {
      "python3": {
        "call": "Checker().strStr(haystack, needle, {result})",
        "checker": "class Checker:\n    def strStr(self, haystack, needle, result):\n        if not isinstance(haystack, str):\n            return False\n        if not isinstance(needle, str):\n            return False\n        if not isinstance(result, int):\n            return False\n        if any(not ('a' <= ch <= 'z') for ch in haystack):\n            return False\n        if any(not ('a' <= ch <= 'z') for ch in needle):\n            return False\n        if not (1 <= len(haystack) <= 10000):\n            return False\n        if not (1 <= len(needle) <= 10000):\n            return False\n        expected = haystack.find(needle)\n        return result == expected\n"
      }
    },
