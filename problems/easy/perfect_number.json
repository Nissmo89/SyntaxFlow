        "call": "Checker().checkPerfectNumber(num, {result})",
        "checker": "class Checker:\n    def checkPerfectNumber(self, num, result):\n        if num == 1:\n            expected = False\n        else:\n            total = 1\n            i = 2\n            while i * i <= num:\n                if num % i == 0:\n                    total += i\n                    other = num // i\n                    if other != i:\n                        total += other\n                i += 1\n            expected = (num == total)\n        return expected == result\n"
      }
    },
