{
  "id": "detect_capital",
  "title": "Detect Capital",
  "difficulty": "Easy",
  "category": "Algorithms",
  "tags": [
    "String"
  ],
  "description": "<p>We define the usage of capitals in a word to be right when one of the following cases holds:</p> <ul> <li>All letters in this word are capitals, like <code>\"USA\"</code>.</li> <li>All letters in this word are not capitals, like <code>\"leetcode\"</code>.</li> <li>Only the first letter in this word is capital, like <code>\"Google\"</code>.</li> </ul> <p>Given a string <code>word</code>, return <code>true</code> if the usage of capitals in it is right.</p> <p> </p> <p><strong class=\"example\">Example 1:</strong></p> <pre><strong>Input:</strong> word = \"USA\"\n<strong>Output:</strong> true\n</pre><p><strong class=\"example\">Example 2:</strong></p> <pre><strong>Input:</strong> word = \"FlaG\"\n<strong>Output:</strong> false\n</pre> <p> </p> <p><strong>Constraints:</strong></p> <ul> <li><code>1 &lt;= word.length &lt;= 100</code></li> <li><code>word</code> consists of lowercase and uppercase English letters.</li> </ul>",
  "hints": [],
  "method": {
    "name": "detectCapitalUse",
    "returnType": "auto",
    "params": [
      {
        "name": "word",
        "type": "string"
      }
    ]
  },
  "manifest": {
    "entry": {
      "id": 520,
      "title": "detect-capital",
      "params": {
        "word": {
          "type": "string"
        }
      },
      "call": {
        "cpp": "Solution().detectCapitalUse({word})",
        "rust": "Solution::detect_capital_use({word})",
        "python3": "Solution().detectCapitalUse({word})",
        "python2": "Solution().detectCapitalUse({word})",
        "ruby": "detect_capital_use({word})",
        "java": "new Solution().detectCapitalUse({word})",
        "csharp": "new Solution().DetectCapitalUse({word})",
        "kotlin": "Solution().detectCapitalUse({word})",
        "go": "detectCapitalUse({word})",
        "dart": "Solution().detectCapitalUse({word})",
        "swift": "Solution().detectCapitalUse({word})",
        "typescript": "detectCapitalUse({word})"
      }
    },
    "judge": {
      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().detectCapitalUse(word, {result})",
        "checker": "class Checker:\n    def detectCapitalUse(self, word, result):\n        if not isinstance(result, bool):\n            return False\n        expected = word.isupper() or word.islower() or (word[:1].isupper() and word[1:].islower())\n        return result == expected\n"
      }
    },
