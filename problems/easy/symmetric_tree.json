        "rust": "Solution::is_symmetric({root})",
        "python3": "Solution().isSymmetric({root})",
        "python2": "Solution().isSymmetric({root})",
        "ruby": "is_symmetric({root})",
        "java": "new Solution().isSymmetric({root})",
        "csharp": "new Solution().IsSymmetric({root})",
        "kotlin": "Solution().isSymmetric({root})",
        "go": "isSymmetric({root})",
        "dart": "Solution().isSymmetric({root})",
        "swift": "Solution().isSymmetric({root})",
        "typescript": "isSymmetric({root})"
      }
    },
    "judge": {
      "type": "exact"
    },
    "limits": {
      "time_ms": 200,
      "memory_mb": 300
    },
    "oracle": {
      "python3": {
        "call": "Checker().isSymmetric(root, {result})",
        "checker": "class Checker:\n    def isSymmetric(self, root, result) -> bool:\n        if not isinstance(result, bool):\n            return False\n        if root is None or root == []:\n            return result is True\n        if not isinstance(root, list):\n            return False\n\n        def mirror(i, j):\n            left_exists = i < len(root) and root[i] is not None\n            right_exists = j < len(root) and root[j] is not None\n            if not left_exists or not right_exists:\n                return left_exists == right_exists\n            if root[i] != root[j]:\n                return False\n            return mirror(2 * i + 1, 2 * j + 2) and mirror(2 * i + 2, 2 * j + 1)\n\n        return result == mirror(1, 2)\n"
      }
    },
