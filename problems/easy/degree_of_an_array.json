    "oracle": {
      "python3": {
        "call": "Checker().findShortestSubArray(nums, {result})",
        "checker": "class Checker:\n    def findShortestSubArray(self, nums, result):\n        left = {}\n        right = {}\n        count = {}\n        for i, x in enumerate(nums):\n            if x not in left:\n                left[x] = i\n            right[x] = i\n            count[x] = count.get(x, 0) + 1\n\n        degree = max(count.values())\n        expected = len(nums)\n        for x, c in count.items():\n            if c == degree:\n                expected = min(expected, right[x] - left[x] + 1)\n        return result == expected\n"
      }
    },
