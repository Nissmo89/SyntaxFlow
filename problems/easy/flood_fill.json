    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().floodFill(image, sr, sc, color, {result})",
        "checker": "class Checker:\n    def floodFill(self, image, sr, sc, color, result):\n        if not isinstance(image, list) or not image:\n            return False\n        if not all(isinstance(row, list) and row for row in image):\n            return False\n        m = len(image)\n        n = len(image[0])\n        if not all(len(row) == n for row in image):\n            return False\n        if not isinstance(result, list) or len(result) != m:\n            return False\n        for row in result:\n            if not isinstance(row, list) or len(row) != n:\n                return False\n            for val in row:\n                if not isinstance(val, int):\n                    return False\n\n        expected = [row[:] for row in image]\n        old = expected[sr][sc]\n        if old != color:\n            stack = [(sr, sc)]\n            while stack:\n                i, j = stack.pop()\n                if i < 0 or i >= m or j < 0 or j >= n or expected[i][j] != old:\n                    continue\n                expected[i][j] = color\n                stack.append((i + 1, j))\n                stack.append((i - 1, j))\n                stack.append((i, j + 1))\n                stack.append((i, j - 1))\n\n        return result == expected\n"
      }
    },
