    "oracle": {
      "python3": {
        "call": "Checker().lastStoneWeight(stones, {result})",
        "checker": "class Checker:\n    def lastStoneWeight(self, stones, result) -> bool:\n        import heapq\n\n        h = [-x for x in stones]\n        heapq.heapify(h)\n        while len(h) > 1:\n            a = heapq.heappop(h)\n            b = heapq.heappop(h)\n            if a != b:\n                heapq.heappush(h, a - b)\n        expected = -h[0] if h else 0\n        return result == expected\n"
      }
    },
