    "oracle": {
      "python3": {
        "call": "Checker().check(digits, {result})",
        "checker": "class Checker:\n    def check(self, digits, result):\n        expected = digits[:]\n        for i in range(len(expected) - 1, -1, -1):\n            if expected[i] + 1 != 10:\n                expected[i] += 1\n                return result == expected\n            expected[i] = 0\n\n        return result == [1] + expected\n"
      }
    },
