    "oracle": {
      "python3": {
        "call": "Checker().countBinarySubstrings(s, {result})",
        "checker": "class Checker:\n    def countBinarySubstrings(self, s, result):\n        if not isinstance(result, int):\n            return False\n        groups = []\n        cur = 1\n        for i in range(1, len(s)):\n            if s[i] == s[i - 1]:\n                cur += 1\n            else:\n                groups.append(cur)\n                cur = 1\n        groups.append(cur)\n        expected = 0\n        for i in range(len(groups) - 1):\n            expected += min(groups[i], groups[i + 1])\n        return result == expected\n"
      }
    },
