    "oracle": {
      "python3": {
        "call": "Checker().imageSmoother(img, {result})",
        "checker": "class Checker:\n    def imageSmoother(self, img, result):\n        if not isinstance(result, list):\n            return False\n        if not img or not img[0]:\n            return False\n        m = len(img)\n        n = len(img[0])\n        if len(result) != m:\n            return False\n        for row in result:\n            if not isinstance(row, list) or len(row) != n:\n                return False\n            for val in row:\n                if not isinstance(val, int):\n                    return False\n        expected = []\n        for i in range(m):\n            row = []\n            for j in range(n):\n                s = 0\n                c = 0\n                for a in range(max(0, i - 1), min(m - 1, i + 1) + 1):\n                    for b in range(max(0, j - 1), min(n - 1, j + 1) + 1):\n                        s += img[a][b]\n                        c += 1\n                row.append(s // c)\n            expected.append(row)\n        return result == expected\n"
      }
    },
