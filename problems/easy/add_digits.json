        "call": "Checker().check(num, {result})",
        "checker": "from typing import Any\n\nclass Checker:\n    def check(self, num: Any, result: Any) -> bool:\n        if not isinstance(num, int) or not isinstance(result, int):\n            return False\n        if num == 0:\n            expected = 0\n        else:\n            expected = 1 + (num - 1) % 9\n        return result == expected\n"
      }
