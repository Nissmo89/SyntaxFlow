    "oracle": {
      "python3": {
        "call": "Checker().toHex(num, {result})",
        "checker": "class Checker:\n    def toHex(self, num, result):\n        if not isinstance(result, str):\n            return False\n        if num == 0:\n            return result == \"0\"\n        if num < 0:\n            num += 2**32\n        digits = \"0123456789abcdef\"\n        expected = []\n        while num:\n            expected.append(digits[num & 15])\n            num //= 16\n        return result == \"\".join(reversed(expected))\n"
      }
    },
