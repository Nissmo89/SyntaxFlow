      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().findErrorNums(nums, {result})",
        "checker": "class Checker:\n    def findErrorNums(self, nums, result):\n        if not isinstance(result, list) or len(result) != 2:\n            return False\n        dup, missing = result\n        if not isinstance(dup, int) or not isinstance(missing, int):\n            return False\n        n = len(nums)\n        if not (1 <= dup <= n and 1 <= missing <= n):\n            return False\n        seen = set()\n        duplicate = None\n        total = 0\n        for x in nums:\n            if x in seen:\n                duplicate = x\n            else:\n                seen.add(x)\n            total += x\n        if duplicate != dup:\n            return False\n        expected_missing = n * (n + 1) // 2 - (total - duplicate)\n        return expected_missing == missing\n"
      }
    },
