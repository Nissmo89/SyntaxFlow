        "call": "Checker().fib(n, {result})",
        "checker": "class Checker:\n    def fib(self, n, result):\n        def fibo(k):\n            a, b = 0, 1\n            for _ in range(k):\n                a, b = b, a + b\n            return a\n\n        return isinstance(result, int) and result == fibo(n)\n"
      }
    },
