        "call": "Checker().check(nums1, nums2, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def check(self, nums1, nums2, result):\n        if not isinstance(result, list):\n            return False\n        if any(not isinstance(x, int) for x in result):\n            return False\n        expected = Counter(nums1) & Counter(nums2)\n        return Counter(result) == expected\n"
      }
