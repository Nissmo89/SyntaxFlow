    "judge": {
      "type": "custom"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(root, {result})",
        "checker": "class Checker:\n    def check(self, root, result):\n        if not isinstance(result, int):\n            return False\n        def diameter(tree):\n            ans = 0\n            def height(node):\n                nonlocal ans\n                if node is None:\n                    return 0\n                left = height(node.left)\n                right = height(node.right)\n                ans = max(ans, left + right)\n                return 1 + max(left, right)\n            height(tree)\n            return ans\n        return result == diameter(root)\n"
      }
    },
    "seed": 543,
