{
  "id": "diameter_of_binary_tree",
  "title": "Diameter of Binary Tree",
  "difficulty": "Easy",
  "category": "Algorithms",
  "tags": [
    "Tree",
    "Depth-First Search",
    "Binary Tree"
  ],
  "description": "<p>Given the <code>root</code> of a binary tree, return <em>the length of the <strong>diameter</strong> of the tree</em>.</p> <p>The <strong>diameter</strong> of a binary tree is the <strong>length</strong> of the longest path between any two nodes in a tree. This path may or may not pass through the <code>root</code>.</p> <p>The <strong>length</strong> of a path between two nodes is represented by the number of edges between them.</p> <p> </p> <p><strong class=\"example\">Example 1:</strong></p> <img alt=\"\" src=\"https://assets.leetcode.com/uploads/2021/03/06/diamtree.jpg\" style=\"width: 292px; height: 302px;\"/> <pre><strong>Input:</strong> root = [1,2,3,4,5]\n<strong>Output:</strong> 3\n<strong>Explanation:</strong> 3 is the length of the path [4,2,1,3] or [5,2,1,3].\n</pre> <p><strong class=\"example\">Example 2:</strong></p> <pre><strong>Input:</strong> root = [1,2]\n<strong>Output:</strong> 1\n</pre> <p> </p> <p><strong>Constraints:</strong></p> <ul> <li>The number of nodes in the tree is in the range <code>[1, 10<sup>4</sup>]</code>.</li> <li><code>-100 &lt;= Node.val &lt;= 100</code></li> </ul>",
  "hints": [],
  "method": {
    "name": "diameterOfBinaryTree",
    "returnType": "auto",
    "params": [
      {
        "name": "root",
        "type": "tree_node"
      }
    ]
  },
  "manifest": {
    "entry": {
      "id": 543,
      "title": "diameter-of-binary-tree",
      "params": {
        "root": {
          "type": "tree_node"
        }
      },
      "call": {
        "cpp": "Solution().diameterOfBinaryTree({root})",
        "rust": "Solution::diameter_of_binary_tree({root})",
        "python3": "Solution().diameterOfBinaryTree({root})",
        "python2": "Solution().diameterOfBinaryTree({root})",
        "ruby": "diameter_of_binary_tree({root})",
        "java": "new Solution().diameterOfBinaryTree({root})",
        "csharp": "new Solution().DiameterOfBinaryTree({root})",
        "kotlin": "Solution().diameterOfBinaryTree({root})",
        "go": "diameterOfBinaryTree({root})",
        "dart": "Solution().diameterOfBinaryTree({root})",
        "swift": "Solution().diameterOfBinaryTree({root})",
        "typescript": "diameterOfBinaryTree({root})"
      }
    },
    "judge": {
      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(root, {result})",
        "checker": "class Checker:\n    def check(self, root, result):\n        if not isinstance(result, int):\n            return False\n        def diameter(tree):\n            ans = 0\n            def height(node):\n                nonlocal ans\n                if node is None:\n                    return 0\n                left = height(node.left)\n                right = height(node.right)\n                ans = max(ans, left + right)\n                return 1 + max(left, right)\n            height(tree)\n            return ans\n        return result == diameter(root)\n"
      }
    },
    "seed": 543,
