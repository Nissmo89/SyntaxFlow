    "oracle": {
      "python3": {
        "call": "Checker().minCostClimbingStairs(cost, {result})",
        "checker": "class Checker:\n    def _expected(self, arr):\n        prev2 = 0\n        prev1 = 0\n        for value in arr:\n            prev2, prev1 = prev1, min(prev1, prev2) + value\n        return min(prev1, prev2)\n\n    def _valid_cost(self, arr):\n        return (\n            isinstance(arr, list)\n            and 2 <= len(arr) <= 1000\n            and all(isinstance(x, int) and 0 <= x <= 999 for x in arr)\n        )\n\n    def _recover_original(self, arr):\n        if not isinstance(arr, list):\n            return None\n        if len(arr) < 3 or len(arr) > 1001:\n            return None\n        if any((not isinstance(x, int)) or x < 0 for x in arr):\n            return None\n        if arr[-1] != 0:\n            return None\n\n        original_len = len(arr) - 1\n        original = [0] * original_len\n        if arr[original_len - 1] > 999 or arr[original_len - 2] > 999:\n            return None\n\n        original[original_len - 2] = arr[original_len - 2]\n        original[original_len - 1] = arr[original_len - 1]\n\n        for i in range(original_len - 3, -1, -1):\n            value = arr[i] - min(arr[i + 1], arr[i + 2])\n            if value < 0 or value > 999:\n                return None\n            original[i] = value\n\n        replay = original[:] + [0]\n        for i in range(len(replay) - 4, -1, -1):\n            replay[i] += min(replay[i + 1], replay[i + 2])\n        if replay != arr:\n            return None\n\n        return original\n\n    def minCostClimbingStairs(self, cost, result):\n        if not isinstance(result, int):\n            return False\n        if not isinstance(cost, list):\n            return False\n\n        candidates = []\n        if self._valid_cost(cost):\n            candidates.append(cost)\n\n        recovered = self._recover_original(cost)\n        if recovered is not None:\n            candidates.append(recovered)\n\n        if not candidates:\n            return False\n\n        return any(result == self._expected(candidate) for candidate in candidates)\n"
      }
    },
