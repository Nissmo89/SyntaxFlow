    "oracle": {
      "python3": {
        "call": "Checker().findSecondMinimumValue(root, {result})",
        "checker": "class Checker:\n    def _second_min(self, node):\n        vals = []\n        stack = [node]\n        while stack:\n            cur = stack.pop()\n            if cur is None:\n                continue\n            if isinstance(cur, list):\n                vals.extend(v for v in cur if v is not None)\n                continue\n            if hasattr(cur, \"val\"):\n                vals.append(cur.val)\n                stack.append(getattr(cur, \"left\", None))\n                stack.append(getattr(cur, \"right\", None))\n            else:\n                vals.append(cur)\n        if not vals:\n            return -1\n        first = min(vals)\n        second = min((v for v in vals if v > first), default=None)\n        return -1 if second is None else second\n\n    def findSecondMinimumValue(self, root, result):\n        if not isinstance(result, int):\n            return False\n        return result == self._second_min(root)\n"
      }
    },
