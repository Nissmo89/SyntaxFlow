      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().isBoomerang(points, {result})",
        "checker": "class Checker:\n    def isBoomerang(self, points, result):\n        p1, p2, p3 = points\n        distinct = len({tuple(p1), tuple(p2), tuple(p3)}) == 3\n        area = (p2[0] - p1[0]) * (p3[1] - p1[1]) - (p2[1] - p1[1]) * (p3[0] - p1[0])\n        expected = distinct and area != 0\n        return expected == result\n"
      }
    },
