    "oracle": {
      "python3": {
        "call": "Checker().check(nums, {result})",
        "checker": "class Checker:\n    def check(self, nums, result):\n        expected = []\n        val = 0\n        for bit in nums:\n            val = (val * 2 + bit) % 5\n            expected.append(val == 0)\n        return result == expected\n"
      }
    },
