    "oracle": {
      "python3": {
        "call": "Checker().check(s, k, {result})",
        "checker": "class Checker:\n    def check(self, s, k, result):\n        if not isinstance(result, str):\n            return False\n        if len(result) != len(s):\n            return False\n        pieces = []\n        step = 2 * k\n        for i in range(0, len(s), step):\n            block = s[i:i + step]\n            pieces.append(block[:k][::-1] + block[k:])\n        return result == \"\".join(pieces)\n"
      }
    },
