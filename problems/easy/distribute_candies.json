    "oracle": {
      "python3": {
        "call": "Checker().distributeCandies(candyType, {result})",
        "checker": "class Checker:\n    def distributeCandies(self, candyType, result):\n        if not isinstance(result, (int, float)):\n            return False\n        if not isinstance(candyType, list):\n            return False\n        n = len(candyType)\n        if n < 2 or n > 10000 or n % 2 != 0:\n            return False\n        for value in candyType:\n            if not isinstance(value, int) or value < -100000 or value > 100000:\n                return False\n        expected = min(n // 2, len(set(candyType)))\n        return result == expected\n"
      }
    },
