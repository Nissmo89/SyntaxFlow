    "oracle": {
      "python3": {
        "call": "Checker().maxCount(m, n, ops, {result})",
        "checker": "from typing import Any, List\nclass Checker:\n    def maxCount(self, m: int, n: int, ops: List[List[int]], result: Any) -> bool:\n        if not isinstance(result, int):\n            return False\n        if not ops:\n            return result == m * n\n        min_m = min(op[0] for op in ops)\n        min_n = min(op[1] for op in ops)\n        return result == min_m * min_n\n"
      }
    },
