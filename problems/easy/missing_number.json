    "oracle": {
      "python3": {
        "call": "Checker().missingNumber(nums, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def missingNumber(self, nums: List[int], result: Any) -> bool:\n        if not isinstance(result, int):\n            return False\n        n = len(nums)\n        seen = set(nums)\n        if len(seen) != len(nums):\n            return False\n        if any(not isinstance(x, int) or x < 0 or x > n for x in nums):\n            return False\n        expected = set(range(n + 1)) - seen\n        return len(expected) == 1 and result == next(iter(expected))\n"
      }
    },
