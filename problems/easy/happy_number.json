    "oracle": {
      "python3": {
        "call": "Checker().isHappy(n, {result})",
        "checker": "class Checker:\n    def isHappy(self, n, result) -> bool:\n        if not isinstance(result, bool):\n            return False\n\n        seen = set()\n        while n != 1 and n not in seen:\n            seen.add(n)\n            total = 0\n            while n > 0:\n                digit = n % 10\n                total += digit * digit\n                n //= 10\n            n = total\n\n        return result == (n == 1)\n"
      }
    },
