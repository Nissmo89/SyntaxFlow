    "oracle": {
      "python3": {
        "call": "Checker().twoSum(nums, target, {result})",
        "checker": "class Checker:\n    def twoSum(self, nums, target, result):\n        if not isinstance(result, list) or len(result) != 2:\n            return False\n        i, j = result\n        if not isinstance(i, int) or not isinstance(j, int):\n            return False\n        if i == j:\n            return False\n        if i < 0 or j < 0 or i >= len(nums) or j >= len(nums):\n            return False\n        return nums[i] + nums[j] == target\n"
      }
    },
