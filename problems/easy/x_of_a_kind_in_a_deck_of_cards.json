    "oracle": {
      "python3": {
        "call": "Checker().hasGroupsSizeX(deck, {result})",
        "checker": "class Checker:\n    def hasGroupsSizeX(self, deck, result):\n        counts = {}\n        for x in deck:\n            counts[x] = counts.get(x, 0) + 1\n        g = 0\n        for c in counts.values():\n            while c:\n                g, c = c, g % c\n        return bool(result) == (g >= 2)\n"
      }
    },
