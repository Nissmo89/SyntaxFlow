    "oracle": {
      "python3": {
        "call": "Checker().numSubarrayProductLessThanK(nums, k, {result})",
        "checker": "class Checker:\n    def numSubarrayProductLessThanK(self, nums, k, result):\n        if not isinstance(result, int):\n            return False\n        if not isinstance(nums, list) or not isinstance(k, int):\n            return False\n        if any(not isinstance(x, int) or x < 1 or x > 1000 for x in nums):\n            return False\n        n = len(nums)\n        if not (1 <= n <= 30000):\n            return False\n        if not (0 <= k <= 1000000):\n            return False\n        if k <= 1:\n            return result == 0\n        expected = 0\n        left = 0\n        product = 1\n        for right, value in enumerate(nums):\n            product *= value\n            while left <= right and product >= k:\n                product //= nums[left]\n                left += 1\n            expected += right - left + 1\n        return result == expected\n"
      }
    },
