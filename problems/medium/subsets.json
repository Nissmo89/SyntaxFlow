    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().subsets(nums, {result})",
        "checker": "class Checker:\n    def subsets(self, nums, result):\n        nums = list(nums)\n        expected = []\n        n = len(nums)\n        for mask in range(1 << n):\n            cur = []\n            for i in range(n):\n                if mask & (1 << i):\n                    cur.append(nums[i])\n            expected.append(tuple(cur))\n        got = [tuple(x) for x in result]\n        return sorted(got) == sorted(expected)\n"
      }
    },
