      "time_ms": 1200,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().findPaths(m, n, maxMove, startRow, startColumn, {result})",
        "checker": "class Checker:\n    def findPaths(self, m, n, maxMove, startRow, startColumn, result):\n        mod = 10**9 + 7\n        dp = [[0] * n for _ in range(m)]\n        for _ in range(maxMove):\n            ndp = [[0] * n for _ in range(m)]\n            for i in range(m):\n                for j in range(n):\n                    val = 0\n                    for di, dj in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                        x = i + di\n                        y = j + dj\n                        if x < 0 or x >= m or y < 0 or y >= n:\n                            val += 1\n                        else:\n                            val += dp[x][y]\n                    ndp[i][j] = val % mod\n            dp = ndp\n        return isinstance(result, int) and result == dp[startRow][startColumn]\n"
      }
    },
