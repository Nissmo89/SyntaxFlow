    "oracle": {
      "python3": {
        "call": "Checker().monotoneIncreasingDigits(n, {result})",
        "checker": "class Checker:\n    def monotoneIncreasingDigits(self, n, result):\n        if not isinstance(result, int):\n            return False\n        if result < 0 or result > n:\n            return False\n        s = str(result)\n        for i in range(1, len(s)):\n            if s[i - 1] > s[i]:\n                return False\n        if result == n:\n            return True\n        candidate = result + 1\n        if candidate > n:\n            return True\n        cs = str(candidate)\n        for i in range(1, len(cs)):\n            if cs[i - 1] > cs[i]:\n                return True\n        return False\n"
      }
    },
