    "oracle": {
      "python3": {
        "call": "Checker().check(nums, {result})",
        "checker": "class Checker:\n    def check(self, nums, result):\n        n = len(nums)\n        if n == 0:\n            return result == 0\n        best = None\n        for k in range(n):\n            total = 0\n            for i in range(n):\n                total += i * nums[(i - k) % n]\n            if best is None or total > best:\n                best = total\n        return result == best\n"
      }
    },
