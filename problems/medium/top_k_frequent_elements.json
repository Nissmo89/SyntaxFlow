    "oracle": {
      "python3": {
        "call": "Checker().topKFrequent(nums, k, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def topKFrequent(self, nums, k, result):\n        if not isinstance(result, list):\n            return False\n        if len(result) != k:\n            return False\n        if any(not isinstance(x, int) for x in result):\n            return False\n        if len(set(result)) != len(result):\n            return False\n\n        counts = Counter(nums)\n        if any(x not in counts for x in result):\n            return False\n\n        ordered = sorted(counts.items(), key=lambda item: (-item[1], item[0]))\n        cutoff = ordered[k - 1][1]\n        required = {value for value, count in counts.items() if count > cutoff}\n        allowed = {value for value, count in counts.items() if count >= cutoff}\n        result_set = set(result)\n        return required.issubset(result_set) and result_set.issubset(allowed)\n"
      }
    },
