    "oracle": {
      "python3": {
        "call": "Checker().myPow(x, n, {result})",
        "checker": "import math\n\nclass Checker:\n    def myPow(self, x, n, result):\n        if math.isnan(result) or math.isinf(result):\n            return False\n        if x == 0:\n            expected = 0.0\n        elif n == 0:\n            expected = 1.0\n        elif x == 1:\n            expected = 1.0\n        elif x == -1:\n            expected = 1.0 if n % 2 == 0 else -1.0\n        else:\n            expected = math.pow(x, n)\n        return math.isclose(result, expected, rel_tol=1e-9, abs_tol=1e-9)\n"
      }
    },
