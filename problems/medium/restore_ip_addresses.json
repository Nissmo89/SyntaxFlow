    "oracle": {
      "python3": {
        "call": "Checker().restoreIpAddresses(s, {result})",
        "checker": "class Checker:\n    def restoreIpAddresses(self, s, result):\n        if not isinstance(s, str) or not isinstance(result, list):\n            return False\n\n        def valid_ip(ip):\n            parts = ip.split(\".\")\n            if len(parts) != 4:\n                return False\n            for part in parts:\n                if not part or len(part) > 3:\n                    return False\n                if len(part) > 1 and part[0] == \"0\":\n                    return False\n                if not part.isdigit():\n                    return False\n                value = int(part)\n                if value < 0 or value > 255:\n                    return False\n            return True\n\n        expected = set()\n        n = len(s)\n        for a in range(1, 4):\n            for b in range(1, 4):\n                for c in range(1, 4):\n                    d = n - a - b - c\n                    if 1 <= d <= 3:\n                        parts = [s[:a], s[a:a + b], s[a + b:a + b + c], s[a + b + c:]]\n                        if all(part and (len(part) == 1 or part[0] != \"0\") and int(part) <= 255 for part in parts):\n                            expected.add(\".\".join(parts))\n\n        if len(result) != len(set(result)):\n            return False\n        if any(not isinstance(item, str) or not valid_ip(item) for item in result):\n            return False\n        return set(result) == expected\n"
      }
    },
