    "oracle": {
      "python3": {
        "call": "Checker().insertIntoBST(root, val, {result})",
        "checker": "from collections import deque\nfrom typing import Any\n\nclass Checker:\n    def insertIntoBST(self, root: Any, val: int, result: Any) -> bool:\n        def node_val(node):\n            if node is None:\n                return None\n            if isinstance(node, dict):\n                return node.get(\"val\", node.get(\"value\"))\n            return getattr(node, \"val\", getattr(node, \"value\", None))\n\n        def node_left(node):\n            if node is None:\n                return None\n            if isinstance(node, dict):\n                return node.get(\"left\")\n            return getattr(node, \"left\", None)\n\n        def node_right(node):\n            if node is None:\n                return None\n            if isinstance(node, dict):\n                return node.get(\"right\")\n            return getattr(node, \"right\", None)\n\n        def is_tree_object(node):\n            return node is None or hasattr(node, \"val\") or isinstance(node, dict)\n\n        def normalize_tree(obj):\n            if obj is None:\n                return None\n            if isinstance(obj, list):\n                if not obj or obj[0] is None:\n                    return None\n                nodes = [None if x is None else {\"val\": x, \"left\": None, \"right\": None} for x in obj]\n                q = deque([0])\n                idx = 1\n                while q and idx < len(nodes):\n                    cur = q.popleft()\n                    if nodes[cur] is None:\n                        continue\n                    if idx < len(nodes):\n                        if nodes[idx] is not None:\n                            nodes[cur][\"left\"] = idx\n                            q.append(idx)\n                        idx += 1\n                    if idx < len(nodes):\n                        if nodes[idx] is not None:\n                            nodes[cur][\"right\"] = idx\n                            q.append(idx)\n                        idx += 1\n\n                def rec(i):\n                    if i is None:\n                        return None\n                    n = nodes[i]\n                    if n is None:\n                        return None\n                    return {\"val\": n[\"val\"], \"left\": rec(n[\"left\"]), \"right\": rec(n[\"right\"])}\n\n                return rec(0)\n            if is_tree_object(obj):\n                v = node_val(obj)\n                if v is None:\n                    return None\n                return {\n                    \"val\": v,\n                    \"left\": normalize_tree(node_left(obj)),\n                    \"right\": normalize_tree(node_right(obj)),\n                }\n            return None\n\n        def inorder(node):\n            if node is None:\n                return []\n            return inorder(node[\"left\"]) + [node[\"val\"]] + inorder(node[\"right\"])\n\n        def validate_bst(node, lo, hi):\n            if node is None:\n                return True\n            v = node[\"val\"]\n            if not (lo < v < hi):\n                return False\n            return validate_bst(node[\"left\"], lo, v) and validate_bst(node[\"right\"], v, hi)\n\n        def values_set(node):\n            if node is None:\n                return set()\n            return {node[\"val\"]} | values_set(node[\"left\"]) | values_set(node[\"right\"])\n\n        def count(node):\n            if node is None:\n                return 0\n            return 1 + count(node[\"left\"]) + count(node[\"right\"])\n\n        input_tree = normalize_tree(root)\n        output_tree = normalize_tree(result)\n        if output_tree is None:\n            return False\n        if not validate_bst(output_tree, float(\"-inf\"), float(\"inf\")):\n            return False\n        if input_tree is not None and not validate_bst(input_tree, float(\"-inf\"), float(\"inf\")):\n            return False\n\n        input_values = values_set(input_tree)\n        output_values = values_set(output_tree)\n        if val in input_values:\n            return False\n        if output_values != (input_values | {val}):\n            return False\n        if count(output_tree) != count(input_tree) + 1:\n            return False\n        if inorder(output_tree) != sorted(output_values):\n            return False\n        return True\n"
      }
    },
