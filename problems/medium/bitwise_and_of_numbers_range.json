      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().rangeBitwiseAnd(left, right, result)",
        "checker": "class Checker:\n    def rangeBitwiseAnd(self, left, right, result):\n        shift = 0\n        expected_left = left\n        expected_right = right\n        while expected_left < expected_right:\n            expected_left >>= 1\n            expected_right >>= 1\n            shift += 1\n        expected = expected_left << shift\n        return expected == result\n"
      }
    },
