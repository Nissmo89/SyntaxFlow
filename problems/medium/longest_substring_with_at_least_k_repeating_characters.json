      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().longestSubstring(s, k, {result})",
        "checker": "class Checker:\n    def longestSubstring(self, s, k, result):\n        n = len(s)\n        best = 0\n        for i in range(n + 1):\n            freq = [0] * 26\n            for j in range(i, n):\n                idx = ord(s[j]) - ord('a')\n                freq[idx] += 1\n                ok = True\n                for count in freq:\n                    if 0 < count < k:\n                        ok = False\n                        break\n                if ok:\n                    best = max(best, j - i + 1)\n        return result == best\n"
      }
    },
