    "oracle": {
      "python3": {
        "call": "Checker().convert(s, numRows, {result})",
        "checker": "class Checker:\n    def convert(self, s: str, numRows: int, result: str) -> bool:\n        if not isinstance(result, str):\n            return False\n        if numRows == 1 or numRows >= len(s):\n            return result == s\n        idx, direction = 0, 1\n        rows = [\"\"] * numRows\n        for ch in s:\n            rows[idx] += ch\n            if idx == 0:\n                direction = 1\n            elif idx == numRows - 1:\n                direction = -1\n            idx += direction\n        return result == \"\".join(rows)\n"
      }
    },
