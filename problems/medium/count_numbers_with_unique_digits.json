    "oracle": {
      "python3": {
        "call": "Checker().check(n, {result})",
        "checker": "class Checker:\n    def check(self, n, result):\n        if not isinstance(n, int) or not isinstance(result, int):\n            return False\n        if n < 0 or n > 8:\n            return False\n        if n == 0:\n            return result == 1\n        expected = 10\n        current = 9\n        for i in range(2, n + 1):\n            current *= 10 - (i - 1)\n            expected += current\n        return result == expected\n"
      }
    },
