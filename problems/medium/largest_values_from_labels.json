    "oracle": {
      "python3": {
        "call": "Checker().largestValsFromLabels(values, labels, numWanted, useLimit, {result})",
        "checker": "class Checker:\n    def largestValsFromLabels(self, values, labels, numWanted, useLimit, result):\n        pairs = sorted(zip(values, labels), reverse=True)\n        res = 0\n        freq = {}\n        for value, label in pairs:\n            if numWanted == 0:\n                break\n            if freq.get(label, 0) < useLimit:\n                res += value\n                freq[label] = freq.get(label, 0) + 1\n                numWanted -= 1\n        return res == result\n"
      }
    },
