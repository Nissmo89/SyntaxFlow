    "oracle": {
      "python3": {
        "call": "Checker().majorityElement(nums, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def majorityElement(self, nums: List[int], result: Any) -> bool:\n        if not isinstance(result, list):\n            return False\n        if any(not isinstance(x, int) for x in result):\n            return False\n        if len(set(result)) != len(result):\n            return False\n\n        n = len(nums)\n        threshold = n // 3\n        counts = {}\n        for num in nums:\n            counts[num] = counts.get(num, 0) + 1\n\n        expected = sorted(num for num, count in counts.items() if count > threshold)\n        return sorted(result) == expected\n"
      }
    },
