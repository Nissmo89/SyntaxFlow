    "oracle": {
      "python3": {
        "call": "Checker().minSteps(n, {result})",
        "checker": "class Checker:\n    def minSteps(self, n, result):\n        if not isinstance(n, int) or not isinstance(result, int):\n            return False\n        if n < 1 or n > 1000:\n            return False\n        if n == 1:\n            return result == 0\n\n        total = 0\n        x = n\n        d = 2\n        while d * d <= x:\n            while x % d == 0:\n                total += d\n                x //= d\n            d += 1\n        if x > 1:\n            total += x\n        return result == total\n"
      }
    },
