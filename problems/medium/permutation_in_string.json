      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().checkInclusion(s1, s2, {result})",
        "checker": "class Checker:\n    def checkInclusion(self, s1, s2, result):\n        if not isinstance(result, bool):\n            return False\n        if not isinstance(s1, str) or not isinstance(s2, str):\n            return False\n        if not (1 <= len(s1) <= 10000 and 1 <= len(s2) <= 10000):\n            return False\n        if any(not (\"a\" <= ch <= \"z\") for ch in s1 + s2):\n            return False\n        n1, n2 = len(s1), len(s2)\n        if n2 < n1:\n            return result is False\n        c1 = [0] * 26\n        c2 = [0] * 26\n        for i in range(n1):\n            c1[ord(s1[i]) - 97] += 1\n            c2[ord(s2[i]) - 97] += 1\n        if c1 == c2:\n            return result is True\n        for i in range(n1, n2):\n            c2[ord(s2[i]) - 97] += 1\n            c2[ord(s2[i - n1]) - 97] -= 1\n            if c1 == c2:\n                return result is True\n        return result is False\n"
      }
    },
