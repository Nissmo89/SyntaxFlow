    "oracle": {
      "python3": {
        "call": "Checker().new21Game(n, k, maxPts, {result})",
        "checker": "class Checker:\n    def new21Game(self, n, k, maxPts, result):\n        if not isinstance(result, (int, float)):\n            return False\n        if k == 0 or n >= k - 1 + maxPts:\n            expected = 1.0\n        else:\n            dp = [0.0] * maxPts\n            dp[0] = 1.0\n            window_sum = 1.0\n            expected = 0.0\n            for i in range(1, n + 1):\n                prob = window_sum / maxPts\n                if i < k:\n                    window_sum += prob\n                else:\n                    expected += prob\n                if i >= maxPts:\n                    window_sum -= dp[i % maxPts]\n                dp[i % maxPts] = prob\n        return abs(float(result) - expected) <= 1e-5\n"
      }
    },
