        "go": "computeArea({ax1}, {ay1}, {ax2}, {ay2}, {bx1}, {by1}, {bx2}, {by2})",
        "dart": "Solution().computeArea({ax1}, {ay1}, {ax2}, {ay2}, {bx1}, {by1}, {bx2}, {by2})",
        "swift": "Solution().computeArea({ax1}, {ay1}, {ax2}, {ay2}, {bx1}, {by1}, {bx2}, {by2})",
