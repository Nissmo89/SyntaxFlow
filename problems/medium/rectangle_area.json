    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().computeArea(ax1, ay1, ax2, ay2, bx1, by1, bx2, by2, result)",
        "checker": "class Checker:\n    def computeArea(self, ax1, ay1, ax2, ay2, bx1, by1, bx2, by2, result):\n        area1 = (ax2 - ax1) * (ay2 - ay1)\n        area2 = (bx2 - bx1) * (by2 - by1)\n        overlap_width = max(0, min(ax2, bx2) - max(ax1, bx1))\n        overlap_height = max(0, min(ay2, by2) - max(ay1, by1))\n        expected = area1 + area2 - overlap_width * overlap_height\n        return result == expected\n"
      }
    },
