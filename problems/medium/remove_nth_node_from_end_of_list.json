      "type": "exact"
    },
    "limits": {
      "time_ms": 200,
      "memory_mb": 300
    },
    "oracle": {
      "python3": {
        "call": "Checker().removeNthFromEnd(head, n, {result})",
        "checker": "class Checker:\n    def removeNthFromEnd(self, head, n, result) -> bool:\n        vals = []\n        cur = head\n        steps = 0\n        while cur is not None and steps <= 1000:\n            vals.append(cur.val)\n            cur = cur.next\n            steps += 1\n        if cur is not None:\n            return False\n        if not isinstance(result, list):\n            return False\n        if len(vals) == 0 or not (1 <= n <= len(vals)):\n            return False\n        expected = vals[:len(vals) - n] + vals[len(vals) - n + 1:]\n        return result == expected\n"
      }
    },
