    "oracle": {
      "python3": {
        "call": "Checker().canIWin(maxChoosableInteger, desiredTotal, {result})",
        "checker": "class Checker:\n    def canIWin(self, maxChoosableInteger, desiredTotal, result):\n        if not isinstance(result, bool):\n            return False\n\n        if desiredTotal <= 0:\n            return result is True\n\n        if maxChoosableInteger * (maxChoosableInteger + 1) // 2 < desiredTotal:\n            return result is False\n\n        memo = {}\n\n        def can_win(mask, total):\n            key = (mask, total)\n            if key in memo:\n                return memo[key]\n            for i in range(maxChoosableInteger):\n                bit = 1 << i\n                if mask & bit:\n                    continue\n                pick = i + 1\n                if pick >= total or not can_win(mask | bit, total - pick):\n                    memo[key] = True\n                    return True\n            memo[key] = False\n            return False\n\n        return result is can_win(0, desiredTotal)\n"
      }
    },
