    "oracle": {
      "python3": {
        "call": "Checker().rob(root, {result})",
        "checker": "class Checker:\n    def rob(self, root, result):\n        if isinstance(root, list):\n            root = self._build_tree(root)\n\n        def dfs(node):\n            if node is None:\n                return 0, 0\n            take_left, skip_left = dfs(node.left)\n            take_right, skip_right = dfs(node.right)\n            take = node.val + skip_left + skip_right\n            skip = max(take_left, skip_left) + max(take_right, skip_right)\n            return take, skip\n\n        expected = max(dfs(root))\n        return isinstance(result, int) and result == expected\n\n    def _build_tree(self, values):\n        if not values:\n            return None\n        nodes = [None if v is None else TreeNode(v) for v in values]\n        child = 1\n        for node in nodes:\n            if node is None:\n                continue\n            if child < len(nodes):\n                node.left = nodes[child]\n                child += 1\n            if child < len(nodes):\n                node.right = nodes[child]\n                child += 1\n        return nodes[0]\n"
      }
    },
