    "oracle": {
      "python3": {
        "call": "Checker().threeSumMulti(arr, target, {result})",
        "checker": "class Checker:\n    def threeSumMulti(self, arr, target, result):\n        mod = 10 ** 9 + 7\n        n = len(arr)\n        count = 0\n        for i in range(n):\n            for j in range(i + 1, n):\n                for k in range(j + 1, n):\n                    if arr[i] + arr[j] + arr[k] == target:\n                        count += 1\n        return result == count % mod\n"
      }
    },
