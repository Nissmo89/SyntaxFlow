    "oracle": {
      "python3": {
        "call": "Checker().longestUnivaluePath(root, {result})",
        "checker": "class Checker:\n    class _Node:\n        __slots__ = (\"val\", \"left\", \"right\")\n\n        def __init__(self, val=0, left=None, right=None):\n            self.val = val\n            self.left = left\n            self.right = right\n\n    def _build(self, root):\n        if root is None:\n            return None\n        if hasattr(root, \"val\"):\n            return root\n        if not isinstance(root, list) or not root:\n            return None\n        it = iter(root)\n        first = next(it, None)\n        if first is None:\n            return None\n        head = self._Node(first)\n        queue = [head]\n        for node in queue:\n            left = next(it, None)\n            if left is not None:\n                node.left = self._Node(left)\n                queue.append(node.left)\n            right = next(it, None)\n            if right is not None:\n                node.right = self._Node(right)\n                queue.append(node.right)\n        return head\n\n    def longestUnivaluePath(self, root, result):\n        root = self._build(root)\n\n        ans = 0\n\n        def dfs(node):\n            nonlocal ans\n            if node is None:\n                return 0\n            left = dfs(node.left)\n            right = dfs(node.right)\n            lp = 0\n            rp = 0\n            if node.left is not None and node.left.val == node.val:\n                lp = left + 1\n            if node.right is not None and node.right.val == node.val:\n                rp = right + 1\n            if lp + rp > ans:\n                ans = lp + rp\n            return lp if lp > rp else rp\n\n        dfs(root)\n        return isinstance(result, int) and result == ans\n"
      }
    },
