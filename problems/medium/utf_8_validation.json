    "oracle": {
      "python3": {
        "call": "Checker().check(data, {result})",
        "checker": "class Checker:\n    def check(self, data, result):\n        i = 0\n        n = len(data)\n        while i < n:\n            b = data[i]\n            if b < 0 or b > 255:\n                return result is False\n            if b >> 7 == 0:\n                need = 0\n            elif b >> 5 == 0b110:\n                need = 1\n            elif b >> 4 == 0b1110:\n                need = 2\n            elif b >> 3 == 0b11110:\n                need = 3\n            else:\n                return result is False\n            if i + need >= n:\n                return result is False\n            for j in range(1, need + 1):\n                if data[i + j] < 0 or data[i + j] > 255 or data[i + j] >> 6 != 0b10:\n                    return result is False\n            i += need + 1\n        return result is True\n"
      }
    },
