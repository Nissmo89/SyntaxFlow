    "oracle": {
      "python3": {
        "call": "Checker().possibleBipartition(n, dislikes, {result})",
        "checker": "from collections import deque\n\nclass Checker:\n    def possibleBipartition(self, n, dislikes, result):\n        graph = [[] for _ in range(n + 1)]\n        for a, b in dislikes:\n            graph[a].append(b)\n            graph[b].append(a)\n        color = [0] * (n + 1)\n        for start in range(1, n + 1):\n            if color[start] != 0:\n                continue\n            color[start] = 1\n            q = deque([start])\n            while q:\n                node = q.popleft()\n                for nb in graph[node]:\n                    if color[nb] == color[node]:\n                        return result is False\n                    if color[nb] == 0:\n                        color[nb] = -color[node]\n                        q.append(nb)\n        return result is True\n"
      }
    },
