    "oracle": {
      "python3": {
        "call": "Checker().calcEquation(equations, values, queries, {result})",
        "checker": "class Checker:\n    def calcEquation(self, equations, values, queries, result):\n        if not isinstance(result, list) or len(result) != len(queries):\n            return False\n        g = {}\n        for pair, value in zip(equations, values):\n            if not isinstance(pair, list) or len(pair) != 2:\n                return False\n            a, b = pair\n            g.setdefault(a, {})[b] = value\n            g.setdefault(b, {})[a] = 1.0 / value\n\n        def expected(x, y):\n            if x not in g or y not in g:\n                return -1.0\n            stack = [(x, 1.0)]\n            seen = set()\n            while stack:\n                node, ratio = stack.pop()\n                if node == y:\n                    return ratio\n                if node in seen:\n                    continue\n                seen.add(node)\n                for nxt, weight in g[node].items():\n                    if nxt not in seen:\n                        stack.append((nxt, ratio * weight))\n            return -1.0\n\n        for (a, b), actual in zip(queries, result):\n            if not isinstance(actual, (int, float)):\n                return False\n            exp = expected(a, b)\n            if exp == -1.0:\n                if actual != -1.0:\n                    return False\n            else:\n                if abs(actual - exp) > 1e-9:\n                    return False\n        return True\n"
      }
    },
