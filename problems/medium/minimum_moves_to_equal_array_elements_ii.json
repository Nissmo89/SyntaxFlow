    "oracle": {
      "python3": {
        "call": "Checker().minMoves2(nums, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def minMoves2(self, nums: List[int], result: Any) -> bool:\n        if not isinstance(result, int):\n            return False\n        if not nums:\n            return False\n        nums_sorted = sorted(nums)\n        median = nums_sorted[len(nums_sorted) // 2]\n        expected = sum(abs(num - median) for num in nums_sorted)\n        return result == expected\n"
      }
    },
