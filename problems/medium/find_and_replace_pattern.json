    "oracle": {
      "python3": {
        "call": "Checker().check(words, pattern, {result})",
        "checker": "from collections import Counter\n\nclass Checker(object):\n    def check(self, words, pattern, result):\n        if not isinstance(result, list):\n            return False\n        expected = []\n        pattern_signature = [pattern.index(c) for c in pattern]\n        for word in words:\n            if len(word) != len(pattern):\n                return False\n            if [word.index(c) for c in word] == pattern_signature:\n                expected.append(word)\n        return Counter(result) == Counter(expected)\n"
      }
    },
