      "memory_mb": 300
    },
    "oracle": {
      "python3": {
        "call": "Checker().triangleNumber(nums, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def triangleNumber(self, nums: List[int], result: Any) -> bool:\n        if not isinstance(result, int):\n            return False\n        arr = sorted(nums)\n        n = len(arr)\n        expected = 0\n        for i in range(n - 1, -1, -1):\n            left, right = 0, i - 1\n            while left < right:\n                if arr[left] + arr[right] > arr[i]:\n                    expected += right - left\n                    right -= 1\n                else:\n                    left += 1\n        return result == expected\n"
      }
    },
