    "oracle": {
      "python3": {
        "call": "Checker().checkSubarraySum(nums, k, {result})",
        "checker": "class Checker:\n    def checkSubarraySum(self, nums, k, result):\n        if not isinstance(result, bool):\n            return False\n        n = len(nums)\n        expected = False\n        for i in range(n):\n            s = 0\n            for j in range(i, n):\n                s += nums[j]\n                if j - i + 1 >= 2 and s % k == 0:\n                    expected = True\n                    break\n            if expected:\n                break\n        return result == expected\n"
      }
    },
