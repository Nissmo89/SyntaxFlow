    "oracle": {
      "python3": {
        "call": "Checker().insert(intervals, newInterval, {result})",
        "checker": "class Checker:\n    def insert(self, intervals, newInterval, result):\n        if not isinstance(result, list):\n            return False\n        for interval in result:\n            if not isinstance(interval, list) or len(interval) != 2:\n                return False\n            if not all(isinstance(x, int) for x in interval):\n                return False\n            if interval[0] > interval[1]:\n                return False\n        expected = []\n        i = 0\n        n = len(intervals)\n        new_start, new_end = newInterval\n        while i < n and intervals[i][1] < new_start:\n            expected.append(intervals[i])\n            i += 1\n        while i < n and intervals[i][0] <= new_end:\n            new_start = min(new_start, intervals[i][0])\n            new_end = max(new_end, intervals[i][1])\n            i += 1\n        expected.append([new_start, new_end])\n        while i < n:\n            expected.append(intervals[i])\n            i += 1\n        return result == expected\n"
      }
    },
