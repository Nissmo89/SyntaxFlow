        "cpp": "Solution().largestNumber({nums})",
        "rust": "Solution::largest_number({nums})",
        "python3": "Solution().largestNumber({nums})",
        "python2": "Solution().largestNumber({nums})",
        "ruby": "largest_number({nums})",
        "java": "new Solution().largestNumber({nums})",
        "csharp": "new Solution().LargestNumber({nums})",
        "kotlin": "Solution().largestNumber({nums})",
        "go": "largestNumber({nums})",
        "dart": "Solution().largestNumber({nums})",
        "swift": "Solution().largestNumber({nums})",
        "typescript": "largestNumber({nums})"
      }
