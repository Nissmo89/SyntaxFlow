      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().largestNumber(nums, {result})",
        "checker": "class Checker:\n    def largestNumber(self, nums, result):\n        arr = list(map(str, nums))\n        from functools import cmp_to_key\n\n        def cmp(a, b):\n            ab = a + b\n            ba = b + a\n            if ab > ba:\n                return -1\n            if ab < ba:\n                return 1\n            return 0\n\n        arr.sort(key=cmp_to_key(cmp))\n        expected = \"0\" if arr[0] == \"0\" else \"\".join(arr)\n        return result == expected\n"
      }
    },
