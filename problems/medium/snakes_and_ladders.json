    "oracle": {
      "python3": {
        "call": "Checker().snakesAndLadders(board, {result})",
        "checker": "from collections import deque\nclass Checker:\n    def snakesAndLadders(self, board, result):\n        n = len(board)\n        dist = [-1] * (n * n + 1)\n        q = deque([1])\n        dist[1] = 0\n        while q:\n            x = q.popleft()\n            for i in range(1, 7):\n                t = x + i\n                if t > n * n:\n                    break\n                row = (t - 1) // n\n                col = (t - 1) % n\n                v = board[n - 1 - row][(n - 1 - col) if (row % 2 == 1) else col]\n                y = v if v > 0 else t\n                if y == n * n:\n                    expected = dist[x] + 1\n                    return result == expected\n                if dist[y] == -1:\n                    dist[y] = dist[x] + 1\n                    q.append(y)\n        return result == -1\n"
      }
    },
