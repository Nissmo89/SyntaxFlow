    "oracle": {
      "python3": {
        "call": "Checker().findDuplicateSubtrees(root, {result})",
        "checker": "class Checker:\n    def findDuplicateSubtrees(self, root, result):\n        from collections import defaultdict\n\n        serial_to_count = defaultdict(int)\n\n        def build_from_list(values):\n            if not values:\n                return None\n            nodes = [None if v is None else TreeNode(v) for v in values]\n            kids = nodes[::-1]\n            root_node = kids.pop()\n            for node in nodes:\n                if node is not None:\n                    if kids:\n                        node.left = kids.pop()\n                    if kids:\n                        node.right = kids.pop()\n            return root_node\n\n        def normalize(node):\n            if node is None:\n                return None\n            if isinstance(node, list):\n                return build_from_list(node)\n            if isinstance(node, dict):\n                val = node.get(\"val\", node.get(\"value\"))\n                left = normalize(node.get(\"left\"))\n                right = normalize(node.get(\"right\"))\n                return TreeNode(val, left, right)\n            if hasattr(node, \"val\"):\n                return node\n            return None\n\n        root = normalize(root)\n\n        def dfs(node):\n            if node is None:\n                return \"#\"\n            left = dfs(node.left)\n            right = dfs(node.right)\n            serial = f\"{node.val},{left},{right}\"\n            serial_to_count[serial] += 1\n            return serial\n\n        dfs(root)\n        expected = {serial for serial, count in serial_to_count.items() if count >= 2}\n\n        if not isinstance(result, list):\n            return False\n\n        actual = set()\n        seen_serials = set()\n        for node in result:\n            node = normalize(node)\n            if node is None:\n                return False\n\n            def serialize(curr):\n                if curr is None:\n                    return \"#\"\n                return f\"{curr.val},{serialize(curr.left)},{serialize(curr.right)}\"\n\n            serial = serialize(node)\n            if serial in seen_serials:\n                return False\n            seen_serials.add(serial)\n            actual.add(serial)\n\n        return actual == expected\n"
      }
    },
