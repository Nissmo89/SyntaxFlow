    "oracle": {
      "python3": {
        "call": "Checker().maximumSwap(num, {result})",
        "checker": "class Checker:\n    def maximumSwap(self, num, result):\n        if not isinstance(result, int):\n            return False\n        if num < 0 or num > 10**8:\n            return False\n        digits = list(str(num))\n        last_index = {int(d): i for i, d in enumerate(digits)}\n        for i, d in enumerate(digits):\n            for x in range(9, int(d), -1):\n                if x in last_index and last_index[x] > i:\n                    digits[i], digits[last_index[x]] = digits[last_index[x]], digits[i]\n                    expected = int(\"\".join(digits))\n                    return result == expected\n        return result == num\n"
      }
    },
