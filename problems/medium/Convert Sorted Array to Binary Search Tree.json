    "oracle": {
      "python3": {
        "call": "Checker().sortedArrayToBST(nums, {result})",
        "checker": "class Checker:\n    def sortedArrayToBST(self, nums, result):\n        if not isinstance(result, list):\n            return False\n        if not nums:\n            return result == []\n        if not result or result[0] is None:\n            return False\n\n        def validate(i, low, high):\n            if i >= len(result) or result[i] is None:\n                return 0, True, []\n            val = result[i]\n            if not isinstance(val, int) or not (low < val < high):\n                return 0, False, []\n            lh, lok, lvals = validate(2 * i + 1, low, val)\n            if not lok:\n                return 0, False, []\n            rh, rok, rvals = validate(2 * i + 2, val, high)\n            if not rok or abs(lh - rh) > 1:\n                return 0, False, []\n            return max(lh, rh) + 1, True, lvals + [val] + rvals\n\n        _, ok, inorder_vals = validate(0, float(\"-inf\"), float(\"inf\"))\n        return ok and inorder_vals == nums\n"
      }
    },
