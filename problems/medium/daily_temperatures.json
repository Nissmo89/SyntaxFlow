      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(temperatures, {result})",
        "checker": "class Checker(object):\n    def check(self, temperatures, result):\n        if not isinstance(result, list):\n            return False\n        if len(result) != len(temperatures):\n            return False\n        for value in result:\n            if not isinstance(value, int):\n                return False\n            if value < 0:\n                return False\n        n = len(temperatures)\n        nearest = [None] * 101\n        for i in range(n - 1, -1, -1):\n            cur = temperatures[i]\n            best = None\n            for warmer in range(cur + 1, 101):\n                idx = nearest[warmer]\n                if idx is not None and (best is None or idx < best):\n                    best = idx\n            expected = 0 if best is None else best - i\n            if result[i] != expected:\n                return False\n            nearest[cur] = i\n        return True\n"
      }
    },
