    "oracle": {
      "python3": {
        "call": "Checker().fourSum(nums, target, {result})",
        "checker": "class Checker:\n    def fourSum(self, nums, target, result):\n        if not isinstance(result, list):\n            return False\n\n        normalized = []\n        seen = set()\n        for quad in result:\n            if not isinstance(quad, list) or len(quad) != 4:\n                return False\n            if any(not isinstance(x, int) for x in quad):\n                return False\n            if quad != sorted(quad):\n                return False\n            t = tuple(quad)\n            if t in seen:\n                return False\n            seen.add(t)\n            if sum(quad) != target:\n                return False\n            normalized.append(t)\n\n        nums = sorted(nums)\n        expected = set()\n        n = len(nums)\n        for i in range(n - 3):\n            if i > 0 and nums[i] == nums[i - 1]:\n                continue\n            for j in range(i + 1, n - 2):\n                if j > i + 1 and nums[j] == nums[j - 1]:\n                    continue\n                left = j + 1\n                right = n - 1\n                while left < right:\n                    s = nums[i] + nums[j] + nums[left] + nums[right]\n                    if s == target:\n                        expected.add((nums[i], nums[j], nums[left], nums[right]))\n                        left += 1\n                        right -= 1\n                        while left < right and nums[left] == nums[left - 1]:\n                            left += 1\n                        while left < right and nums[right] == nums[right + 1]:\n                            right -= 1\n                    elif s < target:\n                        left += 1\n                    else:\n                        right -= 1\n\n        return set(normalized) == expected\n"
      }
    },
