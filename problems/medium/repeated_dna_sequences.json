      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().findRepeatedDnaSequences(s, {result})",
        "checker": "class Checker:\n    def findRepeatedDnaSequences(self, s, result):\n        def repeated_sequences(text):\n            seen = {}\n            repeated = []\n            for i in range(len(text) - 9):\n                seq = text[i:i + 10]\n                if seq not in seen:\n                    seen[seq] = 1\n                elif seen[seq] == 1:\n                    repeated.append(seq)\n                    seen[seq] = 2\n            return repeated\n\n        if not isinstance(result, list):\n            return False\n        if any(not isinstance(x, str) for x in result):\n            return False\n        if any(len(x) != 10 for x in result):\n            return False\n        if any(set(x) - set(\"ACGT\") for x in result):\n            return False\n\n        expected = repeated_sequences(s)\n        return sorted(result) == sorted(expected) and len(result) == len(set(result))\n"
      }
    },
