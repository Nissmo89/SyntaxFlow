        "rust": "TreeNode::tree_node_to_array(Solution::prune_tree({root}))",
        "python3": "tree_node_to_array(Solution().pruneTree({root}))",
        "python2": "tree_node_to_array(Solution().pruneTree({root}))",
        "ruby": "tree_node_to_array(prune_tree({root}))",
        "java": "TreeNode.treeNodeToArray(new Solution().pruneTree({root}))",
        "csharp": "TreeNode.TreeNodeToArray(new Solution().PruneTree({root}))",
        "kotlin": "treeNodeToArray(Solution().pruneTree({root}))",
        "go": "treeNodeToArray(pruneTree({root}))",
        "dart": "tree_node_to_array(Solution().pruneTree({root}))",
        "swift": "tree_node_to_array(Solution().pruneTree({root}))",
        "typescript": "treeNodeToArray(pruneTree({root}))"
      }
    },
    "judge": {
      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(root, {result})",
        "checker": "class Checker:\n    def from_value(self, value):\n        if value is None:\n            return None\n        if isinstance(value, dict):\n            return {\n                \"val\": value.get(\"val\"),\n                \"left\": self.from_value(value.get(\"left\")),\n                \"right\": self.from_value(value.get(\"right\")),\n            }\n        if isinstance(value, list):\n            if not value:\n                return None\n            nodes = [None if v is None else {\"val\": v, \"left\": None, \"right\": None} for v in value]\n            kids = nodes[1:]\n            idx = 0\n            for node in nodes:\n                if node is not None:\n                    if idx < len(kids):\n                        node[\"left\"] = kids[idx]\n                        idx += 1\n                    if idx < len(kids):\n                        node[\"right\"] = kids[idx]\n                        idx += 1\n            return nodes[0]\n        if hasattr(value, \"val\"):\n            return {\n                \"val\": value.val,\n                \"left\": self.from_value(getattr(value, \"left\", None)),\n                \"right\": self.from_value(getattr(value, \"right\", None)),\n            }\n        return value\n\n    def prune(self, node):\n        if not node:\n            return None\n        node[\"left\"] = self.prune(node[\"left\"])\n        node[\"right\"] = self.prune(node[\"right\"])\n        if node[\"val\"] == 0 and node[\"left\"] is None and node[\"right\"] is None:\n            return None\n        return node\n\n    def to_array(self, root):\n        if not root:\n            return []\n        out = []\n        q = [root]\n        while q:\n            node = q.pop(0)\n            if node is None:\n                out.append(None)\n            else:\n                out.append(node[\"val\"])\n                q.append(node[\"left\"])\n                q.append(node[\"right\"])\n        while out and out[-1] is None:\n            out.pop()\n        return out\n\n    def check(self, root, result):\n        return self.to_array(self.prune(self.from_value(root))) == self.to_array(self.from_value(result))\n"
      }
    },
