    "oracle": {
      "python3": {
        "call": "Checker().longestStrChain(words, {result})",
        "checker": "class Checker:\n    def longestStrChain(self, words, result) -> bool:\n        words = sorted(words, key=len)\n        dp = {}\n        best = 0\n        for word in words:\n            cur = 1\n            for i in range(len(word)):\n                pred = word[:i] + word[i + 1:]\n                if pred in dp and dp[pred] + 1 > cur:\n                    cur = dp[pred] + 1\n            dp[word] = cur\n            if cur > best:\n                best = cur\n        return result == best\n"
      }
    },
