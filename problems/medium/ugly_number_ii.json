    "oracle": {
      "python3": {
        "call": "Checker().nthUglyNumber(n, {result})",
        "checker": "class Checker:\n    def __init__(self):\n        self.values = [1]\n        i = j = k = 0\n        while len(self.values) < 1690:\n            m = min(self.values[i] * 2, self.values[j] * 3, self.values[k] * 5)\n            self.values.append(m)\n            if m == self.values[i] * 2:\n                i += 1\n            if m == self.values[j] * 3:\n                j += 1\n            if m == self.values[k] * 5:\n                k += 1\n\n    def nthUglyNumber(self, n, result):\n        if not isinstance(result, int):\n            return False\n        if not isinstance(n, int) or n < 1 or n > 1690:\n            return False\n        return result == self.values[n - 1]\n"
      }
    },
