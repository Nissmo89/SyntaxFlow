    "oracle": {
      "python3": {
        "call": "Checker().threeSum(nums, {result})",
        "checker": "class Checker:\n    def threeSum(self, nums, result):\n        if not isinstance(result, list):\n            return False\n\n        seen = set()\n        actual = set()\n        for triplet in result:\n            if not isinstance(triplet, list) or len(triplet) != 3:\n                return False\n            if any(not isinstance(x, int) for x in triplet):\n                return False\n            if triplet != sorted(triplet):\n                return False\n            if triplet[0] + triplet[1] + triplet[2] != 0:\n                return False\n            tup = tuple(triplet)\n            if tup in seen:\n                return False\n            seen.add(tup)\n            actual.add(tup)\n\n        nums_sorted = sorted(nums)\n        expected = set()\n        n = len(nums_sorted)\n        for i in range(n - 2):\n            if i > 0 and nums_sorted[i] == nums_sorted[i - 1]:\n                continue\n            j, k = i + 1, n - 1\n            while j < k:\n                total = nums_sorted[i] + nums_sorted[j] + nums_sorted[k]\n                if total == 0:\n                    expected.add((nums_sorted[i], nums_sorted[j], nums_sorted[k]))\n                    j += 1\n                    k -= 1\n                    while j < k and nums_sorted[j] == nums_sorted[j - 1]:\n                        j += 1\n                elif total < 0:\n                    j += 1\n                else:\n                    k -= 1\n\n        return actual == expected\n"
      }
    },
