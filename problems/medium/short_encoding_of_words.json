    "oracle": {
      "python3": {
        "call": "Checker().minimumLengthEncoding(words, {result})",
        "checker": "class Checker:\n    def minimumLengthEncoding(self, words, result):\n        if not isinstance(result, int):\n            return False\n        words = list(set(words))\n        words.sort(key=len, reverse=True)\n        seen = set()\n        total = 0\n        for word in words:\n            if word in seen:\n                continue\n            total += len(word) + 1\n            for i in range(len(word)):\n                seen.add(word[i:])\n        return result == total\n"
      }
    },
