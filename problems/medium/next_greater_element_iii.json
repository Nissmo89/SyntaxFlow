    "oracle": {
      "python3": {
        "call": "Checker().check(n, {result})",
        "checker": "class Checker:\n    def _next_perm_value(self, n):\n        digits = list(str(n))\n        i = len(digits) - 2\n        while i >= 0 and digits[i] >= digits[i + 1]:\n            i -= 1\n        if i < 0:\n            return -1\n        j = len(digits) - 1\n        while digits[j] <= digits[i]:\n            j -= 1\n        digits[i], digits[j] = digits[j], digits[i]\n        digits[i + 1:] = reversed(digits[i + 1:])\n        value = int(\"\".join(digits))\n        if value > 2147483647:\n            return -1\n        return value\n\n    def check(self, n, result):\n        if not isinstance(result, int):\n            return False\n        return result == self._next_perm_value(n)\n"
      }
    },
