    "oracle": {
      "python3": {
        "call": "Checker().reorderedPowerOf2(n, {result})",
        "checker": "from typing import Any\n\nclass Checker:\n    def reorderedPowerOf2(self, n: int, result: Any) -> bool:\n        if not isinstance(result, bool):\n            return False\n        digits = sorted(str(n))\n        powers = set()\n        x = 1\n        while x <= 10**9:\n            powers.add(tuple(sorted(str(x))))\n            x <<= 1\n        return result == (tuple(digits) in powers)\n"
      }
    },
