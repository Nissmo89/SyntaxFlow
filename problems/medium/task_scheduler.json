    "oracle": {
      "python3": {
        "call": "Checker().leastInterval(tasks, n, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def leastInterval(self, tasks, n, result):\n        if not isinstance(result, int):\n            return False\n        count = Counter(tasks)\n        f_max = max(count.values())\n        max_count = sum(1 for v in count.values() if v == f_max)\n        expected = max(len(tasks), (f_max - 1) * (n + 1) + max_count)\n        return result == expected\n"
      }
    },
