    "oracle": {
      "python3": {
        "call": "Checker().largestDivisibleSubset(nums, {result})",
        "checker": "class Checker:\n    def largestDivisibleSubset(self, nums, result):\n        if not isinstance(nums, list) or not isinstance(result, list):\n            return False\n        if len(nums) == 0:\n            return False\n        if len(set(nums)) != len(nums):\n            return False\n        input_set = set(nums)\n        if len(result) == 0:\n            return False\n        if any(x not in input_set for x in result):\n            return False\n        if len(set(result)) != len(result):\n            return False\n        for i in range(len(result)):\n            for j in range(i + 1, len(result)):\n                a = result[i]\n                b = result[j]\n                if a % b != 0 and b % a != 0:\n                    return False\n        nums = sorted(nums)\n        dp = [1] * len(nums)\n        best = 1\n        for i in range(len(nums)):\n            for j in range(i):\n                if nums[i] % nums[j] == 0 and dp[i] < dp[j] + 1:\n                    dp[i] = dp[j] + 1\n            if dp[i] > best:\n                best = dp[i]\n        return len(result) == best\n"
      }
    },
