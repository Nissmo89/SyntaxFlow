    "oracle": {
      "python3": {
        "call": "Checker().subdomainVisits(cpdomains, {result})",
        "checker": "class Checker:\n    def subdomainVisits(self, cpdomains, result):\n        freq = {}\n        for entry in cpdomains:\n            cnt, dom = entry.split()\n            cnt = int(cnt)\n            parts = dom.split('.')\n            for i in range(len(parts)):\n                sub = '.'.join(parts[i:])\n                freq[sub] = freq.get(sub, 0) + cnt\n        expected = [f\"{c} {d}\" for d, c in freq.items()]\n        return sorted(expected) == sorted(result)\n"
      }
    },
