    "oracle": {
      "python3": {
        "call": "Checker().sumSubarrayMins(nums, {result})",
        "checker": "class Checker:\n    def sumSubarrayMins(self, nums, result):\n        mod = 10**9 + 7\n        stack = []\n        res = [0] * len(nums)\n        for i, x in enumerate(nums):\n            while stack and nums[stack[-1]] > x:\n                stack.pop()\n            j = stack[-1] if stack else -1\n            res[i] = (res[j] if j != -1 else 0) + (i - j) * x\n            stack.append(i)\n        expected = sum(res) % mod\n        return result == expected\n"
      }
    },
