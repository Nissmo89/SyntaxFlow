    "oracle": {
      "python3": {
        "call": "Checker().prevPermOpt1(arr, {result})",
        "checker": "class Checker:\n    def prevPermOpt1(self, arr, result):\n        n = len(arr)\n        i = n - 2\n        while i >= 0 and arr[i] <= arr[i + 1]:\n            i -= 1\n        if i < 0:\n            return result == arr\n        j = n - 1\n        while arr[j] >= arr[i] or (j > i + 1 and arr[j] == arr[j - 1]):\n            j -= 1\n        expected = arr[:]\n        expected[i], expected[j] = expected[j], expected[i]\n        return result == expected\n"
      }
    },
