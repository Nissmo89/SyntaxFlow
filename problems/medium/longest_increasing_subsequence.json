        "call": "Checker().check(nums, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def check(self, nums: List[int], result: Any) -> bool:\n        if not isinstance(result, int):\n            return False\n        if not isinstance(nums, list) or len(nums) < 1:\n            return False\n        if len(nums) > 2500:\n            return False\n        if any(not isinstance(x, int) or x < -10000 or x > 10000 for x in nums):\n            return False\n        return 1 <= result <= len(nums)\n"
      }
