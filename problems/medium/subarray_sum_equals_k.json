    "oracle": {
      "python3": {
        "call": "Checker().subarraySum(nums, k, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def subarraySum(self, nums: List[int], k: int, result: Any) -> bool:\n        if isinstance(result, bool) or not isinstance(result, int):\n            return False\n        seen = {0: 1}\n        total = 0\n        expected = 0\n        for num in nums:\n            total += num\n            expected += seen.get(total - k, 0)\n            seen[total] = seen.get(total, 0) + 1\n        return result == expected\n"
      }
    },
