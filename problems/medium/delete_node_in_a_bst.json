    "oracle": {
      "python3": {
        "call": "Checker().check(root, key, {result})",
        "checker": "class Checker:\n    def _array_to_tree(self, arr):\n        if arr is None or arr == []:\n            return None\n        if not isinstance(arr, list):\n            return arr\n        nodes = [None if v is None else {\"val\": v, \"left\": None, \"right\": None} for v in arr]\n        kids = nodes[::-1]\n        root = kids.pop()\n        for node in nodes:\n            if node is not None:\n                if kids:\n                    node[\"left\"] = kids.pop()\n                if kids:\n                    node[\"right\"] = kids.pop()\n        return root\n\n    def _left(self, node):\n        return node.get(\"left\") if isinstance(node, dict) else getattr(node, \"left\", None)\n\n    def _right(self, node):\n        return node.get(\"right\") if isinstance(node, dict) else getattr(node, \"right\", None)\n\n    def _val(self, node):\n        return node.get(\"val\") if isinstance(node, dict) else getattr(node, \"val\", None)\n\n    def _inorder(self, node, values):\n        if node is None:\n            return True\n        if not self._inorder(self._left(node), values):\n            return False\n        values.append(self._val(node))\n        if not self._inorder(self._right(node), values):\n            return False\n        return True\n\n    def _is_bst(self, node, lo, hi):\n        if node is None:\n            return True\n        val = self._val(node)\n        if val is None or val <= lo or val >= hi:\n            return False\n        return self._is_bst(self._left(node), lo, val) and self._is_bst(self._right(node), val, hi)\n\n    def check(self, root, key, result):\n        result = self._array_to_tree(result)\n        if result is None:\n            result_values = []\n            result_ok = True\n        else:\n            result_values = []\n            result_ok = self._is_bst(result, float('-inf'), float('inf'))\n            if not result_ok:\n                return False\n            if not self._inorder(result, result_values):\n                return False\n\n        original_values = []\n        if root is not None and not self._inorder(root, original_values):\n            return False\n\n        if key in original_values:\n            original_values.remove(key)\n\n        return result_values == original_values\n"
      }
    },
