    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().isValidSerialization(preorder, {result})",
        "checker": "class Checker:\n    def isValidSerialization(self, preorder, result):\n        slots = 1\n        for node in preorder.split(','):\n            slots -= 1\n            if slots < 0:\n                return result is False\n            if node != '#':\n                slots += 2\n        return result == (slots == 0)\n"
      }
    },
