      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().maxProfit(prices, {result})",
        "checker": "class Checker:\n    def maxProfit(self, prices, result):\n        if not isinstance(result, int):\n            return False\n        hold = float('-inf')\n        sold = 0\n        rest = 0\n        for price in prices:\n            prev_hold = hold\n            hold = max(hold, rest - price)\n            sold = prev_hold + price\n            rest = max(rest, prev_hold if prev_hold != float('-inf') else 0)\n        expected = max(sold, rest)\n        return result == expected\n"
      }
    },
