    "oracle": {
      "python3": {
        "call": "Checker().findDuplicate(paths, {result})",
        "checker": "from typing import Any\n\nclass Checker:\n    def findDuplicate(self, paths, result):\n        if not isinstance(result, list):\n            return False\n\n        expected = {}\n        for path in paths:\n            parts = path.split(\" \")\n            if not parts:\n                return False\n            directory = parts[0]\n            for file in parts[1:]:\n                if \"(\" not in file or not file.endswith(\")\"):\n                    return False\n                name, content = file.split(\"(\", 1)\n                content = content[:-1]\n                full_path = directory + \"/\" + name\n                expected.setdefault(content, []).append(full_path)\n\n        expected_groups = {\n            frozenset(group)\n            for group in expected.values()\n            if len(group) > 1\n        }\n\n        try:\n            actual_groups = []\n            seen_paths = set()\n            for group in result:\n                if not isinstance(group, list) or len(group) < 2:\n                    return False\n                normalized = []\n                for path in group:\n                    if not isinstance(path, str):\n                        return False\n                    if path in seen_paths:\n                        return False\n                    seen_paths.add(path)\n                    normalized.append(path)\n                actual_groups.append(frozenset(normalized))\n        except Exception:\n            return False\n\n        if len(actual_groups) != len(set(actual_groups)):\n            return False\n        return set(actual_groups) == expected_groups\n"
      }
    },
