      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(s, {result})",
        "checker": "class Checker:\n    def check(self, s, result):\n        if not isinstance(result, int):\n            return False\n        counts = [0] * 26\n        streak = 0\n        for i, ch in enumerate(s):\n            if i > 0 and (ord(ch) - ord(s[i - 1])) % 26 == 1:\n                streak += 1\n            else:\n                streak = 1\n            idx = ord(ch) - ord('a')\n            if streak > counts[idx]:\n                counts[idx] = streak\n        expected = sum(counts)\n        return result == expected\n"
      }
    },
