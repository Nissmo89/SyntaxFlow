    "oracle": {
      "python3": {
        "call": "Checker().check(l1, l2, {result})",
        "checker": "import json\n\nclass Checker:\n    def _norm(self, value):\n        if isinstance(value, str):\n            try:\n                value = json.loads(value)\n            except Exception:\n                pass\n        return value\n\n    def _to_int(self, digits):\n        n = 0\n        for d in digits:\n            n = n * 10 + d\n        return n\n\n    def _to_digits(self, n):\n        if n == 0:\n            return [0]\n        out = []\n        while n > 0:\n            out.append(n % 10)\n            n //= 10\n        return out[::-1]\n\n    def check(self, l1, l2, result):\n        result = self._norm(result)\n        if not isinstance(result, list):\n            return False\n        if any((not isinstance(x, int)) or x < 0 or x > 9 for x in result):\n            return False\n        if len(result) > 1 and result[0] == 0:\n            return False\n        return result == self._to_digits(self._to_int(l1) + self._to_int(l2))\n"
      }
    },
