    "oracle": {
      "python3": {
        "call": "Checker().canJump(nums, {result})",
        "checker": "class Checker:\n    def canJump(self, nums, result):\n        goal = 0\n        for i, n in enumerate(nums):\n            if i > goal:\n                return result is False\n            if i + n > goal:\n                goal = i + n\n            if goal >= len(nums) - 1:\n                return result is True\n        return result is False\n"
      }
    },
