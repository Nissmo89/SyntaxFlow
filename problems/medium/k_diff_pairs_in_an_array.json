    "oracle": {
      "python3": {
        "call": "Checker().check(nums, k, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def check(self, nums: List[int], k: int, result: Any) -> bool:\n        if not isinstance(result, int):\n            return False\n        if not isinstance(nums, list) or not (1 <= len(nums) <= 10000):\n            return False\n        if not isinstance(k, int) or not (0 <= k <= 10000000):\n            return False\n        counts = {}\n        for num in nums:\n            if not isinstance(num, int) or num < -10000000 or num > 10000000:\n                return False\n            counts[num] = counts.get(num, 0) + 1\n        expected = 0\n        if k == 0:\n            for count in counts.values():\n                if count >= 2:\n                    expected += 1\n        else:\n            for num in counts:\n                if num + k in counts:\n                    expected += 1\n        return result == expected\n"
      }
    },
