    "oracle": {
      "python3": {
        "call": "Checker().constructArray(n, k, {result})",
        "checker": "class Checker:\n    def constructArray(self, n, k, result):\n        if not isinstance(result, list):\n            return False\n        if len(result) != n:\n            return False\n        if sorted(result) != list(range(1, n + 1)):\n            return False\n        if n <= 1:\n            return False\n        diffs = set()\n        for i in range(1, n):\n            diffs.add(abs(result[i] - result[i - 1]))\n        return len(diffs) == k\n"
      }
    },
