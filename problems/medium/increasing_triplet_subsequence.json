    "oracle": {
      "python3": {
        "call": "Checker().increasingTriplet(nums, {result})",
        "checker": "class Checker:\n    def increasingTriplet(self, nums, result):\n        first = float('inf')\n        second = float('inf')\n        expected = False\n        for x in nums:\n            if x <= first:\n                first = x\n            elif x <= second:\n                second = x\n            else:\n                expected = True\n                break\n        return expected == result\n"
      }
    },
