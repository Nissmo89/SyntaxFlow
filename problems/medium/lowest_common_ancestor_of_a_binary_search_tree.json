    "oracle": {
      "python3": {
        "call": "Checker().lowestCommonAncestor(root, p, q, {result})",
        "checker": "from typing import Any\n\nclass Checker:\n    def lowestCommonAncestor(self, root, p, q, result: Any) -> bool:\n        if result is None or root is None or p is None or q is None:\n            return False\n        if isinstance(root, list):\n            root = self._build_tree(root)\n        lo = min(p, q)\n        hi = max(p, q)\n        node = root\n        while node is not None:\n            if hi < node.val:\n                node = node.left\n            elif lo > node.val:\n                node = node.right\n            else:\n                expected = self._serialize(node)\n                if isinstance(result, list):\n                    return result == expected\n                if isinstance(result, dict):\n                    return self._serialize(self._from_dict(result)) == expected\n                return hasattr(result, \"val\") and result.val == node.val\n        return False\n\n    def _build_tree(self, data):\n        if not data:\n            return None\n        nodes = []\n        for v in data:\n            nodes.append(None if v is None else TreeNode(v))\n        kids = nodes[::-1]\n        root = kids.pop()\n        for node in nodes:\n            if node is not None:\n                if kids:\n                    node.left = kids.pop()\n                if kids:\n                    node.right = kids.pop()\n        return root\n\n    def _serialize(self, node):\n        if node is None:\n            return []\n        out = []\n        queue = [node]\n        while queue:\n            cur = queue.pop(0)\n            if cur is None:\n                out.append(None)\n                continue\n            out.append(cur.val)\n            queue.append(cur.left)\n            queue.append(cur.right)\n        while out and out[-1] is None:\n            out.pop()\n        return out\n\n    def _from_dict(self, data):\n        if data is None:\n            return None\n        node = TreeNode(data[\"val\"])\n        node.left = self._from_dict(data.get(\"left\"))\n        node.right = self._from_dict(data.get(\"right\"))\n        return node\n"
      }
    },
