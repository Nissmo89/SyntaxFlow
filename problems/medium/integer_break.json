    "oracle": {
      "python3": {
        "call": "Checker().check(n, {result})",
        "checker": "class Checker:\n    def check(self, n, result):\n        if not isinstance(n, int):\n            return False\n        if not isinstance(result, int):\n            return False\n        if n < 2 or n > 58:\n            return False\n        if n == 2:\n            expected = 1\n        elif n == 3:\n            expected = 2\n        else:\n            threes = n // 3\n            remainder = n % 3\n            if remainder == 1:\n                threes -= 1\n                remainder = 4\n            elif remainder == 0:\n                remainder = 1\n            expected = (3 ** threes) * remainder\n        return result == expected\n"
      }
    },
