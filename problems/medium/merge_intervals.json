            }
          }
        }
      },
      "call": {
        "cpp": "Solution().merge({intervals})",
        "rust": "Solution::merge({intervals})",
        "python3": "Solution().merge({intervals})",
        "python2": "Solution().merge({intervals})",
        "ruby": "merge({intervals})",
        "java": "new Solution().merge({intervals})",
        "csharp": "new Solution().Merge({intervals})",
        "kotlin": "Solution().merge({intervals})",
        "go": "merge({intervals})",
        "dart": "Solution().merge({intervals})",
        "swift": "Solution().merge({intervals})",
        "typescript": "merge({intervals})"
      }
    },
    "judge": {
      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().merge(intervals, {result})",
        "checker": "class Checker:\n    def merge(self, intervals, result):\n        if not isinstance(result, list):\n            return False\n        if any(not isinstance(interval, list) or len(interval) != 2 for interval in result):\n            return False\n        if any(not isinstance(x, int) for interval in result for x in interval):\n            return False\n        for interval in result:\n            if interval[0] > interval[1]:\n                return False\n        if any(intervals[i][0] > intervals[i][1] for i in range(len(intervals))):\n            return False\n        sorted_intervals = sorted([list(interval) for interval in intervals])\n        merged = []\n        for start, end in sorted_intervals:\n            if not merged or start > merged[-1][1]:\n                merged.append([start, end])\n            else:\n                merged[-1][1] = max(merged[-1][1], end)\n        return result == merged\n"
      }
    },
