    "oracle": {
      "python3": {
        "call": "Checker().groupAnagrams(strs, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def groupAnagrams(self, strs, result):\n        if not isinstance(result, list):\n            return False\n\n        input_counts = Counter(strs)\n        output_counts = Counter()\n        groups = Counter()\n\n        for group in result:\n            if not isinstance(group, list) or len(group) == 0:\n                return False\n\n            for word in group:\n                if not isinstance(word, str):\n                    return False\n                output_counts[word] += 1\n\n            signature = \"\".join(sorted(group[0]))\n            for word in group[1:]:\n                if \"\".join(sorted(word)) != signature:\n                    return False\n\n            groups[tuple(sorted(group))] += 1\n\n        if output_counts != input_counts:\n            return False\n\n        expected_groups = Counter()\n        buckets = {}\n        for word in strs:\n            signature = \"\".join(sorted(word))\n            buckets.setdefault(signature, []).append(word)\n\n        for bucket in buckets.values():\n            expected_groups[tuple(sorted(bucket))] += 1\n\n        return groups == expected_groups\n"
      }
    },
