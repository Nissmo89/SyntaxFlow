    "oracle": {
      "python3": {
        "call": "Checker().reconstructQueue(people, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def reconstructQueue(self, people, result):\n        if not isinstance(result, list) or len(result) != len(people):\n            return False\n        try:\n            in_counts = Counter(tuple(p) for p in people)\n            out_counts = Counter(tuple(p) for p in result)\n        except TypeError:\n            return False\n        if in_counts != out_counts:\n            return False\n        for i, person in enumerate(result):\n            if not isinstance(person, list) or len(person) != 2:\n                return False\n            h, k = person\n            if not isinstance(h, int) or not isinstance(k, int):\n                return False\n            if k < 0 or k >= len(result):\n                return False\n            taller_or_equal = sum(1 for prev in result[:i] if prev[0] >= h)\n            if taller_or_equal != k:\n                return False\n        return True\n"
      }
    },
