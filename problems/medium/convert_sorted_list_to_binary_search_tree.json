    "judge": {
      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().sortedListToBST(head, {result})",
        "checker": "class Checker:\n    def sortedListToBST(self, head, result):\n        if head is None:\n            values = []\n        elif isinstance(head, list):\n            values = list(head)\n        else:\n            values = []\n            seen = 0\n            node = head\n            while node is not None:\n                if isinstance(node, dict):\n                    values.append(node.get(\"val\"))\n                    node = node.get(\"next\")\n                else:\n                    values.append(getattr(node, \"val\", None))\n                    node = getattr(node, \"next\", None)\n                seen += 1\n                if seen > 20000:\n                    return False\n        if not isinstance(result, list):\n            return False\n        if not result:\n            return values == []\n        if not result or result[0] is None:\n            return False\n\n        def validate(i):\n            if i >= len(result) or result[i] is None:\n                return 0, True, []\n            val = result[i]\n            if not isinstance(val, int):\n                return 0, False, []\n            left_h, left_ok, left_vals = validate(2 * i + 1)\n            if not left_ok:\n                return 0, False, []\n            right_h, right_ok, right_vals = validate(2 * i + 2)\n            if not right_ok or abs(left_h - right_h) > 1:\n                return 0, False, []\n            return max(left_h, right_h) + 1, True, left_vals + [val] + right_vals\n\n        _, ok, inorder = validate(0)\n        return ok and inorder == values\n"
      }
    },
