    "oracle": {
      "python3": {
        "call": "Checker().check(s, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def check(self, s, result):\n        if not isinstance(result, str):\n            return False\n\n        n = len(s)\n        counts = Counter(s)\n        possible = max(counts.values()) <= (n + 1) // 2\n\n        if result == \"\":\n            return not possible\n\n        if not possible:\n            return False\n\n        if len(result) != n:\n            return False\n\n        if Counter(result) != counts:\n            return False\n\n        for i in range(1, n):\n            if result[i] == result[i - 1]:\n                return False\n\n        return True\n"
      }
    },
