    "oracle": {
      "python3": {
        "call": "Checker().maxSubarraySumCircular(nums, {result})",
        "checker": "class Checker:\n    def maxSubarraySumCircular(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        total = nums[0]\n        max_sum = curr_max = nums[0]\n        min_sum = curr_min = nums[0]\n        for x in nums[1:]:\n            curr_max = max(curr_max + x, x)\n            max_sum = max(max_sum, curr_max)\n            curr_min = min(curr_min + x, x)\n            min_sum = min(min_sum, curr_min)\n            total += x\n        circular = total - min_sum\n        if circular == 0:\n            expected = max_sum\n        else:\n            expected = max(max_sum, circular)\n        return result == expected\n"
      }
    },
