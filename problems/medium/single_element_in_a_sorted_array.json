        "call": "Checker().check(nums, {result})",
        "checker": "class Checker:\n    def check(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        xor_value = 0\n        for value in nums:\n            xor_value ^= value\n        return result == xor_value\n"
      }
