    "oracle": {
      "python3": {
        "call": "Checker().maxProfit(prices, fee, {result})",
        "checker": "class Checker:\n    def maxProfit(self, prices, fee, result):\n        if not isinstance(result, int):\n            return False\n        if not isinstance(prices, list) or len(prices) < 1:\n            return False\n        if not isinstance(fee, int) or fee < 0:\n            return False\n        if any((not isinstance(p, int)) for p in prices):\n            return False\n        if any(p < 1 or p >= 50000 for p in prices):\n            return False\n        if fee >= 50000:\n            return False\n\n        hold = -prices[0]\n        cash = 0\n        for price in prices[1:]:\n            prev_cash = cash\n            cash = max(cash, hold + price - fee)\n            hold = max(hold, prev_cash - price)\n\n        return result == cash\n"
      }
    },
