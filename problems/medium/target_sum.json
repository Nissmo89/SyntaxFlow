    "oracle": {
      "python3": {
        "call": "Checker().findTargetSumWays(nums, target, {result})",
        "checker": "class Checker:\n    def findTargetSumWays(self, nums, target, result):\n        if not isinstance(result, int):\n            return False\n        total = sum(nums)\n        if abs(target) > total or (target + total) % 2 != 0:\n            return result == 0\n        subset = (target + total) // 2\n        dp = [0] * (subset + 1)\n        dp[0] = 1\n        for num in nums:\n            for j in range(subset, num - 1, -1):\n                dp[j] += dp[j - num]\n        return result == dp[subset]\n"
      }
    },
