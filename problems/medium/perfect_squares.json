        "call": "Checker().numSquares(n, {result})",
        "checker": "import math\n\nclass Checker:\n    def numSquares(self, n, result):\n        if not isinstance(n, int) or not isinstance(result, int):\n            return False\n        if n < 1 or n > 10000:\n            return False\n        if result < 1 or result > 4:\n            return False\n\n        x = n\n        while x % 4 == 0:\n            x //= 4\n        if x % 8 == 7:\n            expected = 4\n        else:\n            r = math.isqrt(n)\n            if r * r == n:\n                expected = 1\n            else:\n                is_two = False\n                for a in range(1, r + 1):\n                    b2 = n - a * a\n                    b = math.isqrt(b2)\n                    if b * b == b2:\n                        is_two = True\n                        break\n                expected = 2 if is_two else 3\n        return result == expected\n"
      }
    },
