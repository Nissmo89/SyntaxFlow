      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().rotateRight(head, k, {result})",
        "checker": "class Checker:\n    def rotateRight(self, head, k, result):\n        vals = list(head)\n        if not isinstance(result, list):\n            return False\n        n = len(vals)\n        if n == 0:\n            return result == []\n        shift = k % n\n        if shift == 0:\n            expected = vals\n        else:\n            expected = vals[-shift:] + vals[:-shift]\n        return result == expected\n"
      }
    },
