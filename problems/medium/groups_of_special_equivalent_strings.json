      "python3": {
        "call": "Checker().numSpecialEquivGroups(words, {result})",
        "checker": "class Checker:\n    def numSpecialEquivGroups(self, words, result):\n        seen = set()\n        for w in words:\n            seen.add((\"\".join(sorted(w[0::2])), \"\".join(sorted(w[1::2]))))\n        return len(seen) == result\n"
      }
    },
