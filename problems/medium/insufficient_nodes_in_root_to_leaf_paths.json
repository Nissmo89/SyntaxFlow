    "oracle": {
      "python3": {
        "call": "Checker().sufficientSubset(root, limit, {result})",
        "checker": "class Checker:\n    def sufficientSubset(self, root, limit, result):\n        def normalize(node):\n            if node is None:\n                return None\n            if isinstance(node, list):\n                if not node:\n                    return None\n                nodes = [None if x is None else TreeNode(x) for x in node]\n                kids = nodes[::-1]\n                root = kids.pop()\n                for item in nodes:\n                    if item is not None:\n                        if kids:\n                            item.left = kids.pop()\n                        if kids:\n                            item.right = kids.pop()\n                return root\n            if isinstance(node, dict):\n                return TreeNode(\n                    node.get(\"val\", node.get(\"value\")),\n                    normalize(node.get(\"left\")),\n                    normalize(node.get(\"right\")),\n                )\n            return node\n\n        def serialize(node):\n            if node is None:\n                return None\n            out = []\n            queue = [node]\n            while queue:\n                cur = queue.pop(0)\n                if cur is None:\n                    out.append(None)\n                else:\n                    out.append(cur.val)\n                    queue.append(cur.left)\n                    queue.append(cur.right)\n            while out and out[-1] is None:\n                out.pop()\n            return out\n\n        expected = normalize(root)\n        actual = normalize(result)\n\n        def dfs(node, path_sum):\n            if not node:\n                return False\n            curr = path_sum + node.val\n            if not node.left and not node.right:\n                return curr >= limit\n            left_good = dfs(node.left, curr)\n            right_good = dfs(node.right, curr)\n            if not left_good:\n                node.left = None\n            if not right_good:\n                node.right = None\n            return left_good or right_good\n\n        return serialize(expected if dfs(expected, 0) else None) == serialize(actual)\n"
      }
    },
