    "oracle": {
      "python3": {
        "call": "Checker().minMoves(nums, {result})",
        "checker": "class Checker:\n    def minMoves(self, nums, result) -> bool:\n        if not isinstance(nums, list):\n            return False\n        if not isinstance(result, int):\n            return False\n        if len(nums) == 0:\n            return False\n        expected = sum(nums) - len(nums) * min(nums)\n        return result == expected\n"
      }
    },
