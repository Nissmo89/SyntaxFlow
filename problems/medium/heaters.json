    "oracle": {
      "python3": {
        "call": "Checker().findRadius(houses, heaters, {result})",
        "checker": "class Checker:\n    def findRadius(self, houses, heaters, result):\n        if not isinstance(result, int):\n            return False\n        if not isinstance(houses, list) or not isinstance(heaters, list):\n            return False\n        if len(houses) < 1 or len(heaters) < 1:\n            return False\n        if len(houses) > 30000 or len(heaters) > 30000:\n            return False\n        for x in houses:\n            if not isinstance(x, int) or x < 1 or x > 1000000000:\n                return False\n        for x in heaters:\n            if not isinstance(x, int) or x < 1 or x > 1000000000:\n                return False\n        expected = 0\n        hs = sorted(houses)\n        ht = sorted(heaters)\n        for house in hs:\n            left = 0\n            right = len(ht) - 1\n            while left < right:\n                mid = (left + right) // 2\n                if ht[mid] < house:\n                    left = mid + 1\n                else:\n                    right = mid\n            dist = abs(ht[left] - house)\n            if left > 0:\n                alt = abs(ht[left - 1] - house)\n                if alt < dist:\n                    dist = alt\n            if dist > expected:\n                expected = dist\n        return result == expected\n"
      }
    },
