    "oracle": {
      "python3": {
        "call": "Checker().repeatedStringMatch(a, b, {result})",
        "checker": "class Checker:\n    def repeatedStringMatch(self, a, b, result):\n        if not isinstance(result, int):\n            return False\n        if result < -1:\n            return False\n        if len(a) == 0 or len(b) == 0:\n            return False\n        if any(c < 'a' or c > 'z' for c in a + b):\n            return False\n        repeat = a\n        count = 1\n        while len(repeat) < len(b) + len(a):\n            if b in repeat:\n                return result == count\n            repeat += a\n            count += 1\n        if b in repeat:\n            return result == count\n        return result == -1\n"
      }
    },
