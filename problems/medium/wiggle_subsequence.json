    "oracle": {
      "python3": {
        "call": "Checker().wiggleMaxLength(nums, {result})",
        "checker": "class Checker:\n    def wiggleMaxLength(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        if len(nums) < 2:\n            return result == len(nums)\n        up = 1\n        down = 1\n        for i in range(1, len(nums)):\n            if nums[i] > nums[i - 1]:\n                up = down + 1\n            elif nums[i] < nums[i - 1]:\n                down = up + 1\n        expected = up if up > down else down\n        return result == expected\n"
      }
    },
