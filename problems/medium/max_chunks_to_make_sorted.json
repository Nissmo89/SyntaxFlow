    "oracle": {
      "python3": {
        "call": "Checker().maxChunksToSorted(arr, {result})",
        "checker": "class Checker:\n    def maxChunksToSorted(self, arr, result):\n        if not isinstance(result, int):\n            return False\n\n        n = len(arr)\n        if sorted(arr) != list(range(n)):\n            return False\n\n        target = list(range(n))\n        best = 0\n        split_count = n - 1\n\n        for mask in range(1 << split_count):\n            merged = []\n            start = 0\n            chunks = 0\n\n            for idx in range(split_count):\n                if (mask >> idx) & 1:\n                    merged.extend(sorted(arr[start:idx + 1]))\n                    chunks += 1\n                    start = idx + 1\n\n            merged.extend(sorted(arr[start:]))\n            chunks += 1\n\n            if merged == target and chunks > best:\n                best = chunks\n\n        return result == best\n"
      }
    },
