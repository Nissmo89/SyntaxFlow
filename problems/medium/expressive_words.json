    "oracle": {
      "python3": {
        "call": "Checker().expressiveWords(s, words, {result})",
        "checker": "class Checker:\n    def expressiveWords(self, s, words, result):\n        def encode(x):\n            chars, cnts = [], []\n            prev = None\n            cnt = 0\n            for ch in x:\n                if ch == prev:\n                    cnt += 1\n                else:\n                    if prev is not None:\n                        chars.append(prev)\n                        cnts.append(cnt)\n                    prev = ch\n                    cnt = 1\n            chars.append(prev)\n            cnts.append(cnt)\n            return chars, cnts\n\n        s_chars, s_cnts = encode(s)\n        expected = 0\n        for w in words:\n            w_chars, w_cnts = encode(w)\n            if w_chars != s_chars:\n                continue\n            ok = True\n            for sc, wc in zip(s_cnts, w_cnts):\n                if sc < wc or (sc < 3 and sc != wc):\n                    ok = False\n                    break\n            if ok:\n                expected += 1\n        return expected == result\n"
      }
    },
