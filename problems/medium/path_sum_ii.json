    "oracle": {
      "python3": {
        "call": "Checker().pathSum(root, targetSum, {result})",
        "checker": "class Checker:\n    def pathSum(self, root, targetSum, result):\n        if not isinstance(result, list):\n            return False\n        for path in result:\n            if not isinstance(path, list) or not all(isinstance(v, int) for v in path):\n                return False\n        if root is None or root == []:\n            return result == []\n        if not isinstance(root, list):\n            return False\n\n        expected = []\n\n        def dfs(i, acc, path):\n            if i >= len(root) or root[i] is None:\n                return\n            val = root[i]\n            path.append(val)\n            acc += val\n            left = 2 * i + 1\n            right = 2 * i + 2\n            has_left = left < len(root) and root[left] is not None\n            has_right = right < len(root) and root[right] is not None\n            if not has_left and not has_right:\n                if acc == targetSum:\n                    expected.append(path[:])\n            else:\n                dfs(left, acc, path)\n                dfs(right, acc, path)\n            path.pop()\n\n        dfs(0, 0, [])\n        return sorted(result) == sorted(expected)\n"
      }
    },
