    "oracle": {
      "python3": {
        "call": "Checker().shoppingOffers(price, special, needs, {result})",
        "checker": "class Checker:\n    def shoppingOffers(self, price, special, needs, result):\n        from functools import lru_cache\n\n        p = len(price)\n\n        @lru_cache(None)\n        def dp(curr):\n            if all(x == 0 for x in curr):\n                return 0\n            best = sum(curr[i] * price[i] for i in range(p))\n            for offer in special:\n                if all(curr[i] >= offer[i] for i in range(p)):\n                    nxt = tuple(curr[i] - offer[i] for i in range(p))\n                    best = min(best, offer[-1] + dp(nxt))\n            return best\n\n        return result == dp(tuple(needs))\n"
      }
    },
