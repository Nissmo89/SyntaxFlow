    "oracle": {
      "python3": {
        "call": "Checker().findRightInterval(intervals, {result})",
        "checker": "from bisect import bisect_left\nfrom typing import Any, List\n\nclass Checker:\n    def findRightInterval(self, intervals: List[List[int]], result: Any) -> bool:\n        if not isinstance(result, list) or len(result) != len(intervals):\n            return False\n        starts = sorted((interval[0], i) for i, interval in enumerate(intervals))\n        sorted_starts = [s for s, _ in starts]\n        expected = []\n        for interval in intervals:\n            pos = bisect_left(sorted_starts, interval[1])\n            expected.append(-1 if pos == len(starts) else starts[pos][1])\n        return result == expected\n"
      }
    },
