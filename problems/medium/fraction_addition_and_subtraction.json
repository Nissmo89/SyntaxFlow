    "oracle": {
      "python3": {
        "call": "Checker().fractionAddition(expression, {result})",
        "checker": "class Checker:\n    def fractionAddition(self, expression, result):\n        def gcd(a, b):\n            while b:\n                a, b = b, a % b\n            return a\n\n        parts = []\n        i = 0\n        while i < len(expression):\n            sign = 1\n            if expression[i] in \"+-\":\n                sign = -1 if expression[i] == \"-\" else 1\n                i += 1\n            j = i\n            while expression[j] != \"/\":\n                j += 1\n            num = int(expression[i:j]) * sign\n            i = j + 1\n            j = i\n            while j < len(expression) and expression[j] not in \"+-\":\n                j += 1\n            den = int(expression[i:j])\n            parts.append((num, den))\n            i = j\n\n        common = 1\n        for _, den in parts:\n            common = common * den // gcd(common, den)\n\n        total = 0\n        for num, den in parts:\n            total += num * (common // den)\n\n        g = gcd(abs(total), common)\n        expected = str(total // g) + \"/\" + str(common // g)\n        return result == expected\n"
      }
    },
