    "oracle": {
      "python3": {
        "call": "Checker().sortArray(nums, {result})",
        "checker": "class Checker:\n    def sortArray(self, nums, result):\n        if not isinstance(result, list) or len(result) != len(nums):\n            return False\n        if any(result[i] > result[i + 1] for i in range(len(result) - 1)):\n            return False\n        counts = {}\n        for x in nums:\n            counts[x] = counts.get(x, 0) + 1\n        for x in result:\n            if x not in counts:\n                return False\n            counts[x] -= 1\n            if counts[x] < 0:\n                return False\n        return all(v == 0 for v in counts.values())\n"
      }
    },
