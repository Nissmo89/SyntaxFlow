    "oracle": {
      "python3": {
        "call": "Checker().twoCitySchedCost(costs, {result})",
        "checker": "class Checker:\n    def twoCitySchedCost(self, costs, result):\n        n = len(costs) // 2\n        best = 10 ** 18\n        from itertools import combinations\n        for choose in combinations(range(len(costs)), n):\n            choose = set(choose)\n            total = 0\n            for i, (a, b) in enumerate(costs):\n                total += a if i in choose else b\n            if total < best:\n                best = total\n        return result == best\n"
      }
    },
