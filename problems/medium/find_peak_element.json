    "oracle": {
      "python3": {
        "call": "Checker().findPeakElement(nums, {result})",
        "checker": "class Checker:\n    def findPeakElement(self, nums, result):\n        if not isinstance(nums, list) or not nums:\n            return False\n        if not isinstance(result, int):\n            return False\n        if result < 0 or result >= len(nums):\n            return False\n        if any((not isinstance(x, int)) for x in nums):\n            return False\n        left_ok = result == 0 or nums[result] > nums[result - 1]\n        right_ok = result == len(nums) - 1 or nums[result] > nums[result + 1]\n        return left_ok and right_ok\n"
      }
    }
