    "oracle": {
      "python3": {
        "call": "Checker().maxAncestorDiff(root, {result})",
        "checker": "class Checker:\n    def maxAncestorDiff(self, root, result):\n        best = 0\n        def dfs(node, mn, mx):\n            nonlocal best\n            if not node:\n                return\n            mn = min(mn, node.val)\n            mx = max(mx, node.val)\n            best = max(best, mx - mn)\n            dfs(node.left, mn, mx)\n            dfs(node.right, mn, mx)\n        if root:\n            dfs(root, root.val, root.val)\n        return result == best\n"
      }
    },
