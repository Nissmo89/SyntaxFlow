{
  "id": "binary_tree_level_order_traversal_ii",
  "title": "Binary Tree Level Order Traversal II",
  "difficulty": "Medium",
  "category": "Algorithms",
  "tags": [
    "Tree",
    "Breadth-First Search",
    "Binary Tree"
  ],
  "description": "<p>Given the <code>root</code> of a binary tree, return <em>the bottom-up level order traversal of its nodes&#39; values</em>. (i.e., from left to right, level by level from leaf to root).</p>\n\n<p>&nbsp;</p>\n<p><strong class=\"example\">Example 1:</strong></p>\n<img alt=\"\" src=\"https://assets.leetcode.com/uploads/2021/02/19/tree1.jpg\" style=\"width: 277px; height: 302px;\" />\n<pre>\n<strong>Input:</strong> root = [3,9,20,null,null,15,7]\n<strong>Output:</strong> [[15,7],[9,20],[3]]\n</pre>\n\n<p><strong class=\"example\">Example 2:</strong></p>\n\n<pre>\n<strong>Input:</strong> root = [1]\n<strong>Output:</strong> [[1]]\n</pre>\n\n<p><strong class=\"example\">Example 3:</strong></p>\n\n<pre>\n<strong>Input:</strong> root = []\n<strong>Output:</strong> []\n</pre>\n\n<p>&nbsp;</p>\n<p><strong>Constraints:</strong></p>\n\n<ul>\n\t<li>The number of nodes in the tree is in the range <code>[0, 2000]</code>.</li>\n\t<li><code>-1000 &lt;= Node.val &lt;= 1000</code></li>\n</ul>\n",
  "task": "Solve the 'Binary Tree Level Order Traversal II' problem on LeetCode.",
  "inputFormat": "Passed directly as parameters.",
  "outputFormat": "Returned value from the solution method.",
  "constraints": [
    "The number of nodes in the tree is in the range [0, 2000].",
    "-1000 <= Node.val <= 1000"
  ],
  "hints": [],
  "method": {
    "name": "levelOrderBottom",
    "returnType": "auto",
    "params": [
      {
        "name": "root",
        "type": "tree_node"
      }
    ]
  },
  "manifest": {
    "entry": {
      "id": 107,
      "title": "binary-tree-level-order-traversal-ii",
      "params": {
        "root": {
          "type": "tree_node"
        }
      },
      "call": {
        "cpp": "Solution().levelOrderBottom({root})",
        "rust": "Solution::level_order_bottom({root})",
        "python3": "Solution().levelOrderBottom({root})",
        "python2": "Solution().levelOrderBottom({root})",
        "ruby": "level_order_bottom({root})",
        "java": "new Solution().levelOrderBottom({root})",
        "csharp": "new Solution().LevelOrderBottom({root})",
        "kotlin": "Solution().levelOrderBottom({root})",
        "go": "levelOrderBottom({root})",
        "dart": "Solution().levelOrderBottom({root})",
        "swift": "Solution().levelOrderBottom({root})",
        "typescript": "levelOrderBottom({root})"
      }
    },
    "judge": {
      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().levelOrderBottom(root, {result})",
        "checker": "from collections import deque\n\nclass Checker:\n    def levelOrderBottom(self, root, result) -> bool:\n        if root is None:\n            return result == []\n\n        expected = deque()\n        queue = deque([root])\n        while queue:\n            level = []\n            for _ in range(len(queue)):\n                node = queue.popleft()\n                level.append(node.val)\n                if node.left is not None:\n                    queue.append(node.left)\n                if node.right is not None:\n                    queue.append(node.right)\n            expected.appendleft(level)\n        return result == list(expected)\n"
      }
    },
