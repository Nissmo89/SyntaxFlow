    "oracle": {
      "python3": {
        "call": "Checker().kSmallestPairs(nums1, nums2, k, {result})",
        "checker": "import heapq\nfrom typing import Any, List\n\nclass Checker:\n    def kSmallestPairs(self, nums1: List[int], nums2: List[int], k: int, result: Any) -> bool:\n        if not isinstance(nums1, list) or not isinstance(nums2, list) or not isinstance(k, int):\n            return False\n        if k < 1 or len(nums1) < 1 or len(nums2) < 1:\n            return False\n        if len(nums1) > 100000 or len(nums2) > 100000 or k > 10000:\n            return False\n        if any(not isinstance(x, int) for x in nums1) or any(not isinstance(x, int) for x in nums2):\n            return False\n        if any(nums1[i] > nums1[i + 1] for i in range(len(nums1) - 1)):\n            return False\n        if any(nums2[i] > nums2[i + 1] for i in range(len(nums2) - 1)):\n            return False\n        if k > len(nums1) * len(nums2):\n            return False\n        if not isinstance(result, list):\n            return False\n        if any(not isinstance(p, list) or len(p) != 2 or any(not isinstance(x, int) for x in p) for p in result):\n            return False\n\n        expected = []\n        heap = []\n        visited = set()\n        heapq.heappush(heap, (nums1[0] + nums2[0], 0, 0))\n        visited.add((0, 0))\n        while heap and len(expected) < k:\n            _, i, j = heapq.heappop(heap)\n            expected.append([nums1[i], nums2[j]])\n            if j + 1 < len(nums2) and (i, j + 1) not in visited:\n                visited.add((i, j + 1))\n                heapq.heappush(heap, (nums1[i] + nums2[j + 1], i, j + 1))\n            if i + 1 < len(nums1) and (i + 1, j) not in visited:\n                visited.add((i + 1, j))\n                heapq.heappush(heap, (nums1[i + 1] + nums2[j], i + 1, j))\n        return result == expected\n"
      }
    },
