        "checker": "class Checker:\n    def fourSumCount(self, nums1, nums2, nums3, nums4, result):\n        if not isinstance(result, int):\n            return False\n        expected = 0\n        for a in nums1:\n            for b in nums2:\n                for c in nums3:\n                    for d in nums4:\n                        if a + b + c + d == 0:\n                            expected += 1\n        return result == expected\n"
      }
