    "oracle": {
      "python3": {
        "call": "Checker().maxUncrossedLines(nums1, nums2, {result})",
        "checker": "class Checker:\n    def maxUncrossedLines(self, nums1, nums2, result):\n        m = len(nums1)\n        n = len(nums2)\n        dp = [[0] * (n + 1) for _ in range(m + 1)]\n        for i in range(1, m + 1):\n            a = nums1[i - 1]\n            for j in range(1, n + 1):\n                if a == nums2[j - 1]:\n                    dp[i][j] = dp[i - 1][j - 1] + 1\n                else:\n                    dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])\n        return dp[m][n] == result\n"
      }
    },
