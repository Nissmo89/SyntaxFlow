      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(s, {result})",
        "checker": "from typing import Any\n\nclass Checker:\n    def check(self, s: str, result: Any) -> bool:\n        if not isinstance(result, str):\n            return False\n        if any(not ('a' <= ch <= 'z') for ch in s):\n            return False\n        if any(not ('a' <= ch <= 'z') for ch in result):\n            return False\n\n        seen = set()\n        for ch in result:\n            if ch in seen:\n                return False\n            seen.add(ch)\n\n        idx = 0\n        for ch in s:\n            if idx < len(result) and ch == result[idx]:\n                idx += 1\n        if idx != len(result):\n            return False\n\n        last = {}\n        for i, ch in enumerate(s):\n            last[ch] = i\n        stack = []\n        in_stack = set()\n        for i, ch in enumerate(s):\n            if ch in in_stack:\n                continue\n            while stack and ch < stack[-1] and i < last[stack[-1]]:\n                in_stack.remove(stack.pop())\n            stack.append(ch)\n            in_stack.add(ch)\n        return ''.join(stack) == result\n"
      }
    },
