    "oracle": {
      "python3": {
        "call": "Checker().decodeString(s, {result})",
        "checker": "class Checker:\n    def decodeString(self, s, result):\n        i = 0\n\n        def decode():\n            nonlocal i\n            res = []\n            num = 0\n            while i < len(s):\n                c = s[i]\n                if c.isdigit():\n                    num = num * 10 + int(c)\n                    i += 1\n                elif c == '[':\n                    i += 1\n                    inner = decode()\n                    res.append(inner * num)\n                    num = 0\n                elif c == ']':\n                    i += 1\n                    return ''.join(res)\n                else:\n                    res.append(c)\n                    i += 1\n            return ''.join(res)\n\n        expected = decode()\n        return expected == result\n"
      }
    },
