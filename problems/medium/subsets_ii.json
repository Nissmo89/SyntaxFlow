      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().subsetsWithDup(nums, {result})",
        "checker": "class Checker:\n    def subsetsWithDup(self, nums, result):\n        nums = sorted(nums)\n        expected = []\n        def bt(i, cur):\n            expected.append(tuple(cur))\n            for j in range(i, len(nums)):\n                if j > i and nums[j] == nums[j - 1]:\n                    continue\n                cur.append(nums[j]); bt(j + 1, cur); cur.pop()\n        bt(0, [])\n        got = [tuple(x) for x in result] if isinstance(result, list) else None\n        return got is not None and sorted(got) == sorted(expected)\n"
      }
    },
