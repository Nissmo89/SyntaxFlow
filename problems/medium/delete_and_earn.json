    "oracle": {
      "python3": {
        "call": "Checker().deleteAndEarn(nums, {result})",
        "checker": "class Checker:\n    def deleteAndEarn(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        if not isinstance(nums, list):\n            return False\n        if len(nums) < 1 or len(nums) > 20000:\n            return False\n        if any((not isinstance(x, int)) for x in nums):\n            return False\n        if any(x < 1 or x > 10000 for x in nums):\n            return False\n\n        points = [0] * (max(nums) + 1)\n        for num in nums:\n            points[num] += num\n\n        take = 0\n        skip = 0\n        for value in points:\n            new_take = skip + value\n            new_skip = max(skip, take)\n            take = new_take\n            skip = new_skip\n\n        return result == max(take, skip)\n"
      }
    },
