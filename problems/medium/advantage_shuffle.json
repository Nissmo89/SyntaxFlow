      "memory_mb": 300
    },
    "oracle": {
      "python3": {
        "call": "Checker().advantageCount(nums1, nums2, {result})",
        "checker": "from collections import Counter\nfrom typing import Any\n\nclass Checker:\n    def advantageCount(self, nums1: list[int], nums2: list[int], result: Any) -> bool:\n        if not isinstance(result, list) or len(result) != len(nums1):\n            return False\n        if Counter(result) != Counter(nums1):\n            return False\n        actual = sum(1 for a, b in zip(result, nums2) if a > b)\n        a = sorted(nums1)\n        b = sorted(nums2)\n        i = j = wins = 0\n        n = len(a)\n        while i < n and j < n:\n            if a[i] > b[j]:\n                wins += 1\n                i += 1\n                j += 1\n            else:\n                i += 1\n        return actual == wins\n"
      }
    },
