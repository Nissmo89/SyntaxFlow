    "oracle": {
      "python3": {
        "call": "Checker().check(graph, {result})",
        "checker": "class Checker:\n    def check(self, graph, result):\n        n = len(graph)\n        state = [0] * n\n\n        def dfs(node):\n            if state[node] != 0:\n                return state[node] == 2\n            state[node] = 1\n            for nxt in graph[node]:\n                if state[nxt] == 1 or not dfs(nxt):\n                    return False\n            state[node] = 2\n            return True\n\n        expected = [i for i in range(n) if dfs(i)]\n        return result == expected\n"
      }
    },
