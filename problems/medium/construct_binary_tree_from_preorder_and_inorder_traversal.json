    "oracle": {
      "python3": {
        "call": "Checker().buildTree(preorder, inorder, {result})",
        "checker": "from typing import List, Optional, Any\n\nclass Checker:\n    def buildTree(self, preorder: List[int], inorder: List[int], result: Any) -> bool:\n        if len(preorder) != len(inorder):\n            return False\n\n        def serialize(node):\n            out = []\n            queue = [node]\n            while queue:\n                cur = queue.pop(0)\n                if cur is None:\n                    out.append(None)\n                    continue\n                out.append(cur.val)\n                queue.append(cur.left)\n                queue.append(cur.right)\n            while out and out[-1] is None:\n                out.pop()\n            return out\n\n        def preorder_walk(node):\n            if node is None:\n                return []\n            return [node.val] + preorder_walk(node.left) + preorder_walk(node.right)\n\n        def inorder_walk(node):\n            if node is None:\n                return []\n            return inorder_walk(node.left) + [node.val] + inorder_walk(node.right)\n\n        return serialize(result) == result_to_array(result) and preorder_walk(result) == preorder and inorder_walk(result) == inorder\n\ndef result_to_array(node):\n    if node is None:\n        return []\n    out = []\n    queue = [node]\n    while queue:\n        cur = queue.pop(0)\n        if cur is None:\n            out.append(None)\n            continue\n        out.append(cur.val)\n        queue.append(cur.left)\n        queue.append(cur.right)\n    while out and out[-1] is None:\n        out.pop()\n    return out\n"
      }
    },
