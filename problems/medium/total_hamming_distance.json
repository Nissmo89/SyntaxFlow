    "oracle": {
      "python3": {
        "call": "Checker().check(nums, {result})",
        "checker": "class Checker:\n    def check(self, nums, result):\n        if not isinstance(nums, list) or not isinstance(result, int):\n            return False\n        if len(nums) < 1:\n            return False\n        for x in nums:\n            if not isinstance(x, int) or x < 0 or x > 10**9:\n                return False\n        expected = 0\n        n = len(nums)\n        for bit in range(32):\n            ones = 0\n            for x in nums:\n                ones += (x >> bit) & 1\n            expected += ones * (n - ones)\n        return result == expected\n"
      }
    },
