    "oracle": {
      "python3": {
        "call": "Checker().check(nums, k, {result})",
        "checker": "class Checker:\n    def check(self, nums, k, result):\n        n = len(nums)\n        pref = [0.0]\n        for x in nums:\n            pref.append(pref[-1] + x)\n        dp = [[0.0] * (k + 1) for _ in range(n + 1)]\n        for i in range(1, n + 1):\n            dp[i][1] = pref[i] / i\n        for p in range(2, k + 1):\n            for i in range(p, n + 1):\n                best = 0.0\n                for j in range(p - 1, i):\n                    cand = dp[j][p - 1] + (pref[i] - pref[j]) / (i - j)\n                    if cand > best:\n                        best = cand\n                dp[i][p] = best\n        return abs(dp[n][k] - result) <= 1e-6\n"
      }
    },
