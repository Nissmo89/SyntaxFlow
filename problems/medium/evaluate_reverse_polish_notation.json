    "oracle": {
      "python3": {
        "call": "Checker().evalRPN(tokens, {result})",
        "checker": "class Checker:\n    def evalRPN(self, tokens, result):\n        if not isinstance(result, int):\n            return False\n        stack = []\n        for token in tokens:\n            if token in {\"+\", \"-\", \"*\", \"/\"}:\n                if len(stack) < 2:\n                    return False\n                a = stack.pop()\n                b = stack.pop()\n                if token == \"+\":\n                    stack.append(b + a)\n                elif token == \"-\":\n                    stack.append(b - a)\n                elif token == \"*\":\n                    stack.append(b * a)\n                else:\n                    stack.append(int(b / a))\n            else:\n                try:\n                    stack.append(int(token))\n                except Exception:\n                    return False\n        return len(stack) == 1 and stack[0] == result\n"
      }
    },
