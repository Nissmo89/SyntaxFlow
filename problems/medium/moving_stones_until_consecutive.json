        "checker": "class Checker:\n    def check(self, a, b, c, result):\n        if not isinstance(result, list) or len(result) != 2:\n            return False\n        x, y, z = sorted([a, b, c])\n        exp = [0 if z - x == 2 else (1 if y - x <= 2 or z - y <= 2 else 2), z - x - 2]\n        return result == exp\n"
      }
