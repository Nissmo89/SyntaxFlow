    "oracle": {
      "python3": {
        "call": "Checker().isNStraightHand(hand, groupSize, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def isNStraightHand(self, hand, groupSize, result):\n        if not isinstance(result, bool):\n            return False\n        if groupSize <= 0 or len(hand) % groupSize != 0:\n            return result is False\n        cnt = Counter(hand)\n        keys = sorted(cnt)\n        possible = True\n        for x in keys:\n            while cnt[x] > 0:\n                for y in range(x, x + groupSize):\n                    if cnt[y] <= 0:\n                        possible = False\n                        break\n                    cnt[y] -= 1\n                if not possible:\n                    break\n            if not possible:\n                break\n        return result == possible\n"
      }
    },
