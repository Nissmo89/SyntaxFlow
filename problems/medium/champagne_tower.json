    "oracle": {
      "python3": {
        "call": "Checker().check(poured, query_row, query_glass, {result})",
        "checker": "class Checker:\n    def check(self, poured, query_row, query_glass, result):\n        tower = [[0.0] * 102 for _ in range(102)]\n        tower[0][0] = float(poured)\n        for r in range(query_row + 1):\n            for c in range(r + 1):\n                if tower[r][c] > 1.0:\n                    excess = (tower[r][c] - 1.0) / 2.0\n                    tower[r][c] = 1.0\n                    tower[r + 1][c] += excess\n                    tower[r + 1][c + 1] += excess\n        expected = tower[query_row][query_glass]\n        return abs(float(result) - expected) <= 1e-9\n"
      }
    },
