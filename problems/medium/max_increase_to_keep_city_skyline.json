    "oracle": {
      "python3": {
        "call": "Checker().maxIncreaseKeepingSkyline(grid, {result})",
        "checker": "class Checker:\n    def maxIncreaseKeepingSkyline(self, grid, result):\n        n = len(grid)\n        row_max = [max(row) for row in grid]\n        col_max = [max(grid[r][c] for r in range(n)) for c in range(n)]\n        expected = 0\n        for r in range(n):\n            for c in range(n):\n                expected += min(row_max[r], col_max[c]) - grid[r][c]\n        return result == expected\n"
      }
    },
