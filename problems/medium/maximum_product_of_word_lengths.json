    "oracle": {
      "python3": {
        "call": "Checker().check(words, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def check(self, words: Any, result: Any) -> bool:\n        if not isinstance(words, list) or not isinstance(result, int):\n            return False\n        if len(words) < 2:\n            return False\n        bitmasks = []\n        for w in words:\n            if not isinstance(w, str):\n                return False\n            if not (1 <= len(w) <= 1000):\n                return False\n            mask = 0\n            seen = set()\n            for ch in w:\n                if not isinstance(ch, str) or len(ch) != 1 or not ('a' <= ch <= 'z'):\n                    return False\n                if ch not in seen:\n                    seen.add(ch)\n                    mask |= 1 << (ord(ch) - ord('a'))\n            bitmasks.append(mask)\n        expected = 0\n        for i in range(len(words)):\n            for j in range(i + 1, len(words)):\n                if bitmasks[i] & bitmasks[j] == 0:\n                    expected = max(expected, len(words[i]) * len(words[j]))\n        return result == expected\n"
      }
    },
