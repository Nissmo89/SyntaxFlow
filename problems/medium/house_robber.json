    "oracle": {
      "python3": {
        "call": "Checker().check(nums, {result})",
        "checker": "class Checker:\n    def check(self, nums, result):\n        prev = 0\n        curr = 0\n        for num in nums:\n            prev, curr = curr, max(curr, prev + num)\n        return result == curr\n"
      }
