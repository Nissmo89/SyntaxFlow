      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().maxSubArray(nums, {result})",
        "checker": "class Checker:\n    def maxSubArray(self, nums, result):\n        best = nums[0]\n        cur = 0\n        for n in nums:\n            if cur < 0:\n                cur = 0\n            cur += n\n            if cur > best:\n                best = cur\n        return result == best\n"
      }
    },
