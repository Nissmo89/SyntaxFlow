    "oracle": {
      "python3": {
        "call": "Checker().findMaxLength(nums, {result})",
        "checker": "class Checker:\n    def findMaxLength(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        count = 0\n        first = {0: -1}\n        best = 0\n        for i, x in enumerate(nums):\n            count += 1 if x == 1 else -1\n            if count in first:\n                best = max(best, i - first[count])\n            else:\n                first[count] = i\n        return result == best\n"
      }
    },
