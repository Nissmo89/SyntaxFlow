    "oracle": {
      "python3": {
        "call": "Checker().lastStoneWeightII(stones, {result})",
        "checker": "class Checker:\n    def lastStoneWeightII(self, stones, result) -> bool:\n        total = sum(stones)\n        target = total // 2\n        dp = [0] * (target + 1)\n        for s in stones:\n            for i in range(target, s - 1, -1):\n                cand = dp[i - s] + s\n                if cand > dp[i]:\n                    dp[i] = cand\n        expected = total - 2 * dp[target]\n        return result == expected\n"
      }
    },
