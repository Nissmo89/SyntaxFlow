    "oracle": {
      "python3": {
        "call": "Checker().knightProbability(n, k, row, column, {result})",
        "checker": "import math\nfrom functools import lru_cache\n\nclass Checker:\n    def knightProbability(self, n, k, row, column, result):\n        if not isinstance(result, (int, float)):\n            return False\n        if not math.isfinite(result):\n            return False\n        if result < -1e-12 or result > 1.0 + 1e-12:\n            return False\n\n        moves = ((1, 2), (2, 1), (-1, 2), (-2, 1), (1, -2), (2, -1), (-1, -2), (-2, -1))\n\n        @lru_cache(None)\n        def dp(steps, r, c):\n            if r < 0 or r >= n or c < 0 or c >= n:\n                return 0.0\n            if steps == 0:\n                return 1.0\n            total = 0.0\n            for dr, dc in moves:\n                total += dp(steps - 1, r + dr, c + dc)\n            return total / 8.0\n\n        expected = dp(k, row, column)\n        return abs(float(result) - expected) <= 1e-9 + 1e-12 * max(1.0, abs(expected))\n"
      }
    },
