        "csharp": "ListNode.ListNodeToArray(new Solution().AddTwoNumbers({l1}, {l2}))",
        "kotlin": "listNodeToArray(Solution().addTwoNumbers({l1}, {l2}))",
        "go": "listNodeToArray(addTwoNumbers({l1}, {l2}))",
