      "time_ms": 200,
      "memory_mb": 300
    },
    "oracle": {
      "python3": {
        "call": "Checker().addTwoNumbers(l1, l2, {result})",
        "checker": "class Checker:\n    def addTwoNumbers(self, l1, l2, result) -> bool:\n        def to_digits(node):\n            digits = []\n            seen = 0\n            while node is not None:\n                if not hasattr(node, 'val') or not hasattr(node, 'next'):\n                    return None\n                val = node.val\n                if not isinstance(val, int) or val < 0 or val > 9:\n                    return None\n                digits.append(val)\n                node = node.next\n                seen += 1\n                if seen > 200:\n                    return None\n            return digits\n\n        a = to_digits(l1)\n        b = to_digits(l2)\n        r = to_digits(result)\n        if a is None or b is None or r is None:\n            return False\n\n        i = 0\n        carry = 0\n        expected = []\n        while i < len(a) or i < len(b) or carry:\n            x = a[i] if i < len(a) else 0\n            y = b[i] if i < len(b) else 0\n            total = x + y + carry\n            expected.append(total % 10)\n            carry = total // 10\n            i += 1\n        return r == expected\n"
      }
    },
