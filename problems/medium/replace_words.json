      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().replaceWords(dictionary, sentence, {result})",
        "checker": "class Checker:\n    def _replace(self, dictionary, sentence):\n        trie = {}\n        end = \"*\"\n        for word in dictionary:\n            node = trie\n            for ch in word:\n                if ch not in node:\n                    node[ch] = {}\n                node = node[ch]\n            node[end] = True\n        out = []\n        for word in sentence.split(\" \"):\n            node = trie\n            rep = word\n            for i, ch in enumerate(word):\n                if end in node:\n                    rep = word[:i]\n                    break\n                if ch not in node:\n                    break\n                node = node[ch]\n            else:\n                if end in node:\n                    rep = word\n            out.append(rep)\n        return \" \".join(out)\n\n    def replaceWords(self, dictionary, sentence, result):\n        return self._replace(dictionary, sentence) == result\n"
      }
    },
