    "oracle": {
      "python3": {
        "call": "Checker().check(coins, amount, {result})",
        "checker": "class Checker:\n    def check(self, coins, amount, result):\n        if not isinstance(result, int):\n            return False\n\n        dp = [amount + 1] * (amount + 1)\n        dp[0] = 0\n\n        for i in range(1, amount + 1):\n            for coin in coins:\n                if i - coin >= 0:\n                    dp[i] = min(dp[i], 1 + dp[i - coin])\n\n        expected = dp[amount] if dp[amount] != amount + 1 else -1\n        return result == expected\n"
      }
    },
