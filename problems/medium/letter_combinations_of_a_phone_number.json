      "memory_mb": 300
    },
    "oracle": {
      "python3": {
        "call": "Checker().letterCombinations(digits, {result})",
        "checker": "from itertools import product\n\nclass Checker:\n    def letterCombinations(self, digits, result):\n        if not isinstance(result, list):\n            return False\n        mapping = {\n            \"2\": \"abc\",\n            \"3\": \"def\",\n            \"4\": \"ghi\",\n            \"5\": \"jkl\",\n            \"6\": \"mno\",\n            \"7\": \"pqrs\",\n            \"8\": \"tuv\",\n            \"9\": \"wxyz\",\n        }\n        if not isinstance(digits, str) or not digits:\n            return False\n        try:\n            groups = [mapping[d] for d in digits]\n        except KeyError:\n            return False\n        expected = {\"\".join(chars) for chars in product(*groups)}\n        if len(result) != len(expected):\n            return False\n        if any(not isinstance(item, str) for item in result):\n            return False\n        if len(set(result)) != len(result):\n            return False\n        if set(result) != expected:\n            return False\n        return all(len(item) == len(digits) for item in result)\n"
      }
    },
