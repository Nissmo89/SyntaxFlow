    "oracle": {
      "python3": {
        "call": "Checker().permuteUnique(nums, {result})",
        "checker": "from collections import Counter\nfrom math import factorial\n\nclass Checker:\n    def permuteUnique(self, nums, result):\n        if not isinstance(result, list):\n            return False\n\n        n = len(nums)\n        counts = Counter(nums)\n        expected = factorial(n)\n        for c in counts.values():\n            expected //= factorial(c)\n\n        seen = set()\n        for perm in result:\n            if not isinstance(perm, list):\n                return False\n            if len(perm) != n:\n                return False\n            if Counter(perm) != counts:\n                return False\n            seen.add(tuple(perm))\n\n        return len(seen) == expected and len(result) == expected\n"
      }
    },
