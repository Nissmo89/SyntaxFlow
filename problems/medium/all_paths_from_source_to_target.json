    "oracle": {
      "python3": {
        "call": "Checker().check(graph, {result})",
        "checker": "class Checker:\n    def check(self, graph, result):\n        target = len(graph) - 1\n        expected = []\n\n        def dfs(node, path):\n            if node == target:\n                expected.append(tuple(path))\n                return\n            for nxt in graph[node]:\n                dfs(nxt, path + [nxt])\n\n        dfs(0, [0])\n\n        try:\n            got = [tuple(path) for path in result]\n        except TypeError:\n            return False\n\n        if len(got) != len(expected):\n            return False\n        if len(set(got)) != len(got):\n            return False\n        if set(got) != set(expected):\n            return False\n        for path in got:\n            if not path or path[0] != 0 or path[-1] != target:\n                return False\n            for a, b in zip(path, path[1:]):\n                if b not in graph[a]:\n                    return False\n        return True\n"
      }
    },
