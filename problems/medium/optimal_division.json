        "call": "Checker().check(nums, {result})",
        "checker": "import json\n\nclass Checker:\n    def check(self, nums, result):\n        if not isinstance(result, str):\n            return False\n        try:\n            decoded = json.loads(result)\n            if isinstance(decoded, str):\n                result = decoded\n        except Exception:\n            pass\n        if len(nums) == 1:\n            expected = str(nums[0])\n        elif len(nums) == 2:\n            expected = str(nums[0]) + \"/\" + str(nums[1])\n        else:\n            expected = str(nums[0]) + \"/(\" + \"/\".join(str(value) for value in nums[1:]) + \")\"\n        return result == expected\n"
      }
