    "oracle": {
      "python3": {
        "call": "Checker().arrayNesting(nums, {result})",
        "checker": "class Checker:\n    def arrayNesting(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        seen = [False] * len(nums)\n        best = 0\n        for i in range(len(nums)):\n            if seen[i]:\n                continue\n            cur = i\n            count = 0\n            while not seen[cur]:\n                seen[cur] = True\n                cur = nums[cur]\n                count += 1\n            if count > best:\n                best = count\n        return result == best\n"
      }
    },
