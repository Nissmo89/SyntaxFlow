    "oracle": {
      "python3": {
        "call": "Checker().frequencySort(s, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def frequencySort(self, s, result):\n        if not isinstance(result, str):\n            return False\n        if len(result) != len(s):\n            return False\n        if Counter(result) != Counter(s):\n            return False\n        if not result:\n            return False\n        counts = Counter(result)\n        i = 0\n        prev = None\n        while i < len(result):\n            ch = result[i]\n            freq = counts[ch]\n            if prev is not None and freq > prev:\n                return False\n            j = i\n            while j < len(result) and result[j] == ch:\n                j += 1\n            if j - i != freq:\n                return False\n            prev = freq\n            i = j\n        return True\n"
      }
    },
