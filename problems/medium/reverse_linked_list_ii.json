    },
    "limits": {
      "time_ms": 200,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().reverseBetween(head, left, right, {result})",
        "checker": "class Checker:\n    def reverseBetween(self, head, left, right, result):\n        arr = list(head)\n        arr[left - 1:right] = reversed(arr[left - 1:right])\n        return result == arr\n"
      }
    },
