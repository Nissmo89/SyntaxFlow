    "oracle": {
      "python3": {
        "call": "Checker().maxSatisfied(customers, grumpy, minutes, {result})",
        "checker": "class Checker:\n    def maxSatisfied(self, customers, grumpy, minutes, result):\n        base = sum(c for c, g in zip(customers, grumpy) if not g)\n        gain = sum(c for c, g in zip(customers[:minutes], grumpy[:minutes]) if g)\n        best = gain\n        cur = gain\n        n = len(customers)\n        for i in range(minutes, n):\n            if grumpy[i]:\n                cur += customers[i]\n            if grumpy[i - minutes]:\n                cur -= customers[i - minutes]\n            if cur > best:\n                best = cur\n        return result == base + best\n"
      }
    },
