    "oracle": {
      "python3": {
        "call": "Checker().partitionDisjoint(nums, {result})",
        "checker": "class Checker:\n    def partitionDisjoint(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        n = len(nums)\n        if result < 1 or result >= n:\n            return False\n        left = nums[:result]\n        right = nums[result:]\n        return max(left) <= min(right) and all(x <= y for x in left for y in right)\n"
      }
    },
