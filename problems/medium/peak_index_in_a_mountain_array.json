    "oracle": {
      "python3": {
        "call": "Checker().peakIndexInMountainArray(arr, {result})",
        "checker": "class Checker:\n    def peakIndexInMountainArray(self, arr, result):\n        if not isinstance(result, int):\n            return False\n        l, r = 0, len(arr) - 1\n        while l < r:\n            mid = (l + r) // 2\n            if arr[mid] < arr[mid + 1]:\n                l = mid + 1\n            else:\n                r = mid\n        return result == l\n"
      }
    },
