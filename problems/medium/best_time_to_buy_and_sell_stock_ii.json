    "oracle": {
      "python3": {
        "call": "Checker().maxProfit(prices, {result})",
        "checker": "class Checker:\n    def maxProfit(self, prices, result):\n        if not isinstance(prices, list):\n            return False\n        if not isinstance(result, int):\n            return False\n        if any((not isinstance(x, int)) or x < 0 for x in prices):\n            return False\n        profit = 0\n        for i in range(1, len(prices)):\n            if prices[i] > prices[i - 1]:\n                profit += prices[i] - prices[i - 1]\n        return result == profit\n"
      }
    },
