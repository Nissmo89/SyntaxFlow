    "oracle": {
      "python3": {
        "call": "Checker().subarrayBitwiseORs(arr, {result})",
        "checker": "class Checker:\n    def subarrayBitwiseORs(self, arr, result):\n        expected = set()\n        current = set()\n        for x in arr:\n            nxt = {x | y for y in current}\n            nxt.add(x)\n            expected.update(nxt)\n            current = nxt\n        return result == len(expected)\n"
      }
    },
