    "oracle": {
      "python3": {
        "call": "Checker().findUnsortedSubarray(nums, {result})",
        "checker": "class Checker:\n    def findUnsortedSubarray(self, nums, result):\n        sorted_nums = sorted(nums)\n        start = len(nums)\n        end = 0\n        for i, (a, b) in enumerate(zip(nums, sorted_nums)):\n            if a != b:\n                start = min(start, i)\n                end = max(end, i)\n        expected = end - start + 1 if end - start >= 0 else 0\n        return isinstance(result, int) and result == expected\n"
      }
    },
