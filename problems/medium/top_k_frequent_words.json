    "oracle": {
      "python3": {
        "call": "Checker().topKFrequent(words, k, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def topKFrequent(self, words, k, result):\n        if not isinstance(result, list) or len(result) != k:\n            return False\n        if any(not isinstance(word, str) for word in result):\n            return False\n        counter = Counter(words)\n        expected = sorted(counter.items(), key=lambda item: (-item[1], item[0]))\n        return result == [word for word, _ in expected[:k]]\n"
      }
    },
