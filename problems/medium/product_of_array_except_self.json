    "oracle": {
      "python3": {
        "call": "Checker().productExceptSelf(nums, {result})",
        "checker": "class Checker:\n    def productExceptSelf(self, nums, result):\n        if not isinstance(result, list):\n            return False\n        if len(result) != len(nums):\n            return False\n        n = len(nums)\n        expected = [1] * n\n        prefix = 1\n        for i, x in enumerate(nums):\n            expected[i] = prefix\n            prefix *= x\n        suffix = 1\n        for i in range(n - 1, -1, -1):\n            expected[i] *= suffix\n            suffix *= nums[i]\n        for i in range(n):\n            if result[i] != expected[i]:\n                return False\n        return True\n"
      }
    },
