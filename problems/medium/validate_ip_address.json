    "oracle": {
      "python3": {
        "call": "Checker().validIPAddress(queryIP, {result})",
        "checker": "from typing import Any\n\nclass Checker:\n    def validIPAddress(self, queryIP: Any, result: Any) -> bool:\n        if not isinstance(queryIP, str) or not isinstance(result, str):\n            return False\n        if result not in {\"IPv4\", \"IPv6\", \"Neither\"}:\n            return False\n\n        def is_ipv4(ip: str) -> bool:\n            if ip.count(\".\") != 3:\n                return False\n            parts = ip.split(\".\")\n            if len(parts) != 4:\n                return False\n            for p in parts:\n                if not p.isdigit():\n                    return False\n                if p != \"0\" and p.startswith(\"0\"):\n                    return False\n                if not 0 <= int(p) <= 255:\n                    return False\n            return True\n\n        def is_ipv6(ip: str) -> bool:\n            if ip.count(\":\") != 7:\n                return False\n            parts = ip.split(\":\")\n            if len(parts) != 8:\n                return False\n            hexdigits = \"0123456789abcdefABCDEF\"\n            for p in parts:\n                if not (1 <= len(p) <= 4):\n                    return False\n                if any(c not in hexdigits for c in p):\n                    return False\n            return True\n\n        expected = \"IPv4\" if is_ipv4(queryIP) else \"IPv6\" if is_ipv6(queryIP) else \"Neither\"\n        return result == expected\n"
      }
    },
