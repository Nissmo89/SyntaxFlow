    "oracle": {
      "python3": {
        "call": "Checker().longestArithSeqLength(nums, {result})",
        "checker": "class Checker:\n    def longestArithSeqLength(self, nums, result):\n        n = len(nums)\n        if n <= 2:\n            return result == n\n        dp = [{} for _ in range(n)]\n        best = 2\n        for i in range(n):\n            for j in range(i):\n                d = nums[i] - nums[j]\n                dp[i][d] = dp[j].get(d, 1) + 1\n                if dp[i][d] > best:\n                    best = dp[i][d]\n        return result == best\n"
      }
    },
