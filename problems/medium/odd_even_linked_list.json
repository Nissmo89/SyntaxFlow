    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(head, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def _to_values(self, node: Any) -> List[int]:\n        if node is None:\n            return []\n        if isinstance(node, (list, tuple)):\n            return list(node)\n        values = []\n        seen = 0\n        while node is not None:\n            if not hasattr(node, \"val\") or not hasattr(node, \"next\"):\n                return []\n            values.append(node.val)\n            node = node.next\n            seen += 1\n            if seen > 200000:\n                return []\n        return values\n\n    def check(self, head: Any, result: Any) -> bool:\n        src = self._to_values(head)\n        got = self._to_values(result)\n        if len(src) != len(got):\n            return False\n        expected = src[::2] + src[1::2]\n        return got == expected\n"
      }
    },
