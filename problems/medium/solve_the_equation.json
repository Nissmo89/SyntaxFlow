    "oracle": {
      "python3": {
        "call": "Checker().solveEquation(equation, {result})",
        "checker": "class Checker:\n    def solveEquation(self, equation, result):\n        left, right = equation.split(\"=\")\n\n        def parse_side(side):\n            coeff = 0\n            const = 0\n            num = \"\"\n            sign = 1\n            for char in side + \"+\":\n                if char in \"+-\":\n                    if num:\n                        const += sign * int(num)\n                        num = \"\"\n                    sign = 1 if char == \"+\" else -1\n                elif char.isdigit():\n                    num += char\n                elif char == \"x\":\n                    coeff += sign * (int(num) if num else 1)\n                    num = \"\"\n            return coeff, const\n\n        left_coeff, left_const = parse_side(left)\n        right_coeff, right_const = parse_side(right)\n        coeff = left_coeff - right_coeff\n        const = right_const - left_const\n        if coeff == 0:\n            expected = \"No solution\" if const != 0 else \"Infinite solutions\"\n        else:\n            expected = \"x={}\".format(const / coeff)\n        return result == expected\n"
      }
    },
