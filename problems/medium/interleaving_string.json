    "oracle": {
      "python3": {
        "call": "Checker().check(s1, s2, s3, {result})",
        "checker": "import json\nclass Checker:\n    def check(self, s1, s2, s3, res):\n        try:\n            res = json.loads(res) if isinstance(res, str) else res\n        except Exception:\n            return False\n        m, n = len(s1), len(s2)\n        if m + n != len(s3):\n            return res is False\n        dp = [False] * (n + 1)\n        dp[0] = True\n        for j in range(1, n + 1):\n            dp[j] = dp[j - 1] and s2[j - 1] == s3[j - 1]\n        for i in range(1, m + 1):\n            dp[0] = dp[0] and s1[i - 1] == s3[i - 1]\n            for j in range(1, n + 1):\n                dp[j] = (dp[j] and s1[i - 1] == s3[i + j - 1]) or (dp[j - 1] and s2[j - 1] == s3[i + j - 1])\n        return res == dp[n]\n"
      }
    },
