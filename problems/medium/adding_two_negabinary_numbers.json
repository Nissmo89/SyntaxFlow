    "oracle": {
      "python3": {
        "call": "Checker().addNegabinary(arr1, arr2, {result})",
        "checker": "class Checker:\n    def addNegabinary(self, arr1, arr2, result):\n        if not isinstance(result, list) or not result:\n            return False\n        if result[0] == 0 and len(result) > 1:\n            return False\n        if any(x not in (0, 1) for x in result):\n            return False\n        a = list(arr1)\n        b = list(arr2)\n        carry = 0\n        expected = []\n        while carry or a or b:\n            if a:\n                carry += a.pop()\n            if b:\n                carry += b.pop()\n            expected.append(carry & 1)\n            carry = -(carry >> 1)\n        while len(expected) > 1 and expected[-1] == 0:\n            expected.pop()\n        return result == expected[::-1]\n"
      }
    },
