      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().findLongestWord(s, dictionary, {result})",
        "checker": "class Checker:\n    def findLongestWord(self, s, dictionary, result):\n        if not isinstance(result, str):\n            return False\n        if result not in dictionary and result != \"\":\n            return False\n\n        def is_subsequence(word, source):\n            i = 0\n            for ch in source:\n                if i < len(word) and word[i] == ch:\n                    i += 1\n            return i == len(word)\n\n        if result != \"\" and not is_subsequence(result, s):\n            return False\n\n        best = \"\"\n        for word in dictionary:\n            if is_subsequence(word, s):\n                if len(word) > len(best) or (len(word) == len(best) and word < best):\n                    best = word\n        return result == best\n"
      }
    },
