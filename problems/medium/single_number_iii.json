    "oracle": {
      "python3": {
        "call": "Checker().singleNumber(nums, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def singleNumber(self, nums: List[int], result: Any) -> bool:\n        if not isinstance(result, list) or len(result) != 2:\n            return False\n        if any(not isinstance(x, int) for x in result):\n            return False\n\n        counts = {}\n        for n in nums:\n            counts[n] = counts.get(n, 0) + 1\n\n        singles = sorted([n for n, c in counts.items() if c == 1])\n        if len(singles) != 2:\n            return False\n        if any(c not in (1, 2) for c in counts.values()):\n            return False\n\n        return sorted(result) == singles\n"
      }
    },
