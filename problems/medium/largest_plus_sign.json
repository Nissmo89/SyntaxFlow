    "oracle": {
      "python3": {
        "call": "Checker().orderOfLargestPlusSign(n, mines, {result})",
        "checker": "class Checker(object):\n    def orderOfLargestPlusSign(self, n, mines, result):\n        if not isinstance(result, int):\n            return False\n        if not isinstance(n, int) or n < 1 or n > 500:\n            return False\n        if not isinstance(mines, list) or len(mines) < 1 or len(mines) > 5000:\n            return False\n        seen = set()\n        for cell in mines:\n            if not isinstance(cell, list) or len(cell) != 2:\n                return False\n            r, c = cell\n            if not isinstance(r, int) or not isinstance(c, int):\n                return False\n            if r < 0 or r >= n or c < 0 or c >= n:\n                return False\n            key = (r, c)\n            if key in seen:\n                return False\n            seen.add(key)\n        best = 0\n        for r in range(n):\n            for c in range(n):\n                if (r, c) in seen:\n                    continue\n                max_order = min(r + 1, c + 1, n - r, n - c)\n                order = best + 1\n                while order <= max_order:\n                    arm = order - 1\n                    ok = True\n                    for d in range(arm + 1):\n                        if (r - d, c) in seen or (r + d, c) in seen or (r, c - d) in seen or (r, c + d) in seen:\n                            ok = False\n                            break\n                    if not ok:\n                        break\n                    best = order\n                    order += 1\n        return result == best\n"
      }
    },
