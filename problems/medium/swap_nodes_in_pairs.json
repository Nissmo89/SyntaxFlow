    "oracle": {
      "python3": {
        "call": "Checker().check(head, {result})",
        "checker": "import json\n\nclass Checker:\n    def check(self, head, result):\n        try:\n            got = json.loads(result) if isinstance(result, str) else result\n        except Exception:\n            return False\n        if not isinstance(got, list):\n            return False\n        expected = []\n        for i in range(0, len(head), 2):\n            if i + 1 < len(head):\n                expected.append(head[i + 1])\n                expected.append(head[i])\n            else:\n                expected.append(head[i])\n        return got == expected\n"
      }
    },
