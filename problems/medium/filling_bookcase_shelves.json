    "oracle": {
      "python3": {
        "call": "Checker().check(books, shelfWidth, {result})",
        "checker": "class Checker(object):\n    def check(self, books, shelfWidth, result):\n        if not isinstance(result, int) or result <= 0:\n            return False\n        n = len(books)\n        dp = [float('inf')] * (n + 1)\n        dp[0] = 0\n        for i in range(1, n + 1):\n            dp[i] = dp[i - 1] + books[i - 1][1]\n            height = 0\n            width = 0\n            for j in range(i - 1, -1, -1):\n                height = max(height, books[j][1])\n                width += books[j][0]\n                if width > shelfWidth:\n                    break\n                dp[i] = min(dp[i], dp[j] + height)\n        return dp[n] == result\n"
      }
    },
