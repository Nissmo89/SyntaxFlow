      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(n, {result})",
        "checker": "class Checker:\n    def _cat(self, n):\n        dp = [0] * (n + 1)\n        dp[0] = 1\n        for i in range(1, n + 1):\n            total = 0\n            for left in range(i):\n                total += dp[left] * dp[i - 1 - left]\n            dp[i] = total\n        return dp[n]\n\n    def _build(self, arr):\n        if not arr:\n            return None\n        nodes = [None if v is None else {\"v\": v, \"l\": None, \"r\": None} for v in arr]\n        kids = nodes[1:]\n        for node in nodes:\n            if node is not None:\n                if kids:\n                    node[\"l\"] = kids.pop(0)\n                if kids:\n                    node[\"r\"] = kids.pop(0)\n        return nodes[0]\n\n    def _inorder(self, node, vals):\n        if node is None:\n            return\n        self._inorder(node[\"l\"], vals)\n        vals.append(node[\"v\"])\n        self._inorder(node[\"r\"], vals)\n\n    def _sig(self, arr):\n        return tuple(arr)\n\n    def check(self, n, result):\n        if not isinstance(result, list) or len(result) != self._cat(n):\n            return False\n\n        seen = set()\n        for tree in result:\n            if not isinstance(tree, list) or not tree:\n                return False\n            sig = self._sig(tree)\n            if sig in seen:\n                return False\n            seen.add(sig)\n            root = self._build(tree)\n            vals = []\n            self._inorder(root, vals)\n            if vals != list(range(1, n + 1)):\n                return False\n        return True\n"
      }
    },
