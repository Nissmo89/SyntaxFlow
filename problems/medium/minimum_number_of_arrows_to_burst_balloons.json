    "oracle": {
      "python3": {
        "call": "Checker().check(points, {result})",
        "checker": "class Checker:\n    def check(self, points, result):\n        if not isinstance(result, int):\n            return False\n        if result < 1:\n            return False\n        intervals = [list(p) for p in points]\n        if not intervals:\n            return False\n        intervals.sort(key=lambda x: x[1])\n        arrows = 1\n        end = intervals[0][1]\n        for start, finish in intervals:\n            if start > end:\n                arrows += 1\n                end = finish\n        return arrows == result\n"
      }
    },
