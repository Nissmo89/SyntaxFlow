      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().rearrangeBarcodes(barcodes, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def rearrangeBarcodes(self, barcodes, result):\n        if not isinstance(result, list):\n            return False\n        if len(result) != len(barcodes):\n            return False\n        if Counter(result) != Counter(barcodes):\n            return False\n        for i in range(1, len(result)):\n            if result[i] == result[i - 1]:\n                return False\n        return True\n"
      }
    },
