    "oracle": {
      "python3": {
        "call": "Checker().longestWord(words, {result})",
        "checker": "class Checker:\n    def longestWord(self, words, result):\n        if not isinstance(words, list):\n            return False\n        if not isinstance(result, str):\n            return False\n        seen = set()\n        best = \"\"\n        for word in sorted(words):\n            if len(word) == 1 or word[:-1] in seen:\n                seen.add(word)\n                if len(word) > len(best) or (len(word) == len(best) and word < best):\n                    best = word\n        return result == best\n"
      }
    },
