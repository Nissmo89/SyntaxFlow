    "oracle": {
      "python3": {
        "call": "Checker().lengthOfLongestSubstring(s, {result})",
        "checker": "class Checker:\n    def lengthOfLongestSubstring(self, s, result):\n        if not isinstance(result, int):\n            return False\n        last_seen = {}\n        start = 0\n        best = 0\n        for end, ch in enumerate(s):\n            if ch in last_seen and last_seen[ch] >= start:\n                start = last_seen[ch] + 1\n            best = max(best, end - start + 1)\n            last_seen[ch] = end\n        return result == best\n"
      }
    },
