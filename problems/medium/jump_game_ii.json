    "oracle": {
      "python3": {
        "call": "Checker().jump(nums, {result})",
        "checker": "class Checker:\n    def jump(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        n = len(nums)\n        if n <= 1:\n            return result == 0\n        jumps = 0\n        curr_end = 0\n        max_reach = 0\n        for i in range(n - 1):\n            if i > max_reach:\n                return False\n            max_reach = max(max_reach, i + nums[i])\n            if i == curr_end:\n                jumps += 1\n                curr_end = max_reach\n                if curr_end >= n - 1:\n                    break\n        return result == jumps\n"
      }
    },
