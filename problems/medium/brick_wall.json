      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(wall, {result})",
        "checker": "class Checker:\n    def check(self, wall, result):\n        if not isinstance(result, int):\n            return False\n        edge_counts = {}\n        for row in wall:\n            edge = 0\n            for brick in row[:-1]:\n                edge += brick\n                edge_counts[edge] = edge_counts.get(edge, 0) + 1\n        best = 0\n        for count in edge_counts.values():\n            if count > best:\n                best = count\n        return result == len(wall) - best\n"
      }
    },
