    "oracle": {
      "python3": {
        "call": "Checker().minAddToMakeValid(s, {result})",
        "checker": "class Checker:\n    def minAddToMakeValid(self, s, result):\n        if not isinstance(result, int):\n            return False\n        balance = 0\n        add = 0\n        for ch in s:\n            if ch == '(':\n                balance += 1\n            else:\n                if balance == 0:\n                    add += 1\n                else:\n                    balance -= 1\n        return result == add + balance\n"
      }
    },
