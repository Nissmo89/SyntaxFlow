    "oracle": {
      "python3": {
        "call": "Checker().countPrimes(n, {result})",
        "checker": "class Checker:\n    def countPrimes(self, n, result) -> bool:\n        if not isinstance(result, int):\n            return False\n        if n < 2:\n            return result == 0\n\n        sieve = bytearray(b'\\x01') * n\n        sieve[0] = 0\n        sieve[1] = 0\n\n        i = 2\n        while i * i < n:\n            if sieve[i]:\n                for j in range(i * i, n, i):\n                    sieve[j] = 0\n            i += 1\n\n        return result == sum(sieve)\n"
      }
    },
