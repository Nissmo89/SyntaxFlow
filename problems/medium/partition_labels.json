    "oracle": {
      "python3": {
        "call": "Checker().partitionLabels(s, {result})",
        "checker": "class Checker:\n    def partitionLabels(self, s, result):\n        if not isinstance(result, list):\n            return False\n        total = 0\n        for length in result:\n            if not isinstance(length, int) or length <= 0:\n                return False\n            total += length\n        if total != len(s):\n            return False\n        last = {}\n        for i, ch in enumerate(s):\n            last[ch] = i\n        expected = []\n        start = 0\n        end = 0\n        for i, ch in enumerate(s):\n            if last[ch] > end:\n                end = last[ch]\n            if i == end:\n                expected.append(end - start + 1)\n                start = i + 1\n        return result == expected\n"
      }
    },
