    "oracle": {
      "python3": {
        "call": "Checker().constructMaximumBinaryTree(nums, {result})",
        "checker": "class Checker:\n    def constructMaximumBinaryTree(self, nums, result):\n        class Node:\n            __slots__ = (\"val\", \"left\", \"right\")\n\n            def __init__(self, val):\n                self.val = val\n                self.left = None\n                self.right = None\n\n        stack = []\n        for num in nums:\n            current = Node(num)\n            while stack and stack[-1].val < num:\n                current.left = stack.pop()\n            if stack:\n                stack[-1].right = current\n            stack.append(current)\n\n        expected = stack[0] if stack else None\n\n        def serialize(root):\n            from collections import deque\n\n            if root is None:\n                return []\n            queue = deque([root])\n            out = []\n            while queue:\n                node = queue.popleft()\n                if node is None:\n                    out.append(None)\n                    continue\n                out.append(node.val)\n                queue.append(node.left)\n                queue.append(node.right)\n            while out and out[-1] is None:\n                out.pop()\n            return out\n\n        return serialize(expected) == result\n"
      }
    },
