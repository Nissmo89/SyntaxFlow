    "oracle": {
      "python3": {
        "call": "Checker().longestPalindrome(s, {result})",
        "checker": "class Checker:\n    def longestPalindrome(self, s, result):\n        if not isinstance(result, str):\n            return False\n        if len(result) == 0 or len(result) > len(s):\n            return False\n        if result not in s:\n            return False\n        if result != result[::-1]:\n            return False\n\n        def best_length(text):\n            best = 1\n            n = len(text)\n            for center in range(n):\n                left = right = center\n                while left >= 0 and right < n and text[left] == text[right]:\n                    best = max(best, right - left + 1)\n                    left -= 1\n                    right += 1\n                left = center\n                right = center + 1\n                while left >= 0 and right < n and text[left] == text[right]:\n                    best = max(best, right - left + 1)\n                    left -= 1\n                    right += 1\n            return best\n\n        return len(result) == best_length(s)\n"
      }
    },
