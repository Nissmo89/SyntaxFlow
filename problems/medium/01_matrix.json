      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(mat, {result})",
        "checker": "class Checker:\n    def check(self, mat, result):\n        if not isinstance(result, list) or len(result) != len(mat):\n            return False\n        if not mat or not isinstance(result[0], list) or len(result[0]) != len(mat[0]):\n            return False\n        rows = len(mat)\n        cols = len(mat[0])\n        for row in result:\n            if not isinstance(row, list) or len(row) != cols:\n                return False\n            for value in row:\n                if not isinstance(value, int) or value < 0:\n                    return False\n        from collections import deque\n        q = deque()\n        dist = [[10 ** 9] * cols for _ in range(rows)]\n        for i in range(rows):\n            for j in range(cols):\n                if mat[i][j] == 0:\n                    dist[i][j] = 0\n                    q.append((i, j))\n        while q:\n            i, j = q.popleft()\n            for di, dj in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                ni, nj = i + di, j + dj\n                if 0 <= ni < rows and 0 <= nj < cols and dist[ni][nj] > dist[i][j] + 1:\n                    dist[ni][nj] = dist[i][j] + 1\n                    q.append((ni, nj))\n        return result == dist\n"
      }
    },
