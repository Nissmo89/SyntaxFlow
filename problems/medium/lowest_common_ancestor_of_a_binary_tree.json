    "oracle": {
      "python3": {
        "call": "Checker().lowestCommonAncestor(root, p, q, {result})",
        "checker": "from typing import Any\n\nclass Checker:\n    def lowestCommonAncestor(self, root, p: int, q: int, result: Any) -> bool:\n        if not isinstance(root, list):\n            return False\n\n        class Node:\n            def __init__(self, val):\n                self.val = val\n                self.left = None\n                self.right = None\n\n        def to_tree(arr):\n            if not arr or arr[0] is None:\n                return None\n            nodes = [None if v is None else Node(v) for v in arr]\n            kid = 1\n            for i, node in enumerate(nodes):\n                if node is None:\n                    continue\n                if kid < len(nodes):\n                    node.left = nodes[kid]\n                    kid += 1\n                if kid < len(nodes):\n                    node.right = nodes[kid]\n                    kid += 1\n            return nodes[0]\n\n        def dfs(node):\n            if node is None:\n                return None\n            if node.val == p or node.val == q:\n                return node.val\n            left = dfs(node.left)\n            right = dfs(node.right)\n            if left is not None and right is not None:\n                return node.val\n            return left if left is not None else right\n\n        expected = dfs(to_tree(root))\n        if isinstance(result, dict):\n            return result.get(\"val\") == expected\n        return hasattr(result, \"val\") and result.val == expected\n"
      }
    },
