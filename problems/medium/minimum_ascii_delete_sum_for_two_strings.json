    "oracle": {
      "python3": {
        "call": "Checker().minimumDeleteSum({s1}, {s2}, {result})",
        "checker": "class Checker:\n    def minimumDeleteSum(self, s1, s2, result):\n        if not isinstance(result, int):\n            return False\n        n, m = len(s1), len(s2)\n        dp = [[0] * (m + 1) for _ in range(n + 1)]\n        for i in range(n):\n            for j in range(m):\n                if s1[i] == s2[j]:\n                    dp[i + 1][j + 1] = dp[i][j] + ord(s1[i])\n                else:\n                    dp[i + 1][j + 1] = max(dp[i][j + 1], dp[i + 1][j])\n        expected = sum(ord(c) for c in s1) + sum(ord(c) for c in s2) - 2 * dp[n][m]\n        return result == expected\n"
      }
    },
