    "oracle": {
      "python3": {
        "call": "Checker().check(nums, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def check(self, nums: List[int], result: Any) -> bool:\n        if not isinstance(result, int):\n            return False\n        n = len(nums) - 1\n        if len(nums) < 2:\n            return False\n        if any(not isinstance(x, int) for x in nums):\n            return False\n        if any(x < 1 or x > n for x in nums):\n            return False\n        counts = {}\n        for x in nums:\n            counts[x] = counts.get(x, 0) + 1\n        duplicates = [x for x, c in counts.items() if c > 1]\n        if len(duplicates) != 1:\n            return False\n        return result == duplicates[0]\n"
      }
    },
