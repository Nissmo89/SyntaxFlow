    "oracle": {
      "python3": {
        "call": "Checker().searchRange(nums, target, {result})",
        "checker": "class Checker:\n    def searchRange(self, nums, target, result):\n        if not isinstance(result, list):\n            return False\n        if len(result) != 2:\n            return False\n        if not all(isinstance(x, int) for x in result):\n            return False\n\n        left = -1\n        right = -1\n        for i, value in enumerate(nums):\n            if value == target:\n                if left == -1:\n                    left = i\n                right = i\n\n        return result == [left, right]\n"
      }
    },
