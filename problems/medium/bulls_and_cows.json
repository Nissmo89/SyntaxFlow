    "oracle": {
      "python3": {
        "call": "Checker().getHint(secret, guess, {result})",
        "checker": "from collections import Counter\nfrom typing import Any\n\nclass Checker:\n    def getHint(self, secret: Any, guess: Any, result: Any) -> bool:\n        if not isinstance(secret, str) or not isinstance(guess, str):\n            return False\n        if not isinstance(result, str):\n            return False\n        if len(secret) != len(guess):\n            return False\n        bulls = sum(a == b for a, b in zip(secret, guess))\n        counts = Counter(secret)\n        cows = 0\n        for ch, gc in Counter(guess).items():\n            cows += min(counts.get(ch, 0), gc)\n        cows -= bulls\n        return result == f\"{bulls}A{cows}B\"\n"
      }
    },
