    "oracle": {
      "python3": {
        "call": "Checker().findAnagrams(s, p, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def findAnagrams(self, s: str, p: str, result: Any) -> bool:\n        if not isinstance(result, list):\n            return False\n        if not all(isinstance(x, int) for x in result):\n            return False\n        n1 = len(s)\n        n2 = len(p)\n        if n1 < n2:\n            return result == []\n        need = [0] * 26\n        for ch in p:\n            need[ord(ch) - 97] += 1\n        expected = []\n        for i in range(n1 - n2 + 1):\n            window = [0] * 26\n            for ch in s[i:i + n2]:\n                window[ord(ch) - 97] += 1\n            if window == need:\n                expected.append(i)\n        return sorted(result) == expected\n"
      }
    },
