    "oracle": {
      "python3": {
        "call": "Checker().check(edges, {result})",
        "checker": "class Checker:\n    def check(self, edges, result):\n        if not isinstance(result, list) or len(result) != 2:\n            return False\n        if any(not isinstance(x, int) for x in result):\n            return False\n        a, b = result\n        if a == b:\n            return False\n        n = len(edges)\n        if n < 3:\n            return False\n        if not (1 <= a <= n and 1 <= b <= n):\n            return False\n\n        parent = list(range(n + 1))\n\n        def find(x):\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]\n                x = parent[x]\n            return x\n\n        def union(x, y):\n            rx = find(x)\n            ry = find(y)\n            if rx == ry:\n                return False\n            parent[ry] = rx\n            return True\n\n        expected = None\n        for u, v in edges:\n            if not union(u, v):\n                expected = [u, v]\n        if expected is None:\n            return False\n        return result == expected\n"
      }
    },
