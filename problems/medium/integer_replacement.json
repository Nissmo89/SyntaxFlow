        "call": "Checker().integerReplacement(n, {result})",
        "checker": "import json\n\nclass Checker:\n    def integerReplacement(self, n, result):\n        try:\n            result = json.loads(result) if isinstance(result, str) else result\n        except Exception:\n            return False\n        if not isinstance(result, int):\n            return False\n        def helper(x):\n            if x == 1:\n                return 0\n            if x % 2 == 0:\n                return 1 + helper(x // 2)\n            return 1 + min(helper(x - 1), helper(x + 1))\n        return result == helper(n)\n"
      }
    },
