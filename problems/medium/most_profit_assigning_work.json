      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().maxProfitAssignment(difficulty, profit, worker, {result})",
        "checker": "class Checker:\n    def maxProfitAssignment(self, difficulty, profit, worker, result):\n        if not isinstance(result, int) or len(difficulty) != len(profit):\n            return False\n        best = 0\n        total = 0\n        jobs = sorted(zip(difficulty, profit))\n        workers = sorted(worker)\n        i = 0\n        for ability in workers:\n            while i < len(jobs) and jobs[i][0] <= ability:\n                best = max(best, jobs[i][1])\n                i += 1\n            total += best\n        return result == total\n"
      }
    },
