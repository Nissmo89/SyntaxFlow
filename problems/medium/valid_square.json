    "oracle": {
      "python3": {
        "call": "Checker().validSquare(p1, p2, p3, p4, {result})",
        "checker": "class Checker:\n    def validSquare(self, p1, p2, p3, p4, result):\n        pts = [p1, p2, p3, p4]\n        distances = set()\n        for i in range(4):\n            for j in range(i + 1, 4):\n                dx = pts[i][0] - pts[j][0]\n                dy = pts[i][1] - pts[j][1]\n                distances.add(dx * dx + dy * dy)\n        expected = len(distances) == 2 and 0 not in distances\n        return result == expected\n"
      }
    },
