      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().openLock(deadends, target, {result})",
        "checker": "from collections import deque\n\nclass Checker:\n    def _neighbors(self, state):\n        for i, ch in enumerate(state):\n            digit = ord(ch) - ord(\"0\")\n            yield state[:i] + str((digit + 1) % 10) + state[i + 1:]\n            yield state[:i] + str((digit - 1) % 10) + state[i + 1:]\n\n    def _expected(self, deadends, target):\n        if target == \"0000\":\n            return 0\n        dead = set(deadends)\n        if \"0000\" in dead:\n            return -1\n\n        queue = deque([(\"0000\", 0)])\n        seen = {\"0000\"}\n\n        while queue:\n            state, dist = queue.popleft()\n            if state == target:\n                return dist\n            for nxt in self._neighbors(state):\n                if nxt in dead or nxt in seen:\n                    continue\n                seen.add(nxt)\n                queue.append((nxt, dist + 1))\n        return -1\n\n    def openLock(self, deadends, target, result):\n        if not isinstance(result, int):\n            return False\n        return result == self._expected(deadends, target)\n"
      }
    },
