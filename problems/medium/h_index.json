    "oracle": {
      "python3": {
        "call": "Checker().check(citations, {result})",
        "checker": "class Checker:\n    def check(self, citations, result):\n        if not isinstance(result, int):\n            return False\n        if result < 0 or result > len(citations):\n            return False\n        h = result\n        at_least_h = sum(1 for c in citations if c >= h)\n        if at_least_h < h:\n            return False\n        if h == len(citations):\n            return True\n        at_least_next = sum(1 for c in citations if c >= h + 1)\n        return at_least_next < h + 1\n"
      }
    },
