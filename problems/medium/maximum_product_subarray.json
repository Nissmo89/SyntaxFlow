    "oracle": {
      "python3": {
        "call": "Checker().maxProduct(nums, {result})",
        "checker": "class Checker:\n    def maxProduct(self, nums, result):\n        if not isinstance(nums, list) or not nums:\n            return False\n        if any((not isinstance(x, int)) for x in nums):\n            return False\n        if any(x < -10 or x > 10 for x in nums):\n            return False\n\n        best = nums[0]\n        cur_max = 1\n        cur_min = 1\n        for n in nums:\n            temp = cur_max * n\n            cur_max = max(temp, cur_min * n, n)\n            cur_min = min(temp, cur_min * n, n)\n            best = max(best, cur_max)\n        return result == best\n"
      }
    },
