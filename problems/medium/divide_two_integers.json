        "checker": "class Checker:\n    def divide(self, dividend, divisor, result):\n        if not isinstance(result, int):\n            return False\n        if divisor == 0:\n            return False\n        expected = int(dividend / divisor)\n        if dividend == -(2**31) and divisor == -1:\n            expected = 2**31 - 1\n        if expected < -(2**31):\n            expected = -(2**31)\n        if expected > 2**31 - 1:\n            expected = 2**31 - 1\n        return result == expected\n"
      }
    },
