    "oracle": {
      "python3": {
        "call": "Checker().combine(n, k, {result})",
        "checker": "class Checker:\n    def combine(self, n, k, result):\n        expected = []\n        cur = []\n\n        def dfs(start):\n            if len(cur) == k:\n                expected.append(tuple(cur))\n                return\n            for i in range(start, n + 1):\n                cur.append(i)\n                dfs(i + 1)\n                cur.pop()\n\n        dfs(1)\n        got = [tuple(x) for x in result]\n        return sorted(got) == sorted(expected)\n"
      }
    },
