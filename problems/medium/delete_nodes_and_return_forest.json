    "oracle": {
      "python3": {
        "call": "Checker().delNodes(root, to_delete, {result})",
        "checker": "from collections import deque\n\nclass Checker:\n    def delNodes(self, root, to_delete, result):\n        def normalize(node):\n            if node is None:\n                return None\n            if isinstance(node, list):\n                if not node:\n                    return None\n                nodes = [None if v is None else {\"val\": v, \"left\": None, \"right\": None} for v in node]\n                kids = deque(nodes[1:])\n                for item in nodes:\n                    if item is not None:\n                        if kids:\n                            item[\"left\"] = kids.popleft()\n                        if kids:\n                            item[\"right\"] = kids.popleft()\n                return nodes[0]\n            if isinstance(node, dict):\n                return {\n                    \"val\": node.get(\"val\"),\n                    \"left\": normalize(node.get(\"left\")),\n                    \"right\": normalize(node.get(\"right\")),\n                }\n            if hasattr(node, \"val\"):\n                return {\n                    \"val\": node.val,\n                    \"left\": normalize(getattr(node, \"left\", None)),\n                    \"right\": normalize(getattr(node, \"right\", None)),\n                }\n            return None\n\n        def serialize(node):\n            node = normalize(node)\n            if node is None:\n                return None\n            out = []\n            q = deque([node])\n            while q:\n                cur = q.popleft()\n                if cur is None:\n                    out.append(None)\n                    continue\n                out.append(cur[\"val\"])\n                q.append(cur[\"left\"])\n                q.append(cur[\"right\"])\n            while out and out[-1] is None:\n                out.pop()\n            return tuple(out)\n\n        def build_tree(arr):\n            if not arr:\n                return None\n            nodes = [None if v is None else {\"val\": v, \"left\": None, \"right\": None} for v in arr]\n            kids = deque(nodes[1:])\n            for node in nodes:\n                if node is not None:\n                    if kids:\n                        node[\"left\"] = kids.popleft()\n                    if kids:\n                        node[\"right\"] = kids.popleft()\n            return nodes[0]\n\n        def clone_and_delete(node, deletes):\n            ans = []\n            st = set(deletes)\n\n            def dfs(cur, is_root):\n                if cur is None:\n                    return None\n                deleted = cur[\"val\"] in st\n                if is_root and not deleted:\n                    ans.append(cur)\n                cur[\"left\"] = dfs(cur[\"left\"], deleted)\n                cur[\"right\"] = dfs(cur[\"right\"], deleted)\n                return None if deleted else cur\n\n            dfs(node, True)\n            return ans\n\n        if not isinstance(result, list):\n            return False\n        tree = build_tree(root)\n        expected = clone_and_delete(tree, to_delete)\n        got = [serialize(item) for item in result]\n        exp = [serialize(item) for item in expected]\n        return sorted(got, key=str) == sorted(exp, key=str)\n"
      }
    },
