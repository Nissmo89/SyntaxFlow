    "oracle": {
      "python3": {
        "call": "Checker().grayCode(n, {result})",
        "checker": "class Checker:\n    def grayCode(self, n, result):\n        if not isinstance(n, int) or n < 1 or n > 16:\n            return False\n        if not isinstance(result, list):\n            return False\n        size = 1 << n\n        if len(result) != size:\n            return False\n        if any((not isinstance(v, int)) or v < 0 or v >= size for v in result):\n            return False\n        if result[0] != 0:\n            return False\n        if len(set(result)) != size:\n            return False\n        def one_bit(a, b):\n            x = a ^ b\n            return x != 0 and (x & (x - 1)) == 0\n        for i in range(size - 1):\n            if not one_bit(result[i], result[i + 1]):\n                return False\n        return one_bit(result[0], result[-1])\n"
      }
    },
