    "oracle": {
      "python3": {
        "call": "Checker().minFlipsMonoIncr(s, {result})",
        "checker": "class Checker:\n    def minFlipsMonoIncr(self, s, result):\n        ones = 0\n        flips = 0\n        best = 0\n        for ch in s:\n            if ch == '1':\n                ones += 1\n            else:\n                flips += 1\n            if flips > ones:\n                flips = ones\n            best = max(best, 0)\n        zeroes = 0\n        ones = 0\n        for ch in s:\n            if ch == '0':\n                zeroes += 1\n        best = zeroes\n        for ch in s:\n            if ch == '0':\n                zeroes -= 1\n            else:\n                ones += 1\n            if zeroes + ones < best:\n                best = zeroes + ones\n        return result == best\n"
      }
    },
