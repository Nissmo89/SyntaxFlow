    "oracle": {
      "python3": {
        "call": "Checker().findClosestElements(arr, k, x, {result})",
        "checker": "class Checker:\n    def findClosestElements(self, arr, k, x, result):\n        if not isinstance(result, list):\n            return False\n        if len(result) != k:\n            return False\n        if any(result[i] > result[i + 1] for i in range(len(result) - 1)):\n            return False\n        expected = sorted(sorted(arr, key=lambda num: (abs(num - x), num))[:k])\n        return result == expected\n"
      }
    },
