{
  "id": "spiral_matrix_ii",
  "title": "Spiral Matrix II",
  "difficulty": "Medium",
  "category": "Algorithms",
  "tags": [
    "Array",
    "Matrix",
    "Simulation"
  ],
  "description": "<p>Given a positive integer <code>n</code>, generate an <code>n x n</code> <code>matrix</code> filled with elements from <code>1</code> to <code>n<sup>2</sup></code> in spiral order.</p>\n\n<p>&nbsp;</p>\n<p><strong class=\"example\">Example 1:</strong></p>\n<img alt=\"\" src=\"assets/problem_images/c58dcb2bce453a04139ed9cb99bfa663e2aaf86dd4ae7164b1c6dbe299513849.jpg\" style=\"width: 242px; height: 242px;\" />\n<pre>\n<strong>Input:</strong> n = 3\n<strong>Output:</strong> [[1,2,3],[8,9,4],[7,6,5]]\n</pre>\n\n<p><strong class=\"example\">Example 2:</strong></p>\n\n<pre>\n<strong>Input:</strong> n = 1\n<strong>Output:</strong> [[1]]\n</pre>\n\n<p>&nbsp;</p>\n<p><strong>Constraints:</strong></p>\n\n<ul>\n\t<li><code>1 &lt;= n &lt;= 20</code></li>\n</ul>\n",
  "task": "Solve the 'Spiral Matrix II' problem on LeetCode.",
  "inputFormat": "Passed directly as parameters.",
  "outputFormat": "Returned value from the solution method.",
  "constraints": [
    "1 <= n <= 20"
  ],
  "hints": [],
  "method": {
    "name": "generateMatrix",
    "returnType": "auto",
    "params": [
      {
        "name": "n",
        "type": "int"
      }
    ]
  },
  "manifest": {
    "entry": {
      "id": 59,
      "title": "spiral-matrix-ii",
      "params": {
