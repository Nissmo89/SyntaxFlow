          "type": "int"
        }
      },
      "call": {
        "cpp": "Solution().generateMatrix({n})",
        "rust": "Solution::generate_matrix({n})",
        "python3": "Solution().generateMatrix({n})",
        "python2": "Solution().generateMatrix({n})",
        "ruby": "generate_matrix({n})",
        "java": "new Solution().generateMatrix({n})",
        "csharp": "new Solution().GenerateMatrix({n})",
        "kotlin": "Solution().generateMatrix({n})",
        "go": "generateMatrix({n})",
        "dart": "Solution().generateMatrix({n})",
        "swift": "Solution().generateMatrix({n})",
        "typescript": "generateMatrix({n})"
      }
