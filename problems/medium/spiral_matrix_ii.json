    "judge": {
      "type": "custom"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().generateMatrix(n, {result})",
        "checker": "class Checker:\n    def generateMatrix(self, n, result):\n        if not isinstance(n, int) or not isinstance(result, list):\n            return False\n        if n < 1 or len(result) != n:\n            return False\n        expected = [[0 for _ in range(n)] for _ in range(n)]\n        x = 0\n        y = 0\n        dx = 1\n        dy = 0\n        for value in range(1, n * n + 1):\n            expected[y][x] = value\n            if not 0 <= x + dx < n or not 0 <= y + dy < n or expected[y + dy][x + dx] != 0:\n                dx, dy = -dy, dx\n            x += dx\n            y += dy\n        return result == expected\n"
      }
    },
