    "oracle": {
      "python3": {
        "call": "Checker().pacificAtlantic(heights, {result})",
        "checker": "class Checker:\n    def pacificAtlantic(self, heights, result):\n        if not isinstance(result, list):\n            return False\n        if not heights or not heights[0]:\n            return result == []\n\n        m = len(heights)\n        n = len(heights[0])\n        for row in heights:\n            if not isinstance(row, list) or len(row) != n:\n                return False\n\n        seen = set()\n        for cell in result:\n            if not isinstance(cell, list) or len(cell) != 2:\n                return False\n            r, c = cell\n            if not isinstance(r, int) or not isinstance(c, int):\n                return False\n            if r < 0 or r >= m or c < 0 or c >= n:\n                return False\n            seen.add((r, c))\n        if len(seen) != len(result):\n            return False\n\n        def reachable(starts):\n            stack = list(starts)\n            visited = set(starts)\n            while stack:\n                r, c = stack.pop()\n                h = heights[r][c]\n                if r > 0 and (r - 1, c) not in visited and heights[r - 1][c] >= h:\n                    visited.add((r - 1, c))\n                    stack.append((r - 1, c))\n                if r + 1 < m and (r + 1, c) not in visited and heights[r + 1][c] >= h:\n                    visited.add((r + 1, c))\n                    stack.append((r + 1, c))\n                if c > 0 and (r, c - 1) not in visited and heights[r][c - 1] >= h:\n                    visited.add((r, c - 1))\n                    stack.append((r, c - 1))\n                if c + 1 < n and (r, c + 1) not in visited and heights[r][c + 1] >= h:\n                    visited.add((r, c + 1))\n                    stack.append((r, c + 1))\n            return visited\n\n        pacific = reachable([(0, c) for c in range(n)] + [(r, 0) for r in range(m)])\n        atlantic = reachable([(m - 1, c) for c in range(n)] + [(r, n - 1) for r in range(m)])\n        expected = pacific & atlantic\n        return seen == expected\n"
      }
    },
