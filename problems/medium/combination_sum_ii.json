    "oracle": {
      "python3": {
        "call": "Checker().combinationSum2(candidates, target, {result})",
        "checker": "class Checker:\n    def combinationSum2(self, candidates, target, result) -> bool:\n        if not isinstance(result, list):\n            return False\n\n        def normalize_combo(combo):\n            if not isinstance(combo, list):\n                return None\n            if any((not isinstance(x, int)) for x in combo):\n                return None\n            if any(combo[i] > combo[i + 1] for i in range(len(combo) - 1)):\n                return None\n            return tuple(combo)\n\n        seen = set()\n        normalized = []\n        for combo in result:\n            norm = normalize_combo(combo)\n            if norm is None:\n                return False\n            if sum(norm) != target:\n                return False\n            used = {}\n            for x in norm:\n                used[x] = used.get(x, 0) + 1\n            for x, cnt in used.items():\n                if cnt > candidates.count(x):\n                    return False\n            if norm in seen:\n                return False\n            seen.add(norm)\n            normalized.append(norm)\n\n        expected = []\n        n = len(candidates)\n        candidates = sorted(candidates)\n\n        def backtrack(start, remaining, path):\n            if remaining == 0:\n                expected.append(tuple(path))\n                return\n            prev = None\n            for i in range(start, n):\n                x = candidates[i]\n                if prev == x:\n                    continue\n                if x > remaining:\n                    break\n                path.append(x)\n                backtrack(i + 1, remaining - x, path)\n                path.pop()\n                prev = x\n\n        backtrack(0, target, [])\n        return set(normalized) == set(expected)\n"
      }
    },
