    "oracle": {
      "python3": {
        "call": "Checker().countSubstrings(s, {result})",
        "checker": "class Checker:\n    def countSubstrings(self, s, result):\n        if not isinstance(result, int):\n            return False\n        total = 0\n        n = len(s)\n        for center in range(n):\n            left = center\n            right = center\n            while left >= 0 and right < n and s[left] == s[right]:\n                total += 1\n                left -= 1\n                right += 1\n            left = center\n            right = center + 1\n            while left >= 0 and right < n and s[left] == s[right]:\n                total += 1\n                left -= 1\n                right += 1\n        return total == result\n"
      }
    },
