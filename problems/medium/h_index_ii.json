      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().hIndex(citations, {result})",
        "checker": "class Checker:\n    def hIndex(self, citations, result):\n        if not isinstance(result, int):\n            return False\n        n = len(citations)\n        if result < 0 or result > n:\n            return False\n        if any(citations[i] > citations[i + 1] for i in range(n - 1)):\n            return False\n        cnt = sum(1 for c in citations if c >= result)\n        if cnt < result:\n            return False\n        if result < n and sum(1 for c in citations if c >= result + 1) >= result + 1:\n            return False\n        return True\n"
      }
    },
