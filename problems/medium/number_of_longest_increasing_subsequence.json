    "oracle": {
      "python3": {
        "call": "Checker().findNumberOfLIS(nums, {result})",
        "checker": "class Checker:\n    def findNumberOfLIS(self, nums, result):\n        n = len(nums)\n        if n == 0:\n            return result == 0\n\n        lengths = [1] * n\n        counts = [1] * n\n        for i in range(n):\n            for j in range(i):\n                if nums[j] < nums[i]:\n                    if lengths[j] + 1 > lengths[i]:\n                        lengths[i] = lengths[j] + 1\n                        counts[i] = counts[j]\n                    elif lengths[j] + 1 == lengths[i]:\n                        counts[i] += counts[j]\n\n        max_length = max(lengths)\n        expected = sum(counts[i] for i in range(n) if lengths[i] == max_length)\n        return result == expected and isinstance(result, int)\n"
      }
    },
