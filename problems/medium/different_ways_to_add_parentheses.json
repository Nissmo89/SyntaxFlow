    "oracle": {
      "python3": {
        "call": "Checker().diffWaysToCompute(expression, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def diffWaysToCompute(self, expression, result):\n        if not isinstance(result, list):\n            return False\n        if any(not isinstance(x, int) for x in result):\n            return False\n\n        def solve(expr):\n            if expr.isdigit():\n                return [int(expr)]\n\n            res = []\n            for i, ch in enumerate(expr):\n                if ch in '+-*':\n                    left = solve(expr[:i])\n                    right = solve(expr[i + 1:])\n                    for a in left:\n                        for b in right:\n                            if ch == '+':\n                                res.append(a + b)\n                            elif ch == '-':\n                                res.append(a - b)\n                            else:\n                                res.append(a * b)\n            return res\n\n        return Counter(result) == Counter(solve(expression))\n"
      }
    },
