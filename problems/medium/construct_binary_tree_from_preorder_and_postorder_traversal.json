    "oracle": {
      "python3": {
        "call": "Checker().check(preorder, postorder, {result})",
        "checker": "from collections import deque\nfrom typing import Any, List, Optional\n\nclass Checker:\n    def _build_expected(self, preorder, postorder):\n        idx = [0]\n\n        def build(l, h):\n            if idx[0] >= len(preorder) or l > h:\n                return None\n            root = TreeNode(preorder[idx[0]])\n            idx[0] += 1\n            if l == h:\n                return root\n            if idx[0] >= len(preorder):\n                return root\n            i = l\n            while i <= h and postorder[i] != preorder[idx[0]]:\n                i += 1\n            if i <= h:\n                root.left = build(l, i)\n                root.right = build(i + 1, h - 1)\n            return root\n\n        return build(0, len(postorder) - 1)\n\n    def _from_bfs(self, arr):\n        if not arr:\n            return None\n        nodes = [None if v is None else TreeNode(v) for v in arr]\n        q = deque([nodes[0]])\n        i = 1\n        while q and i < len(nodes):\n            node = q.popleft()\n            if node is None:\n                continue\n            if i < len(nodes):\n                node.left = nodes[i]\n                q.append(nodes[i])\n                i += 1\n            if i < len(nodes):\n                node.right = nodes[i]\n                q.append(nodes[i])\n                i += 1\n        return nodes[0]\n\n    def _normalize(self, result):\n        if result is None:\n            return None\n        if isinstance(result, list):\n            return self._from_bfs(result)\n        if isinstance(result, dict):\n            def build(node):\n                if node is None:\n                    return None\n                value = node.get(\"val\", node.get(\"value\"))\n                root = TreeNode(value)\n                root.left = build(node.get(\"left\"))\n                root.right = build(node.get(\"right\"))\n                return root\n            return build(result)\n        if hasattr(result, \"val\"):\n            return result\n        return None\n\n    def _preorder(self, root):\n        out = []\n        def dfs(node):\n            if not node:\n                return\n            out.append(node.val)\n            dfs(node.left)\n            dfs(node.right)\n        dfs(root)\n        return out\n\n    def _postorder(self, root):\n        out = []\n        def dfs(node):\n            if not node:\n                return\n            dfs(node.left)\n            dfs(node.right)\n            out.append(node.val)\n        dfs(root)\n        return out\n\n    def _validate_distinct(self, root):\n        seen = set()\n        stack = [root]\n        while stack:\n            node = stack.pop()\n            if not node:\n                continue\n            if node.val in seen:\n                return False\n            seen.add(node.val)\n            stack.append(node.left)\n            stack.append(node.right)\n        return True\n\n    def check(self, preorder, postorder, result):\n        actual = self._normalize(result)\n        if actual is None:\n            return False\n        if not self._validate_distinct(actual):\n            return False\n        return self._preorder(actual) == preorder and self._postorder(actual) == postorder\n"
      }
    },
