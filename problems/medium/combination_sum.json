    "limits": {
      "time_ms": 2000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().combinationSum(candidates, target, {result})",
        "checker": "class Checker:\n    def combinationSum(self, candidates, target, result):\n        if not isinstance(result, list):\n            return False\n        cand_set = set(candidates)\n        if len(cand_set) != len(candidates):\n            return False\n        normalized = []\n        seen = set()\n        for comb in result:\n            if not isinstance(comb, list):\n                return False\n            if any(not isinstance(x, int) for x in comb):\n                return False\n            if any(x not in cand_set for x in comb):\n                return False\n            if sum(comb) != target:\n                return False\n            key = tuple(sorted(comb))\n            if key in seen:\n                return False\n            seen.add(key)\n            normalized.append(key)\n        expected = []\n        candidates = sorted(candidates)\n\n        def dfs(start, path, total):\n            if total == target:\n                expected.append(tuple(path))\n                return\n            for i in range(start, len(candidates)):\n                v = candidates[i]\n                nt = total + v\n                if nt > target:\n                    break\n                path.append(v)\n                dfs(i, path, nt)\n                path.pop()\n\n        dfs(0, [], 0)\n        return set(normalized) == set(expected)\n"
      }
    },
