    "oracle": {
      "python3": {
        "call": "Checker().canPartition(nums, {result})",
        "checker": "class Checker:\n    def canPartition(self, nums, result):\n        if not isinstance(result, bool):\n            return False\n        total_sum = sum(nums)\n        if total_sum % 2 != 0:\n            return result is False\n        target = total_sum // 2\n        dp = [False] * (target + 1)\n        dp[0] = True\n        for num in nums:\n            for curr_sum in range(target, num - 1, -1):\n                dp[curr_sum] = dp[curr_sum] or dp[curr_sum - num]\n        return result == dp[target]\n"
      }
    },
