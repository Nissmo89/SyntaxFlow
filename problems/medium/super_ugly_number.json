    "oracle": {
      "python3": {
        "call": "Checker().nthSuperUglyNumber(n, primes, {result})",
        "checker": "class Checker:\n    def nthSuperUglyNumber(self, n, primes, result):\n        if not isinstance(n, int) or not isinstance(primes, list) or not isinstance(result, int):\n            return False\n        if n < 1 or len(primes) < 1:\n            return False\n        if primes != sorted(primes) or len(set(primes)) != len(primes):\n            return False\n        if any((not isinstance(p, int) or p < 2) for p in primes):\n            return False\n        ugly = [1] * n\n        idx = [0] * len(primes)\n        val = primes[:]\n        for i in range(1, n):\n            m = min(val)\n            ugly[i] = m\n            for j, p in enumerate(primes):\n                if val[j] == m:\n                    idx[j] += 1\n                    val[j] = ugly[idx[j]] * p\n        return ugly[-1] == result\n"
      }
    },
