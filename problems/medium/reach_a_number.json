    "oracle": {
      "python3": {
        "call": "Checker().check(target, {result})",
        "checker": "class Checker:\n    def check(self, target, result):\n        if not isinstance(result, int):\n            return False\n        if target == 0:\n            return False\n        if result < 0:\n            return False\n\n        target = abs(target)\n        total = result * (result + 1) // 2\n        if total < target:\n            return False\n        if (total - target) % 2 != 0:\n            return False\n\n        prev = (result - 1) * result // 2\n        if result > 0 and prev >= target and (prev - target) % 2 == 0:\n            return False\n\n        return True\n"
      }
    },
