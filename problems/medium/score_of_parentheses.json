    "oracle": {
      "python3": {
        "call": "Checker().scoreOfParentheses(s, {result})",
        "checker": "class Checker:\n    def scoreOfParentheses(self, s, result):\n        if not isinstance(result, int):\n            return False\n        score_stack = [0]\n        for ch in s:\n            if ch == \"(\":\n                score_stack.append(0)\n            else:\n                last_score = score_stack.pop()\n                score_stack[-1] += max(1, last_score * 2)\n        return result == score_stack[-1]\n"
      }
    },
