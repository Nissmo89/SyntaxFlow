    "oracle": {
      "python3": {
        "call": "Checker().carFleet(target, position, speed, {result})",
        "checker": "class Checker:\n    def carFleet(self, target, position, speed, result):\n        if not isinstance(result, int):\n            return False\n        cars = sorted(zip(position, speed), reverse=True)\n        fleets = 0\n        last_time = -1\n        for p, s in cars:\n            t = (target - p) / s\n            if t > last_time:\n                fleets += 1\n                last_time = t\n        return result == fleets\n"
      }
    },
