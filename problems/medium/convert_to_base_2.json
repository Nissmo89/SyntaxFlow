    "oracle": {
      "python3": {
        "call": "Checker().check(n, {result})",
        "checker": "class Checker:\n    def check(self, n, result):\n        if n == 0:\n            return result == \"0\"\n        digits = []\n        while n:\n            n, r = divmod(n, -2)\n            if r < 0:\n                n += 1\n                r += 2\n            digits.append(str(r))\n        return ''.join(reversed(digits)) == result\n"
      }
    },
