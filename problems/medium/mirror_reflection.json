    "oracle": {
      "python3": {
        "call": "Checker().mirrorReflection(p, q, {result})",
        "checker": "class Checker:\n    def mirrorReflection(self, p, q, result):\n        import math\n        g = math.lcm(p, q)\n        m = g // p\n        n = g // q\n        if m % 2 == 1 and n % 2 == 1:\n            expected = 1\n        elif m % 2 == 1 and n % 2 == 0:\n            expected = 2\n        else:\n            expected = 0\n        return expected == result\n"
      }
    },
