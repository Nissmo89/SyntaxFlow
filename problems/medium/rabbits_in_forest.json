    "oracle": {
      "python3": {
        "call": "Checker().numRabbits(answers, {result})",
        "checker": "from collections import Counter\nfrom math import ceil\n\nclass Checker:\n    def numRabbits(self, answers, result):\n        if not isinstance(result, int):\n            return False\n        if not isinstance(answers, list):\n            return False\n        if any(not isinstance(x, int) for x in answers):\n            return False\n        total = 0\n        counts = Counter(answers)\n        for x, c in counts.items():\n            if x < 0:\n                return False\n            total += ceil(c / (x + 1)) * (x + 1)\n        return result == total\n"
      }
    },
