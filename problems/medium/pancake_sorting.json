    "oracle": {
      "python3": {
        "call": "Checker().pancakeSort(arr, {result})",
        "checker": "class Checker:\n    def pancakeSort(self, arr, result):\n        if not isinstance(result, list):\n            return False\n        work = list(arr)\n        n = len(work)\n        for k in result:\n            if not isinstance(k, int) or k < 1 or k > n:\n                return False\n            work[:k] = reversed(work[:k])\n        return work == sorted(arr)\n"
      }
    },
