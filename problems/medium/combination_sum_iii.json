    "oracle": {
      "python3": {
        "call": "Checker().combinationSum3(k, n, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def combinationSum3(self, k: int, n: int, result: Any) -> bool:\n        if not isinstance(result, list):\n            return False\n\n        seen = set()\n        total_valid = 0\n        for combo in result:\n            if not isinstance(combo, list) or len(combo) != k:\n                return False\n            if any(not isinstance(x, int) for x in combo):\n                return False\n            if any(x < 1 or x > 9 for x in combo):\n                return False\n            if any(combo[i] >= combo[i + 1] for i in range(len(combo) - 1)):\n                return False\n            if sum(combo) != n:\n                return False\n            key = tuple(combo)\n            if key in seen:\n                return False\n            seen.add(key)\n            total_valid += 1\n\n        nums = list(range(1, 10))\n        expected = []\n\n        def backtrack(start: int, path: List[int], remaining_k: int, remaining_n: int) -> None:\n            if remaining_k == 0:\n                if remaining_n == 0:\n                    expected.append(tuple(path))\n                return\n            for i in range(start, 10):\n                if i > remaining_n:\n                    break\n                path.append(i)\n                backtrack(i + 1, path, remaining_k - 1, remaining_n - i)\n                path.pop()\n\n        backtrack(1, [], k, n)\n        return set(expected) == seen\n"
      }
    },
