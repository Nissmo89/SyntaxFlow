      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().wordSubsets(words1, words2, {result})",
        "checker": "class Checker:\n    def wordSubsets(self, words1, words2, result):\n        need = [0] * 26\n        for w in words2:\n            cnt = [0] * 26\n            for ch in w:\n                cnt[ord(ch) - 97] += 1\n            for i in range(26):\n                if cnt[i] > need[i]:\n                    need[i] = cnt[i]\n        got = []\n        for w in words1:\n            cnt = [0] * 26\n            for ch in w:\n                cnt[ord(ch) - 97] += 1\n            if all(cnt[i] >= need[i] for i in range(26)):\n                got.append(w)\n        return sorted(got) == sorted(result)\n"
      }
    },
