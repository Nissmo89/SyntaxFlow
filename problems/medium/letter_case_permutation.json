    "oracle": {
      "python3": {
        "call": "Checker().letterCasePermutation(s, {result})",
        "checker": "class Checker:\n    def letterCasePermutation(self, s, result):\n        if not isinstance(result, list):\n            return False\n        if any(not isinstance(x, str) for x in result):\n            return False\n\n        expected = set()\n\n        def build(i: int, cur: str) -> None:\n            if i == len(s):\n                expected.add(cur)\n                return\n            ch = s[i]\n            if ch.isdigit():\n                build(i + 1, cur + ch)\n            elif ch.isalpha():\n                build(i + 1, cur + ch.lower())\n                build(i + 1, cur + ch.upper())\n            else:\n                return\n\n        build(0, \"\")\n        if len(expected) != len(result):\n            return False\n        if len(set(result)) != len(result):\n            return False\n        if set(result) != expected:\n            return False\n\n        for cand in result:\n            if len(cand) != len(s):\n                return False\n            for a, b in zip(s, cand):\n                if a.isdigit():\n                    if a != b:\n                        return False\n                elif a.isalpha():\n                    if a.lower() != b.lower():\n                        return False\n                else:\n                    return False\n        return True\n"
      }
    },
