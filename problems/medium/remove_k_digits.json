    "oracle": {
      "python3": {
        "call": "Checker().removeKdigits(num, k, {result})",
        "checker": "class Checker:\n    def removeKdigits(self, num, k, result):\n        if not isinstance(num, str) or not isinstance(k, int) or not isinstance(result, str):\n            return False\n        if not num or not num.isdigit():\n            return False\n        if k < 1 or k > len(num):\n            return False\n        if len(num) > 1 and num[0] == '0':\n            return False\n        stack = []\n        kk = k\n        for ch in num:\n            while kk and stack and stack[-1] > ch:\n                stack.pop()\n                kk -= 1\n            stack.append(ch)\n        expected = ''.join(stack[:len(stack) - kk]).lstrip('0') or '0'\n        if result == '':\n            return False\n        return result == expected and (result == '0' or result[0] != '0')\n"
      }
    },
