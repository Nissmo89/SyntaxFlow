    "oracle": {
      "python3": {
        "call": "Checker().gardenNoAdj(n, paths, {result})",
        "checker": "class Checker:\n    def gardenNoAdj(self, n, paths, result):\n        if not isinstance(result, list) or len(result) != n:\n            return False\n        if any((not isinstance(x, int)) or x < 1 or x > 4 for x in result):\n            return False\n        for u, v in paths:\n            if result[u - 1] == result[v - 1]:\n                return False\n        return True\n"
      }
    },
