      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().maxArea({height}, {result})",
        "checker": "class Checker:\n    def maxArea(self, height, result):\n        left = 0\n        right = len(height) - 1\n        best = 0\n\n        while left < right:\n            best = max(best, min(height[left], height[right]) * (right - left))\n            if height[left] < height[right]:\n                left += 1\n            else:\n                right -= 1\n\n        return best == result\n"
      }
    },
