    "oracle": {
      "python3": {
        "call": "Checker().mincostToHireWorkers(quality, wage, k, {result})",
        "checker": "import heapq\n\nclass Checker:\n    def mincostToHireWorkers(self, quality, wage, k, result):\n        workers = sorted((w / q, q) for w, q in zip(wage, quality))\n        total = 0\n        heap = []\n        best = float('inf')\n        for ratio, q in workers:\n            total += q\n            heapq.heappush(heap, -q)\n            if len(heap) > k:\n                total += heapq.heappop(heap)\n            if len(heap) == k:\n                best = min(best, ratio * total)\n        return abs(best - result) <= 1e-5\n"
      }
    },
