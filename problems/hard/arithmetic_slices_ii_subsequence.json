    "oracle": {
      "python3": {
        "call": "Checker().numberOfArithmeticSlices(nums, {result})",
        "checker": "from collections import defaultdict\n\nclass Checker:\n    def numberOfArithmeticSlices(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        n = len(nums)\n        total_count = 0\n        dp = [defaultdict(int) for _ in range(n)]\n        for i in range(1, n):\n            for j in range(i):\n                diff = nums[i] - nums[j]\n                dp[i][diff] += 1\n                if diff in dp[j]:\n                    dp[i][diff] += dp[j][diff]\n                    total_count += dp[j][diff]\n        return result == total_count\n"
      }
    },
