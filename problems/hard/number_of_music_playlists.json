    "oracle": {
      "python3": {
        "call": "Checker().numMusicPlaylists(n, goal, k, {result})",
        "checker": "class Checker:\n    def numMusicPlaylists(self, n, goal, k, result):\n        if not isinstance(result, int):\n            return False\n        MOD = 10**9 + 7\n        dp = [[0 for _ in range(n + 1)] for _ in range(2)]\n        dp[0][0] = 1\n        for i in range(1, goal + 1):\n            dp[i % 2][0] = 0\n            for j in range(1, min(i, n) + 1):\n                dp[i % 2][j] = dp[(i - 1) % 2][j - 1] * (n - (j - 1)) % MOD\n                if j > k:\n                    dp[i % 2][j] = (dp[i % 2][j] + dp[(i - 1) % 2][j] * (j - k)) % MOD\n        return result == dp[goal % 2][n]\n"
      }
    },
