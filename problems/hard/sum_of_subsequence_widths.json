    "oracle": {
      "python3": {
        "call": "Checker().sumSubseqWidths(nums, {result})",
        "checker": "class Checker:\n    def sumSubseqWidths(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        MOD = 1_000_000_007\n        nums = sorted(nums)\n        n = len(nums)\n        pow2 = [1] * n\n        for i in range(1, n):\n            pow2[i] = (pow2[i - 1] * 2) % MOD\n        ans = 0\n        for i, x in enumerate(nums):\n            ans = (ans + x * (pow2[i] - pow2[n - 1 - i])) % MOD\n        return ans == result % MOD\n"
      }
    },
