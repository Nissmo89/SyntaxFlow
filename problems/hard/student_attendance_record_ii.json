    "oracle": {
      "python3": {
        "call": "Checker().check(n, {result})",
        "checker": "class Checker:\n    def check(self, n, result):\n        if not isinstance(result, int):\n            return False\n        mod = 1000000007\n        dp = [[0, 0, 0], [0, 0, 0]]\n        dp[0][0] = 1\n        for _ in range(n):\n            ndp = [[0, 0, 0], [0, 0, 0]]\n            for absences in range(2):\n                for lates in range(3):\n                    cur = dp[absences][lates]\n                    if cur == 0:\n                        continue\n                    ndp[absences][0] = (ndp[absences][0] + cur) % mod\n                    if absences == 0:\n                        ndp[1][0] = (ndp[1][0] + cur) % mod\n                    if lates < 2:\n                        ndp[absences][lates + 1] = (ndp[absences][lates + 1] + cur) % mod\n            dp = ndp\n        expected = 0\n        for row in dp:\n            for value in row:\n                expected = (expected + value) % mod\n        return result == expected\n"
      }
    },
