    "oracle": {
      "python3": {
        "call": "Checker().reachableNodes(edges, maxMoves, n, {result})",
        "checker": "from heapq import heappop, heappush\n\nclass Checker:\n    def reachableNodes(self, edges, maxMoves, n, result):\n        graph = [[] for _ in range(n)]\n        dist = [maxMoves + 1] * n\n        for u, v, cnt in edges:\n            graph[u].append((v, cnt))\n            graph[v].append((u, cnt))\n        dist[0] = 0\n        heap = [(0, 0)]\n        while heap:\n            d, u = heappop(heap)\n            if d != dist[u] or d >= maxMoves:\n                continue\n            for v, w in graph[u]:\n                nd = d + w + 1\n                if nd < dist[v]:\n                    dist[v] = nd\n                    heappush(heap, (nd, v))\n        reachable = sum(d <= maxMoves for d in dist)\n        sub = 0\n        for u, v, cnt in edges:\n            a = 0 if dist[u] > maxMoves else min(maxMoves - dist[u], cnt)\n            b = 0 if dist[v] > maxMoves else min(maxMoves - dist[v], cnt)\n            sub += min(a + b, cnt)\n        return reachable + sub == result\n"
      }
    },
