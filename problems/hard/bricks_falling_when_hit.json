    "oracle": {
      "python3": {
        "call": "Checker().check(grid, hits, {result})",
        "checker": "class Checker:\n    def check(self, grid, hits, result):\n        rows = len(grid)\n        cols = len(grid[0])\n        work = [row[:] for row in grid]\n        for r, c in hits:\n            if 0 <= r < rows and 0 <= c < cols:\n                work[r][c] -= 1\n\n        parent = list(range(rows * cols + 1))\n        size = [1] * (rows * cols + 1)\n        roof = rows * cols\n\n        def idx(r, c):\n            return r * cols + c\n\n        def find(x):\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]\n                x = parent[x]\n            return x\n\n        def union(a, b):\n            ra = find(a)\n            rb = find(b)\n            if ra == rb:\n                return\n            if size[ra] < size[rb]:\n                ra, rb = rb, ra\n            parent[rb] = ra\n            size[ra] += size[rb]\n\n        def roof_size():\n            return size[find(roof)]\n\n        for r in range(rows):\n            for c in range(cols):\n                if work[r][c] != 1:\n                    continue\n                if r == 0:\n                    union(idx(r, c), roof)\n                if r > 0 and work[r - 1][c] == 1:\n                    union(idx(r, c), idx(r - 1, c))\n                if c > 0 and work[r][c - 1] == 1:\n                    union(idx(r, c), idx(r, c - 1))\n\n        ans = [0] * len(hits)\n        for i in range(len(hits) - 1, -1, -1):\n            r, c = hits[i]\n            if grid[r][c] == 0:\n                continue\n            prev = roof_size()\n            work[r][c] += 1\n            if work[r][c] != 1:\n                continue\n            cur = idx(r, c)\n            if r == 0:\n                union(cur, roof)\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                nr, nc = r + dr, c + dc\n                if 0 <= nr < rows and 0 <= nc < cols and work[nr][nc] == 1:\n                    union(cur, idx(nr, nc))\n            ans[i] = max(0, roof_size() - prev - 1)\n\n        return result == ans\n"
      }
    },
