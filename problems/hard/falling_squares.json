    "oracle": {
      "python3": {
        "call": "Checker().fallingSquares(positions, result)",
        "checker": "class Checker:\n    def fallingSquares(self, positions, result):\n        if not isinstance(result, list):\n            return False\n        if len(result) != len(positions):\n            return False\n        cur = []\n        expected = []\n        best = 0\n        for left, side in positions:\n            right = left + side\n            height = 0\n            for l, r, h in cur:\n                if l < right and left < r:\n                    if h > height:\n                        height = h\n            height += side\n            cur.append((left, right, height))\n            if height > best:\n                best = height\n            expected.append(best)\n        return expected == result\n"
      }
    },
