    "oracle": {
      "python3": {
        "call": "Checker().check(nums1, nums2, {result})",
        "checker": "class Checker:\n    def check(self, nums1, nums2, result):\n        n = len(nums1)\n        inf = 10 ** 9\n        keep = [inf] * n\n        swap = [inf] * n\n        keep[0] = 0\n        swap[0] = 1\n        for i in range(1, n):\n            inc = nums1[i] > nums1[i - 1] and nums2[i] > nums2[i - 1]\n            cross = nums1[i] > nums2[i - 1] and nums2[i] > nums1[i - 1]\n            if inc and cross:\n                keep[i] = min(keep[i - 1], swap[i - 1])\n                swap[i] = keep[i] + 1\n            elif inc:\n                keep[i] = keep[i - 1]\n                swap[i] = swap[i - 1] + 1\n            else:\n                keep[i] = swap[i - 1]\n                swap[i] = keep[i - 1] + 1\n        return int(result) == min(keep[-1], swap[-1])\n"
      }
    },
