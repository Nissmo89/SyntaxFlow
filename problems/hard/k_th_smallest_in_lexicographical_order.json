    "oracle": {
      "python3": {
        "call": "Checker().findKthNumber(n, k, {result})",
        "checker": "class Checker:\n    def findKthNumber(self, n, k, result):\n        if not isinstance(result, int):\n            return False\n        if not (1 <= k <= n <= 1000000000):\n            return False\n        curr = 1\n        kk = k - 1\n\n        def count(prefix, limit):\n            cur = prefix\n            nxt = prefix + 1\n            total = 0\n            while cur <= limit:\n                total += min(limit + 1, nxt) - cur\n                cur *= 10\n                nxt *= 10\n            return total\n\n        while kk > 0:\n            c = count(curr, n)\n            if c <= kk:\n                curr += 1\n                kk -= c\n            else:\n                curr *= 10\n                kk -= 1\n        return curr == result\n"
      }
    },
