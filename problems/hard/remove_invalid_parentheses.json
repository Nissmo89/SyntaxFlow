    "oracle": {
      "python3": {
        "call": "Checker().removeInvalidParentheses(s, {result})",
        "checker": "class Checker:\n    def removeInvalidParentheses(self, s, result):\n        if not isinstance(result, list):\n            return False\n        if any(not isinstance(x, str) for x in result):\n            return False\n        if len(result) != len(set(result)):\n            return False\n\n        def is_valid(text):\n            bal = 0\n            for ch in text:\n                if ch == \"(\":\n                    bal += 1\n                elif ch == \")\":\n                    bal -= 1\n                    if bal < 0:\n                        return False\n            return bal == 0\n\n        level = {s}\n        while True:\n            valid = {x for x in level if is_valid(x)}\n            if valid:\n                return set(result) == valid\n            next_level = set()\n            for text in level:\n                for i, ch in enumerate(text):\n                    if ch in \"()\":\n                        next_level.add(text[:i] + text[i + 1:])\n            level = next_level\n"
      }
    },
