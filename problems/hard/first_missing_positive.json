    "oracle": {
      "python3": {
        "call": "Checker().check(nums, {result})",
        "checker": "class Checker:\n    def check(self, nums, result):\n        if not isinstance(result, int):\n            return False\n        if result <= 0:\n            return False\n        seen = set(nums)\n        if result in seen:\n            return False\n        for value in range(1, result):\n            if value not in seen:\n                return False\n        return True\n"
      }
    },
