    "oracle": {
      "python3": {
        "call": "Checker().countTheRepetitions(s1, n1, s2, n2, {result})",
        "checker": "class Checker:\n    def countTheRepetitions(self, s1, n1, s2, n2, result):\n        def solve(S, n1, T, n2):\n            m, n = len(S), len(T)\n            if m * n1 < n * n2:\n                return 0\n            j = 0\n            cnt = 0\n            k = 0\n            seen = {}\n            while k < n1:\n                for ch in S:\n                    if ch == T[j]:\n                        j += 1\n                        if j == n:\n                            cnt += 1\n                            j = 0\n                k += 1\n                if j in seen:\n                    prev_cnt, prev_k = seen[j]\n                    period_k = k - prev_k\n                    period_cnt = cnt - prev_cnt\n                    if period_cnt == 0:\n                        break\n                    remaining = n1 - k\n                    cycles = remaining // period_k\n                    cnt += cycles * period_cnt\n                    k += cycles * period_k\n                else:\n                    seen[j] = (cnt, k)\n            return cnt // n2\n\n        return isinstance(result, int) and result == solve(s1, n1, s2, n2)\n"
      }
    },
