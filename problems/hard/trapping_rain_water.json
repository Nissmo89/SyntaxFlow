    "seed": 42,
    "oracle": {
      "python3": {
        "call": "Checker().trap(height, {result})",
        "checker": "class Checker:\n    def trap(self, height, result):\n        if not isinstance(result, int):\n            return False\n        if len(height) < 1:\n            return False\n        start = 0\n        end = len(height) - 1\n        left_max = 0\n        right_max = 0\n        total = 0\n        while start < end:\n            left_max = max(left_max, height[start])\n            right_max = max(right_max, height[end])\n            if left_max < right_max:\n                total += left_max - height[start]\n                start += 1\n            else:\n                total += right_max - height[end]\n                end -= 1\n        return total == result\n"
      }
    },
