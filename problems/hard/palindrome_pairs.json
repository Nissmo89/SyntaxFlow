      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(words, {result})",
        "checker": "class Checker:\n    def check(self, words, result):\n        if not isinstance(result, list):\n            return False\n        seen = set()\n        normalized = []\n        for item in result:\n            if (\n                not isinstance(item, list)\n                or len(item) != 2\n                or not all(isinstance(x, int) for x in item)\n            ):\n                return False\n            pair = (item[0], item[1])\n            if pair in seen:\n                return False\n            seen.add(pair)\n            normalized.append(pair)\n\n        n = len(words)\n        expected = set()\n        for i in range(n):\n            for j in range(n):\n                if i != j and words[i] + words[j] == (words[i] + words[j])[::-1]:\n                    expected.add((i, j))\n\n        return seen == expected\n"
      }
    },
