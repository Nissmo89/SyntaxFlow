      "type": "exact"
    },
    "limits": {
      "time_ms": 3000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().smallestSufficientTeam(req_skills, people, {result})",
        "checker": "class Checker:\n    def smallestSufficientTeam(self, req_skills, people, result):\n        if not isinstance(result, list):\n            return False\n        if any(type(index) is not int for index in result):\n            return False\n        if len(set(result)) != len(result):\n            return False\n        if any(index < 0 or index >= len(people) for index in result):\n            return False\n\n        skill_index = {skill: i for i, skill in enumerate(req_skills)}\n        full = (1 << len(req_skills)) - 1\n\n        def person_mask(skills):\n            mask = 0\n            for skill in skills:\n                if skill in skill_index:\n                    mask |= 1 << skill_index[skill]\n            return mask\n\n        masks = [person_mask(skills) for skills in people]\n        covered = 0\n        for index in result:\n            covered |= masks[index]\n        if covered != full:\n            return False\n\n        best = {0: 0}\n        for mask in masks:\n            next_best = dict(best)\n            for covered_mask, size in best.items():\n                combined = covered_mask | mask\n                candidate = size + 1\n                if candidate < next_best.get(combined, len(people) + 1):\n                    next_best[combined] = candidate\n            best = next_best\n        return len(result) == best.get(full)\n"
      }
    },
