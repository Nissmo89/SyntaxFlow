    "oracle": {
      "python3": {
        "call": "Checker().maxCoins(nums, {result})",
        "checker": "class Checker:\n    def maxCoins(self, nums: List[int], result: Any) -> bool:\n        balloons = [1] + nums + [1]\n        n = len(balloons)\n        dp = [[0] * n for _ in range(n)]\n        for length in range(2, n):\n            for left in range(0, n - length):\n                right = left + length\n                best = 0\n                for k in range(left + 1, right):\n                    total = balloons[left] * balloons[k] * balloons[right] + dp[left][k] + dp[k][right]\n                    if total > best:\n                        best = total\n                dp[left][right] = best\n        return result == dp[0][n - 1]\n"
      }
    },
