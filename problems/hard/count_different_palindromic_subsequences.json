    "oracle": {
      "python3": {
        "call": "Checker().check(s, {result})",
        "checker": "class Checker:\n    def check(self, s, result):\n        if not isinstance(result, int):\n            return False\n        mod = 1000000007\n        n = len(s)\n        if n == 0:\n            return result == 0\n        prev_same = [-1] * n\n        next_same = [n] * n\n        last_seen = {}\n        for i, ch in enumerate(s):\n            prev_same[i] = last_seen.get(ch, -1)\n            last_seen[ch] = i\n        last_seen.clear()\n        for i in range(n - 1, -1, -1):\n            ch = s[i]\n            next_same[i] = last_seen.get(ch, n)\n            last_seen[ch] = i\n        dp = [[0] * n for _ in range(n)]\n        for i in range(n):\n            dp[i][i] = 1\n        for length in range(2, n + 1):\n            for i in range(0, n - length + 1):\n                j = i + length - 1\n                if s[i] != s[j]:\n                    val = dp[i + 1][j] + dp[i][j - 1]\n                    if i + 1 <= j - 1:\n                        val -= dp[i + 1][j - 1]\n                else:\n                    low = next_same[i]\n                    high = prev_same[j]\n                    mid = dp[i + 1][j - 1] if i + 1 <= j - 1 else 0\n                    if low > high:\n                        val = 2 * mid + 2\n                    elif low == high:\n                        val = 2 * mid + 1\n                    else:\n                        inner = dp[low + 1][high - 1] if low + 1 <= high - 1 else 0\n                        val = 2 * mid - inner\n                dp[i][j] = val % mod\n        expected = dp[0][n - 1] % mod\n        return result == expected\n"
      }
    },
