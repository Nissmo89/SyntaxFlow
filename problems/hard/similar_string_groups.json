    "oracle": {
      "python3": {
        "call": "Checker().numSimilarGroups(strs, {result})",
        "checker": "class Checker:\n    def numSimilarGroups(self, strs, result):\n        if not isinstance(result, int):\n            return False\n        n = len(strs)\n        parent = list(range(n))\n\n        def find(x):\n            while parent[x] != x:\n                parent[x] = parent[parent[x]]\n                x = parent[x]\n            return x\n\n        def union(a, b):\n            ra, rb = find(a), find(b)\n            if ra != rb:\n                parent[rb] = ra\n\n        for i in range(n):\n            for j in range(i + 1, n):\n                diff = 0\n                for a, b in zip(strs[i], strs[j]):\n                    if a != b:\n                        diff += 1\n                        if diff > 2:\n                            break\n                if diff == 0 or diff == 2:\n                    union(i, j)\n        expected = len({find(i) for i in range(n)})\n        return result == expected\n"
      }
    },
