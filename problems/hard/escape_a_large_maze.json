    "oracle": {
      "python3": {
        "call": "Checker().isEscapePossible(blocked, source, target, {result})",
        "checker": "from collections import deque\n\nclass Checker:\n    def isEscapePossible(self, blocked, source, target, result):\n        blocked_set = {tuple(p) for p in blocked}\n        limit = len(blocked) * len(blocked) // 2\n\n        def bfs(start, end):\n            start = tuple(start)\n            end = tuple(end)\n            q = deque([start])\n            seen = {start}\n            explored = 0\n            while q:\n                x, y = q.popleft()\n                if (x, y) == end:\n                    return True\n                if explored > limit:\n                    return True\n                for dx, dy in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nx = x + dx\n                    ny = y + dy\n                    if 0 <= nx < 10 ** 6 and 0 <= ny < 10 ** 6:\n                        pos = (nx, ny)\n                        if pos not in seen and pos not in blocked_set:\n                            seen.add(pos)\n                            q.append(pos)\n                explored += 1\n            return False\n\n        expected = bfs(source, target) and bfs(target, source)\n        return expected == result\n"
      }
    },
