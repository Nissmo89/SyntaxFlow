      "type": "exact"
    },
    "limits": {
      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(stickers, target, {result})",
        "checker": "class Checker:\n    def check(self, stickers, target, result):\n        if not isinstance(result, int):\n            return False\n\n        from functools import lru_cache\n        from collections import Counter\n\n        target_counts = Counter(target)\n        needed_chars = sorted(target_counts)\n        if not needed_chars:\n            return result == 0\n\n        sticker_counts = []\n        for s in stickers:\n            counts = Counter(s)\n            sticker_counts.append(tuple(counts.get(ch, 0) for ch in needed_chars))\n\n        @lru_cache(None)\n        def dfs(state):\n            if all(x == 0 for x in state):\n                return 0\n            best = float(\"inf\")\n            first = next(i for i, x in enumerate(state) if x > 0)\n            for sc in sticker_counts:\n                if sc[first] == 0:\n                    continue\n                new_state = []\n                for need, have in zip(state, sc):\n                    new_state.append(max(0, need - have))\n                cand = dfs(tuple(new_state))\n                if cand != float(\"inf\"):\n                    best = min(best, 1 + cand)\n            return best\n\n        start = tuple(target_counts[ch] for ch in needed_chars)\n        expected = dfs(start)\n        if expected == float(\"inf\"):\n            expected = -1\n        return result == expected\n"
      }
    },
