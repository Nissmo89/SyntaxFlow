      "python3": {
        "call": "Checker().wordBreak(s, wordDict, {result})",
        "checker": "import copy\n\n\nfrom typing import *\nfrom collections import *\nimport copy\nimport json\nimport math\nimport bisect\nimport heapq\nimport itertools\nimport functools\n\ndef fun(s,dc,memo):\n    if(s in memo):\n        return memo[s]\n    ans=[]\n    if(dc[s]==1):\n        ans=[s]\n    for i in range(1,len(s)):\n        if(dc[s[:i]]==1):\n            a=fun(s[i:],dc,memo)\n            for x in a:\n                ans.append(s[:i]+\" \"+x)\n    memo[s]=ans\n    return ans\nclass Solution:\n    def wordBreak(self, s: str, wordDict: List[str]) -> List[str]:\n        dc=defaultdict(lambda:0)\n        for a in wordDict:\n            dc[a]=1\n        return(fun(s,dc,{}))\n\n\ndef array_to_list_node_local(values):\n    dummy = ListNode(0)\n    tail = dummy\n    for value in values:\n        tail.next = ListNode(value)\n        tail = tail.next\n    return dummy.next\n\ndef array_to_tree_node_local(values):\n    if not values:\n        return None\n    root = TreeNode(values[0])\n    queue = deque([root])\n    index = 1\n    while queue and index < len(values):\n        node = queue.popleft()\n        if index < len(values) and values[index] is not None:\n            node.left = TreeNode(values[index])\n            queue.append(node.left)\n        index += 1\n        if index < len(values) and values[index] is not None:\n            node.right = TreeNode(values[index])\n            queue.append(node.right)\n        index += 1\n    return root\n\ndef list_node_to_array_local(node):\n    out = []\n    seen = 0\n    while node is not None and seen < 100000:\n        out.append(node.val)\n        node = node.next\n        seen += 1\n    return out\n\ndef tree_node_to_array_local(root):\n    if root is None:\n        return []\n    out = []\n    q = deque([root])\n    while q:\n        node = q.popleft()\n        if node is None:\n            out.append(None)\n            continue\n        out.append(node.val)\n        q.append(node.left)\n        q.append(node.right)\n    while out and out[-1] is None:\n        out.pop()\n    return out\n\ndef deep_sort(value):\n    if isinstance(value, list):\n        normalized = [deep_sort(item) for item in value]\n        return sorted(normalized, key=lambda item: json.dumps(item, sort_keys=True))\n    if isinstance(value, dict):\n        return {key: deep_sort(val) for key, val in sorted(value.items())}\n    return value\n\ndef normalize_expected(value):\n    kind = \"array[string]\"\n    if kind == \"list_node\":\n        return list_node_to_array_local(value)\n    if kind == \"tree_node\":\n        return tree_node_to_array_local(value)\n    return value\n\ndef normalize_actual(value):\n    return value\n\ndef prepare_input(value, kind):\n    if kind == \"tree_node\":\n        return array_to_tree_node_local(value)\n    if kind == \"list_node\":\n        return array_to_list_node_local(value)\n    return copy.deepcopy(value)\n\nclass Checker:\n    def wordBreak(self, s, wordDict, result):\n        prepared_s = prepare_input(s, \"string\"); prepared_wordDict = prepare_input(wordDict, \"array[string]\")\n        expected = Solution().wordBreak(prepared_s, prepared_wordDict)\n        expected = normalize_expected(expected)\n        actual = normalize_actual(result)\n        return deep_sort(expected) == deep_sort(actual)\n"
      }
    },
