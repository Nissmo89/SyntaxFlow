    "oracle": {
      "python3": {
        "call": "Checker().shortestSubarray(nums, k, {result})",
        "checker": "class Checker:\n    def shortestSubarray(self, nums, k, result):\n        if not isinstance(result, int):\n            return False\n        n = len(nums)\n        best = n + 1\n        s = [0]\n        for x in nums:\n            s.append(s[-1] + x)\n        from collections import deque\n        dq = deque()\n        for i, cur in enumerate(s):\n            while dq and cur <= s[dq[-1]]:\n                dq.pop()\n            while dq and cur - s[dq[0]] >= k:\n                best = min(best, i - dq.popleft())\n            dq.append(i)\n        exp = -1 if best == n + 1 else best\n        return result == exp\n"
      }
    },
