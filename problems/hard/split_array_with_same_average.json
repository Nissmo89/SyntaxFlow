    "oracle": {
      "python3": {
        "call": "Checker().check(nums, {result})",
        "checker": "class Checker:\n    def check(self, nums, result):\n        n = len(nums)\n        total = sum(nums)\n        nums = sorted(nums)\n\n        possible = [set() for _ in range(n // 2 + 1)]\n        possible[0].add(0)\n        for x in nums:\n            for size in range(len(possible) - 1, 0, -1):\n                for prev in list(possible[size - 1]):\n                    possible[size].add(prev + x)\n\n        expected = False\n        for size in range(1, n // 2 + 1):\n            if (total * size) % n == 0 and (total * size) // n in possible[size]:\n                expected = True\n                break\n        return bool(result) == expected\n"
      }
    },
