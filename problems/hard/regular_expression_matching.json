    "oracle": {
      "python3": {
        "call": "Checker().isMatch(s, p, {result})",
        "checker": "class Checker:\n    def isMatch(self, s, p, result):\n        m, n = len(s), len(p)\n        dp = [[False] * (n + 1) for _ in range(m + 1)]\n        dp[0][0] = True\n\n        for j in range(1, n + 1):\n            if p[j - 1] == \"*\":\n                dp[0][j] = dp[0][j - 2]\n\n        for i in range(1, m + 1):\n            for j in range(1, n + 1):\n                if p[j - 1] in {s[i - 1], \".\"}:\n                    dp[i][j] = dp[i - 1][j - 1]\n                elif p[j - 1] == \"*\":\n                    dp[i][j] = dp[i][j - 2]\n                    if p[j - 2] in {s[i - 1], \".\"}:\n                        dp[i][j] = dp[i][j] or dp[i - 1][j]\n\n        return dp[m][n] == result\n"
      }
    },
