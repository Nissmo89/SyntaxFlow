    "oracle": {
      "python3": {
        "call": "Checker().maxEnvelopes(envelopes, {result})",
        "checker": "from bisect import bisect_left\nfrom typing import Any, List\n\nclass Checker:\n    def maxEnvelopes(self, envelopes: List[List[int]], result: Any) -> bool:\n        if not isinstance(result, int):\n            return False\n        envs = [list(e) for e in envelopes]\n        envs.sort(key=lambda x: (x[0], -x[1]))\n        lis = []\n        for _, h in envs:\n            i = bisect_left(lis, h)\n            if i == len(lis):\n                lis.append(h)\n            else:\n                lis[i] = h\n        return result == len(lis)\n"
      }
    },
