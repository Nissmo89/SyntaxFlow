    "oracle": {
      "python3": {
        "call": "Checker().findMaximizedCapital(k, w, profits, capital, {result})",
        "checker": "import heapq\n\nclass Checker:\n    def findMaximizedCapital(self, k, w, profits, capital, result):\n        projects = sorted(zip(capital, profits))\n        heap = []\n        i = 0\n        for _ in range(k):\n            while i < len(projects) and projects[i][0] <= w:\n                heapq.heappush(heap, -projects[i][1])\n                i += 1\n            if not heap:\n                break\n            w -= heapq.heappop(heap)\n        return w == result\n"
      }
    },
