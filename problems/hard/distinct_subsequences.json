    "oracle": {
      "python3": {
        "call": "Checker().numDistinct(s, t, {result})",
        "checker": "class Checker:\n    def numDistinct(self, s, t, result):\n        if not isinstance(result, int):\n            return False\n        m, n = len(s), len(t)\n        dp = [0] * (n + 1)\n        dp[0] = 1\n        for i in range(1, m + 1):\n            for j in range(n, 0, -1):\n                if s[i - 1] == t[j - 1]:\n                    dp[j] += dp[j - 1]\n        return result == dp[n]\n"
      }
    },
