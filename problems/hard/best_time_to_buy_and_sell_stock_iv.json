    "oracle": {
      "python3": {
        "call": "Checker().maxProfit(k, prices, {result})",
        "checker": "class Checker:\n    def maxProfit(self, k, prices, result) -> bool:\n        if not isinstance(result, int):\n            return False\n        n = len(prices)\n        if k < 0 or n < 0:\n            return False\n        if k == 0 or n < 2:\n            return result == 0\n        if k >= n // 2:\n            expected = sum(max(0, prices[i] - prices[i - 1]) for i in range(1, n))\n            return result == expected\n        hold = [-(10**18)] * (k + 1)\n        free = [0] * (k + 1)\n        for price in prices:\n            for t in range(1, k + 1):\n                hold[t] = max(hold[t], free[t - 1] - price)\n                free[t] = max(free[t], hold[t] + price)\n        expected = max(free)\n        return result == expected\n"
      }
    },
