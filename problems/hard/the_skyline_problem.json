    "oracle": {
      "python3": {
        "call": "Checker().getSkyline(buildings, {result})",
        "checker": "from typing import Any, List, Tuple\n\nclass Checker:\n    def getSkyline(self, buildings: List[List[int]], result: Any) -> bool:\n        if not isinstance(result, list):\n            return False\n        for point in result:\n            if not isinstance(point, list) or len(point) != 2:\n                return False\n            if any(not isinstance(v, int) for v in point):\n                return False\n\n        expected = self._skyline(buildings)\n        return result == expected\n\n    def _skyline(self, buildings: List[List[int]]) -> List[List[int]]:\n        events: List[Tuple[int, int]] = []\n        for building in buildings:\n            if not isinstance(building, list) or len(building) != 3:\n                return []\n            L, R, H = building\n            if not all(isinstance(v, int) for v in building):\n                return []\n            if not (0 <= L < R and H >= 1):\n                return []\n            events.append((L, -H))\n            events.append((R, H))\n\n        events.sort()\n        import heapq\n\n        live = [0]\n        removed = {}\n        result = []\n        prev = 0\n\n        for x, h in events:\n            if h < 0:\n                heapq.heappush(live, h)\n            else:\n                removed[-h] = removed.get(-h, 0) + 1\n            while live[0] in removed:\n                top = live[0]\n                heapq.heappop(live)\n                removed[top] -= 1\n                if removed[top] == 0:\n                    del removed[top]\n            curr = -live[0]\n            if curr != prev:\n                result.append([x, curr])\n                prev = curr\n        return result\n"
      }
    },
