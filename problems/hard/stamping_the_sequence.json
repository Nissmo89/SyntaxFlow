    "oracle": {
      "python3": {
        "call": "Checker().movesToStamp(stamp, target, {result})",
        "checker": "class Checker:\n    def movesToStamp(self, stamp, target, result):\n        if not isinstance(result, list):\n            return False\n        n = len(target)\n        m = len(stamp)\n        if len(result) > 10 * n:\n            return False\n        cur = ['?'] * n\n        for pos in result:\n            if not isinstance(pos, int) or pos < 0 or pos + m > n:\n                return False\n            for j, ch in enumerate(stamp):\n                    cur[pos + j] = ch\n        return ''.join(cur) == target\n"
      }
    },
