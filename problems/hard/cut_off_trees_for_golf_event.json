    "oracle": {
      "python3": {
        "call": "Checker().cutOffTree(forest, {result})",
        "checker": "from collections import deque\nimport heapq\n\nclass Checker:\n    def cutOffTree(self, forest, result):\n        if not isinstance(result, int):\n            return False\n        if not isinstance(forest, list) or not forest or not isinstance(forest[0], list) or not forest[0]:\n            return False\n        rows = len(forest)\n        cols = len(forest[0])\n        if any(not isinstance(row, list) or len(row) != cols for row in forest):\n            return False\n        if forest[0][0] == 0:\n            return result == -1\n\n        trees = []\n        for r in range(rows):\n            for c in range(cols):\n                v = forest[r][c]\n                if not isinstance(v, int) or v < 0:\n                    return False\n                if v > 1:\n                    heapq.heappush(trees, (v, r, c))\n\n        def bfs(sr, sc, tr, tc):\n            if sr == tr and sc == tc:\n                return 0\n            q = deque([(sr, sc, 0)])\n            seen = {(sr, sc)}\n            while q:\n                r, c, d = q.popleft()\n                for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                    nr, nc = r + dr, c + dc\n                    if 0 <= nr < rows and 0 <= nc < cols and forest[nr][nc] > 0 and (nr, nc) not in seen:\n                        if nr == tr and nc == tc:\n                            return d + 1\n                        seen.add((nr, nc))\n                        q.append((nr, nc, d + 1))\n            return -1\n\n        total = 0\n        cr = cc = 0\n        while trees:\n            _, tr, tc = heapq.heappop(trees)\n            dist = bfs(cr, cc, tr, tc)\n            if dist == -1:\n                return result == -1\n            total += dist\n            cr, cc = tr, tc\n        return result == total\n"
      }
    },
