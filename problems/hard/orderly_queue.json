        "checker": "class Checker:\n    def orderlyQueue(self, s, k, result):\n        if k > 1:\n            expected = ''.join(sorted(s))\n        else:\n            expected = s\n            for _ in range(len(s)):\n                s = s[1:] + s[0]\n                if s < expected:\n                    expected = s\n        return result == expected\n"
      }
