    "oracle": {
      "python3": {
        "call": "Checker().check(lists, {result})",
        "checker": "import json\n\nclass Checker:\n    def check(self, lists, result):\n        expected = []\n        for values in lists:\n            if not isinstance(values, list):\n                return False\n            expected.extend(values)\n        expected.sort()\n        try:\n            got = json.loads(result) if isinstance(result, str) else result\n        except Exception:\n            return False\n        if isinstance(got, list) and len(got) == 1 and isinstance(got[0], list):\n            got = got[0]\n        return got == expected\n"
      }
    },
