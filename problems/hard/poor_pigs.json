        "checker": "class Checker:\n    def poorPigs(self, buckets, minutesToDie, minutesToTest, result):\n        if not isinstance(result, int):\n            return False\n        if buckets < 1 or minutesToDie < 1 or minutesToTest < minutesToDie:\n            return False\n        base = minutesToTest // minutesToDie + 1\n        expected = 0\n        capacity = 1\n        while capacity < buckets:\n            capacity *= base\n            expected += 1\n        return result == expected\n"
      }
