    "oracle": {
      "python3": {
        "call": "Checker().minRefuelStops(target, startFuel, stations, {result})",
        "checker": "import heapq\nfrom typing import Any\n\nclass Checker:\n    def minRefuelStops(self, target: int, startFuel: int, stations: list[list[int]], result: Any) -> bool:\n        if not isinstance(result, int):\n            return False\n        arr = [list(s) for s in stations]\n        arr.append([target, 0])\n        fuel = startFuel\n        heap = []\n        stops = 0\n        idx = 0\n        while fuel < target:\n            while idx < len(arr) and arr[idx][0] <= fuel:\n                heapq.heappush(heap, -arr[idx][1])\n                idx += 1\n            if not heap:\n                expected = -1\n                return result == expected\n            fuel += -heapq.heappop(heap)\n            stops += 1\n        return result == stops\n"
      }
    },
