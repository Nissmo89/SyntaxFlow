    "oracle": {
      "python3": {
        "call": "Checker().check(expression, {result})",
        "checker": "class Checker(object):\n    def check(self, expression, result):\n        st = [[]]\n        for ch in expression:\n            if ch == '&':\n                st.append([all])\n            elif ch == '|':\n                st.append([any])\n            elif ch == '!':\n                st.append([lambda q: not q[0]])\n            elif ch == 't':\n                st[-1].append(True)\n            elif ch == 'f':\n                st[-1].append(False)\n            elif ch == ')':\n                operation, *args = st.pop()\n                st[-1].append(operation(args))\n        return st[0][0] == result\n"
      }
    },
