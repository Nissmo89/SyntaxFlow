    "oracle": {
      "python3": {
        "call": "Checker().countDigitOne(n, {result})",
        "checker": "class Checker:\n    def countDigitOne(self, n, result):\n        if not isinstance(result, int):\n            return False\n        count = 0\n        factor = 1\n        while factor <= n:\n            lower = n % factor\n            cur = (n // factor) % 10\n            higher = n // (factor * 10)\n            if cur == 0:\n                count += higher * factor\n            elif cur == 1:\n                count += higher * factor + lower + 1\n            else:\n                count += (higher + 1) * factor\n            factor *= 10\n        return result == count\n"
      }
    },
