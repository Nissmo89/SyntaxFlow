    "oracle": {
      "python3": {
        "call": "Checker().countSmaller(nums, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def _expected(self, nums: List[int]) -> List[int]:\n        values = sorted(set(nums))\n        index = {v: i + 1 for i, v in enumerate(values)}\n        bit = [0] * (len(values) + 2)\n\n        def add(i: int, delta: int) -> None:\n            while i < len(bit):\n                bit[i] += delta\n                i += i & -i\n\n        def sum_(i: int) -> int:\n            s = 0\n            while i > 0:\n                s += bit[i]\n                i -= i & -i\n            return s\n\n        ans = []\n        for x in reversed(nums):\n            ix = index[x]\n            ans.append(sum_(ix - 1))\n            add(ix, 1)\n        ans.reverse()\n        return ans\n\n    def countSmaller(self, nums: Any, result: Any) -> bool:\n        if not isinstance(nums, list) or not isinstance(result, list):\n            return False\n        if len(result) != len(nums):\n            return False\n        if any(not isinstance(x, int) for x in nums):\n            return False\n        if any(not isinstance(x, int) for x in result):\n            return False\n        if any(x < 0 or x > len(nums) for x in result):\n            return False\n        return result == self._expected(nums)\n"
      }
    },
