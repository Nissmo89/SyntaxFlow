{
  "id": "count_of_smaller_numbers_after_self",
  "title": "Count of Smaller Numbers After Self",
  "difficulty": "Hard",
  "category": "Algorithms",
  "tags": [
    "Array",
    "Binary Search",
    "Divide and Conquer",
