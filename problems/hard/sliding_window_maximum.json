    "oracle": {
      "python3": {
        "call": "Checker().check(nums, k, {result})",
        "checker": "from collections import deque\nfrom typing import Any, List\n\nclass Checker:\n    def check(self, nums: List[int], k: int, result: Any) -> bool:\n        if not isinstance(nums, list) or not isinstance(k, int):\n            return False\n        if k < 1 or k > len(nums):\n            return False\n        if not isinstance(result, list):\n            return False\n        if len(result) != len(nums) - k + 1:\n            return False\n        if any(not isinstance(x, int) for x in result):\n            return False\n\n        expected = []\n        q = deque()\n        for idx, num in enumerate(nums):\n            while q and q[-1] < num:\n                q.pop()\n            q.append(num)\n            if idx >= k and nums[idx - k] == q[0]:\n                q.popleft()\n            if idx >= k - 1:\n                expected.append(q[0])\n        return result == expected\n"
      }
    },
