    "oracle": {
      "python3": {
        "call": "Checker().check(s, words, {result})",
        "checker": "from collections import Counter, defaultdict\n\nclass Checker:\n    def check(self, s, words, result):\n        if not isinstance(result, list):\n            return False\n        if any(not isinstance(x, int) for x in result):\n            return False\n        if len(result) != len(set(result)):\n            return False\n\n        if not s or not words:\n            return result == []\n\n        word_len = len(words[0])\n        if word_len == 0:\n            return False\n        if any(len(w) != word_len for w in words):\n            return False\n\n        word_count = len(words)\n        target = Counter(words)\n        expected = []\n\n        for offset in range(word_len):\n            left = offset\n            right = offset\n            window = defaultdict(int)\n            used = 0\n\n            while right + word_len <= len(s):\n                word = s[right:right + word_len]\n                right += word_len\n\n                if word in target:\n                    window[word] += 1\n                    used += 1\n                    while window[word] > target[word]:\n                        left_word = s[left:left + word_len]\n                        window[left_word] -= 1\n                        left += word_len\n                        used -= 1\n                    if used == word_count:\n                        expected.append(left)\n                        left_word = s[left:left + word_len]\n                        window[left_word] -= 1\n                        left += word_len\n                        used -= 1\n                else:\n                    window.clear()\n                    used = 0\n                    left = right\n\n        return sorted(result) == sorted(expected)\n"
      }
    },
