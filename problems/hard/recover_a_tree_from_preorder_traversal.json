        "kotlin": "treeNodeToArray(Solution().recoverFromPreorder({traversal}))",
        "go": "treeNodeToArray(recoverFromPreorder({traversal}))",
        "dart": "tree_node_to_array(Solution().recoverFromPreorder({traversal}))",
