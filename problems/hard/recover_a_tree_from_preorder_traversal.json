    "judge": {
      "type": "exact"
    },
    "limits": {
      "time_ms": 200,
      "memory_mb": 300
    },
    "oracle": {
      "python3": {
        "call": "Checker().recoverFromPreorder(traversal, {result})",
        "checker": "class Checker:\n    def _build(self, values):\n        if not values:\n            return None\n        nodes = [None if v is None else TreeNode(v) for v in values]\n        kids = nodes[::-1]\n        root = kids.pop()\n        for node in nodes:\n            if node is not None:\n                if kids:\n                    node.left = kids.pop()\n                if kids:\n                    node.right = kids.pop()\n        return root\n\n    def _serialize(self, node, depth=0):\n        if node is None:\n            return []\n        return [\"-\" * depth + str(node.val)] + self._serialize(node.left, depth + 1) + self._serialize(node.right, depth + 1)\n\n    def recoverFromPreorder(self, traversal, result):\n        if not isinstance(result, list):\n            return False\n        root = self._build(result)\n        return \"\".join(self._serialize(root)) == traversal\n"
      }
    },
