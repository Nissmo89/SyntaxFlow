    "oracle": {
      "python3": {
        "call": "Checker().maxSumOfThreeSubarrays(nums, k, {result})",
        "checker": "class Checker:\n    def maxSumOfThreeSubarrays(self, nums, k, result):\n        if not isinstance(result, list) or len(result) != 3:\n            return False\n        if any((not isinstance(x, int)) for x in result):\n            return False\n        i, j, l = result\n        if not (0 <= i < j < l):\n            return False\n        if j - i < k or l - j < k:\n            return False\n        n = len(nums)\n        if l + k > n:\n            return False\n        if k <= 0 or 3 * k > n:\n            return False\n\n        sum1 = sum(nums[:k])\n        sum2 = sum(nums[k:2 * k])\n        sum3 = sum(nums[2 * k:3 * k])\n\n        max1 = sum1\n        max12 = sum1 + sum2\n        max123 = sum1 + sum2 + sum3\n\n        index1 = 0\n        index12_1 = 0\n        index12_2 = k\n        ans = [0, k, 2 * k]\n\n        for idx in range(1, n - 3 * k + 1):\n            sum1 = sum1 - nums[idx - 1] + nums[idx + k - 1]\n            sum2 = sum2 - nums[idx + k - 1] + nums[idx + 2 * k - 1]\n            sum3 = sum3 - nums[idx + 2 * k - 1] + nums[idx + 3 * k - 1]\n\n            if sum1 > max1:\n                max1 = sum1\n                index1 = idx\n\n            if max1 + sum2 > max12:\n                max12 = max1 + sum2\n                index12_1 = index1\n                index12_2 = idx + k\n\n            if max12 + sum3 > max123:\n                max123 = max12 + sum3\n                ans = [index12_1, index12_2, idx + 2 * k]\n\n        return result == ans\n"
      }
    },
