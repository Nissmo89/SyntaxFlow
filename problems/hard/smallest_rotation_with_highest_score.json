      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(nums, {result})",
        "checker": "class Checker:\n    def check(self, nums, result):\n        n = len(nums)\n        best = 0\n        best_score = -1\n        for k in range(n):\n            score = 0\n            for i in range(n):\n                if nums[(i + k) % n] <= i:\n                    score += 1\n            if score > best_score:\n                best_score = score\n                best = k\n        return int(result) == best\n"
      }
    },
