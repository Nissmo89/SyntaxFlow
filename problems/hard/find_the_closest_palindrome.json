    "oracle": {
      "python3": {
        "call": "Checker().nearestPalindromic(n, {result})",
        "checker": "class Checker:\n    def nearestPalindromic(self, n, result):\n        if not isinstance(result, str):\n            return False\n        x = int(n)\n        length = len(n)\n        candidates = set()\n        candidates.add(10 ** (length - 1) - 1)\n        candidates.add(10 ** length + 1)\n        prefix = int(n[:(length + 1) // 2])\n        half_len = (length + 1) // 2\n        for delta in (-1, 0, 1):\n            cur = prefix + delta\n            if cur < 0:\n                continue\n            left = str(cur).zfill(half_len)\n            if length % 2 == 0:\n                pal = left + left[::-1]\n            else:\n                pal = left + left[:-1][::-1]\n            candidates.add(int(pal))\n        candidates.discard(x)\n        expected = str(min(candidates, key=lambda value: (abs(value - x), value)))\n        return expected == result\n"
      }
    },
