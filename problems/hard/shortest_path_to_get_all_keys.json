    "oracle": {
      "python3": {
        "call": "Checker().shortestPathAllKeys(grid, {result})",
        "checker": "from collections import deque\nclass Checker:\n    def shortestPathAllKeys(self, grid, result):\n        if not isinstance(result, int):\n            return False\n        m, n = len(grid), len(grid[0])\n        start = None\n        total = 0\n        for i in range(m):\n            for j, ch in enumerate(grid[i]):\n                if ch == '@': start = (i, j)\n                if 'a' <= ch <= 'f': total += 1\n        target = (1 << total) - 1\n        q = deque([(start[0], start[1], 0)])\n        seen = {(start[0], start[1], 0)}\n        d = [(1,0),(-1,0),(0,1),(0,-1)]\n        steps = 0\n        while q:\n            for _ in range(len(q)):\n                r,c,mask = q.popleft()\n                if mask == target:\n                    return result == steps\n                for dr,dc in d:\n                    nr,nc = r+dr,c+dc\n                    if not (0<=nr<m and 0<=nc<n):\n                        continue\n                    ch = grid[nr][nc]\n                    if ch == '#':\n                        continue\n                    nmask = mask\n                    if 'a' <= ch <= 'f': nmask |= 1 << (ord(ch)-97)\n                    if 'A' <= ch <= 'F' and not (nmask & (1 << (ord(ch.lower())-97))):\n                        continue\n                    st = (nr,nc,nmask)\n                    if st not in seen:\n                        seen.add(st)\n                        q.append(st)\n            steps += 1\n        return result == -1\n"
      }
    },
