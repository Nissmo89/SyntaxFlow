    "oracle": {
      "python3": {
        "call": "Checker().canCross(stones, {result})",
        "checker": "class Checker:\n    def canCross(self, stones, result):\n        if not isinstance(stones, list) or len(stones) < 2:\n            return False\n        if not isinstance(result, bool):\n            return False\n        if stones[0] != 0:\n            return False\n        if any(not isinstance(x, int) for x in stones):\n            return False\n        if any(stones[i] >= stones[i + 1] for i in range(len(stones) - 1)):\n            return False\n        dp = {stone: set() for stone in stones}\n        dp[0] = {0}\n        for stone in stones:\n            for jump in dp[stone]:\n                for jump_distance in (jump - 1, jump, jump + 1):\n                    if jump_distance > 0 and stone + jump_distance in dp:\n                        dp[stone + jump_distance].add(jump_distance)\n        expected = len(dp[stones[-1]]) > 0\n        return result is expected\n"
      }
    },
