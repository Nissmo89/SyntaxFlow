    "oracle": {
      "python3": {
        "call": "Checker().getPermutation(n, k, {result})",
        "checker": "class Checker:\n    def getPermutation(self, n, k, result):\n        if not isinstance(result, str):\n            return False\n        if len(result) != n:\n            return False\n        expected = [str(i) for i in range(1, n + 1)]\n        if sorted(result) != expected:\n            return False\n        nums = expected[:]\n        factorial = [1] * (n + 1)\n        for i in range(1, n + 1):\n            factorial[i] = factorial[i - 1] * i\n        k -= 1\n        res = []\n        for remaining in range(n, 0, -1):\n            block = factorial[remaining - 1]\n            idx = k // block\n            k %= block\n            res.append(nums.pop(idx))\n        return \"\".join(res) == result\n"
      }
    },
