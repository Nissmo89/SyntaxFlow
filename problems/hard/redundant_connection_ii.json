    "oracle": {
      "python3": {
        "call": "Checker().findRedundantDirectedConnection(edges, {result})",
        "checker": "class Checker:\n    def findRedundantDirectedConnection(self, edges, result):\n        if not isinstance(result, list) or len(result) != 2:\n            return False\n        if any(not isinstance(x, int) for x in result):\n            return False\n        n = len(edges)\n        if len(edges) != n:\n            return False\n        if len(result) != 2:\n            return False\n        u, v = result\n        if u < 1 or u > n or v < 1 or v > n or u == v:\n            return False\n\n        indeg = [0] * (n + 1)\n        g = [[] for _ in range(n + 1)]\n        removed = False\n        for a, b in edges:\n            if not removed and a == u and b == v:\n                removed = True\n                continue\n            indeg[b] += 1\n            g[a].append(b)\n            if indeg[b] > 1:\n                return False\n\n        roots = [i for i in range(1, n + 1) if indeg[i] == 0]\n        if len(roots) != 1:\n            return False\n\n        root = roots[0]\n        seen = [False] * (n + 1)\n        stack = [root]\n        seen[root] = True\n        count = 0\n        while stack:\n            node = stack.pop()\n            count += 1\n            for nxt in g[node]:\n                if seen[nxt]:\n                    return False\n                seen[nxt] = True\n                stack.append(nxt)\n        return count == n and removed\n"
      }
    },
