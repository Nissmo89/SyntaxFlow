    "oracle": {
      "python3": {
        "call": "Checker().smallestGoodBase(n, {result})",
        "checker": "class Checker:\n    def smallestGoodBase(self, n, result):\n        if not isinstance(result, str):\n            return False\n        if not result.isdigit():\n            return False\n        target = int(n)\n        base = int(result)\n        if base < 2:\n            return False\n        value = 1\n        term = 1\n        for _ in range(60):\n            term *= base\n            value += term\n            if value == target:\n                break\n            if value > target:\n                return False\n        else:\n            return False\n\n        for k in range(2, base):\n            total = 1\n            term = 1\n            while total < target:\n                term *= k\n                total += term\n            if total == target:\n                return False\n        return True\n"
      }
    },
