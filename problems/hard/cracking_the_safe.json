    "limits": {
      "time_ms": 2500,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(n, k, {result})",
        "checker": "class Checker:\n    def check(self, n, k, result):\n        if not isinstance(result, str):\n            return False\n        if n < 1 or n > 4 or k < 1 or k > 10:\n            return False\n        if k ** n > 4096:\n            return False\n        expected_length = (k ** n) + n - 1\n        if len(result) != expected_length:\n            return False\n        alphabet = set(str(i) for i in range(k))\n        if any(ch not in alphabet for ch in result):\n            return False\n        seen = set()\n        for i in range(len(result) - n + 1):\n            window = result[i:i + n]\n            if window in seen:\n                return False\n            seen.add(window)\n        return len(seen) == k ** n\n"
      }
    },
