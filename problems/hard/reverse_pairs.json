    "oracle": {
      "python3": {
        "call": "Checker().reversePairs(nums, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def reversePairs(self, nums: List[int], result: Any) -> bool:\n        if not isinstance(result, int):\n            return False\n\n        def count(arr: List[int]) -> int:\n            def sort_count(lo: int, hi: int) -> int:\n                if hi - lo <= 1:\n                    return 0\n                mid = (lo + hi) // 2\n                total = sort_count(lo, mid) + sort_count(mid, hi)\n                j = mid\n                for i in range(lo, mid):\n                    while j < hi and arr[i] > 2 * arr[j]:\n                        j += 1\n                    total += j - mid\n                merged = []\n                i, j = lo, mid\n                while i < mid and j < hi:\n                    if arr[i] <= arr[j]:\n                        merged.append(arr[i])\n                        i += 1\n                    else:\n                        merged.append(arr[j])\n                        j += 1\n                merged.extend(arr[i:mid])\n                merged.extend(arr[j:hi])\n                arr[lo:hi] = merged\n                return total\n\n            return sort_count(0, len(arr))\n\n        return result == count(list(nums))\n"
      }
    },
