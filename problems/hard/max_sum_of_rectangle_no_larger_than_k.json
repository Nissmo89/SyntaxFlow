      "time_ms": 2000,
      "memory_mb": 512
    },
    "oracle": {
      "python3": {
        "call": "Checker().maxSumSubmatrix(matrix, k, {result})",
        "checker": "class Checker:\n    def maxSumSubmatrix(self, matrix, k, result):\n        m = len(matrix)\n        n = len(matrix[0])\n        best = float('-inf')\n        for top in range(m):\n            col = [0] * n\n            for bottom in range(top, m):\n                for c in range(n):\n                    col[c] += matrix[bottom][c]\n                for left in range(n):\n                    s = 0\n                    for right in range(left, n):\n                        s += col[right]\n                        if s <= k and s > best:\n                            best = s\n        return result == best\n"
      }
    },
