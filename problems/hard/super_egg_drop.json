    "oracle": {
      "python3": {
        "call": "Checker().superEggDrop(k, n, {result})",
        "checker": "class Checker:\n    def superEggDrop(self, k, n, result):\n        if not isinstance(result, int):\n            return False\n        if k == 1:\n            return result == n\n        def can(moves):\n            total = 0\n            cur = 1\n            for _ in range(k):\n                cur = cur * (moves - _)\n                cur //= (_ + 1)\n                total += cur\n                if total >= n:\n                    return True\n            return total >= n\n        lo, hi = 0, n\n        while lo < hi:\n            mid = (lo + hi) // 2\n            if can(mid):\n                hi = mid\n            else:\n                lo = mid + 1\n        return result == lo\n"
      }
    },
