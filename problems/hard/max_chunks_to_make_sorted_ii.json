    "oracle": {
      "python3": {
        "call": "Checker().check(arr, {result})",
        "checker": "from collections import Counter\n\nclass Checker:\n    def check(self, arr, result):\n        diff = Counter()\n        chunks = 0\n        for left, right in zip(arr, sorted(arr)):\n            diff[left] += 1\n            if diff[left] == 0:\n                del diff[left]\n            diff[right] -= 1\n            if diff[right] == 0:\n                del diff[right]\n            if not diff:\n                chunks += 1\n        return result == chunks\n"
      }
    },
