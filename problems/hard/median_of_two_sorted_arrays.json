    "oracle": {
      "python3": {
        "call": "Checker().findMedianSortedArrays(nums1, nums2, {result})",
        "checker": "class Checker:\n    def findMedianSortedArrays(self, nums1, nums2, result):\n        merged = sorted(nums1 + nums2)\n        n = len(merged)\n        if n == 0:\n            return False\n        if n % 2 == 1:\n            expected = float(merged[n // 2])\n        else:\n            expected = (merged[n // 2 - 1] + merged[n // 2]) / 2.0\n        return abs(result - expected) <= 1e-9\n"
      }
    },
