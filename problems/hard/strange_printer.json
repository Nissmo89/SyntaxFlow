    "oracle": {
      "python3": {
        "call": "Checker().strangePrinter({s}, {result})",
        "checker": "class Checker:\n    def strangePrinter(self, s, result):\n        if not isinstance(result, int):\n            return False\n        if result < 1:\n            return False\n        n = len(s)\n        if n == 0:\n            return result == 0\n        t = []\n        for ch in s:\n            if not t or t[-1] != ch:\n                t.append(ch)\n        m = len(t)\n        dp = [[0] * m for _ in range(m)]\n        for i in range(m):\n            dp[i][i] = 1\n        for length in range(2, m + 1):\n            for i in range(m - length + 1):\n                j = i + length - 1\n                best = dp[i][j - 1] + 1\n                for k in range(i, j):\n                    if t[k] == t[j]:\n                        left = dp[i][k]\n                        mid = 0 if k + 1 > j - 1 else dp[k + 1][j - 1]\n                        cand = left + mid\n                        if cand < best:\n                            best = cand\n                dp[i][j] = best\n        return result == dp[0][m - 1]\n"
      }
    },
