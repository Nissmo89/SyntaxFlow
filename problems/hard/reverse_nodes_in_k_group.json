      "time_ms": 1000,
      "memory_mb": 256
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(head, k, {result})",
        "checker": "import json\n\nclass Checker:\n    def check(self, head, k, result):\n        try:\n            got = json.loads(result) if isinstance(result, str) else result\n        except Exception:\n            return False\n        if not isinstance(got, list):\n            return False\n\n        expected = list(head)\n        for start in range(0, len(expected), k):\n            if start + k <= len(expected):\n                expected[start:start + k] = reversed(expected[start:start + k])\n        return got == expected\n"
      }
    },
