    "limits": {
      "time_ms": 2000,
      "memory_mb": 300
    },
    "oracle": {
      "python3": {
        "call": "Checker().addOperators(num, target, {result})",
        "checker": "from typing import Any, List\n\nclass Checker:\n    def addOperators(self, num: str, target: int, result: Any) -> bool:\n        if not isinstance(result, list) or any(not isinstance(x, str) for x in result):\n            return False\n\n        expected = set()\n        n = len(num)\n\n        def dfs(idx: int, path: str, curr: int, prev: int) -> None:\n            if idx == n:\n                if curr == target:\n                    expected.add(path)\n                return\n            for i in range(idx, n):\n                if i > idx and num[idx] == \"0\":\n                    break\n                part = num[idx : i + 1]\n                val = int(part)\n                if idx == 0:\n                    dfs(i + 1, part, val, val)\n                else:\n                    dfs(i + 1, path + \"+\" + part, curr + val, val)\n                    dfs(i + 1, path + \"-\" + part, curr - val, -val)\n                    dfs(i + 1, path + \"*\" + part, (curr - prev) + prev * val, prev * val)\n\n        dfs(0, \"\", 0, 0)\n        return set(result) == expected\n"
      }
    },
