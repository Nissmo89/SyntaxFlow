    "oracle": {
      "python3": {
        "call": "Checker().catMouseGame(graph, {result})",
        "checker": "from collections import deque\n\nclass Checker:\n    def catMouseGame(self, graph, result):\n        n = len(graph)\n        MOUSE, CAT = 0, 1\n        MOUSE_WIN, CAT_WIN, DRAW = 1, 2, 0\n        results = {}\n        for i in range(1, n):\n            results[0, i, CAT] = results[0, i, MOUSE] = MOUSE_WIN\n            results[i, i, CAT] = results[i, i, MOUSE] = CAT_WIN\n        degree = {}\n        for mouse in range(1, n):\n            for cat in range(1, n):\n                degree[mouse, cat, MOUSE] = len(graph[mouse])\n                degree[mouse, cat, CAT] = len(graph[cat]) - int(0 in graph[cat])\n        q = deque(results.keys())\n        while q:\n            mouse, cat, turn = q.popleft()\n            cur = results[mouse, cat, turn]\n            if turn == MOUSE:\n                prev_states = [(mouse, prev_cat, CAT) for prev_cat in graph[cat]]\n            else:\n                prev_states = [(prev_mouse, cat, MOUSE) for prev_mouse in graph[mouse]]\n            for prev in prev_states:\n                if prev in results:\n                    continue\n                pm, pc, pt = prev\n                if pc == 0:\n                    continue\n                degree[prev] -= 1\n                mover_wins = (cur == MOUSE_WIN and pt == MOUSE) or (cur == CAT_WIN and pt == CAT)\n                if mover_wins or degree[prev] == 0:\n                    results[prev] = cur\n                    q.append(prev)\n        return result == results.get((1, 2, MOUSE), DRAW)\n"
      }
    },
