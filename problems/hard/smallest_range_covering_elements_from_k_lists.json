    "oracle": {
      "python3": {
        "call": "Checker().smallestRange(nums, {result})",
        "checker": "import heapq\n\nclass Checker:\n    def smallestRange(self, nums, result):\n        if not isinstance(result, list) or len(result) != 2:\n            return False\n        if not all(isinstance(x, int) for x in result):\n            return False\n        if any(not isinstance(row, list) or len(row) == 0 for row in nums):\n            return False\n        for row in nums:\n            if any(row[i] > row[i + 1] for i in range(len(row) - 1)):\n                return False\n\n        expected = self.solve(nums)\n        return result == expected\n\n    def solve(self, nums):\n        heap = []\n        cur_max = -10**18\n        for i, row in enumerate(nums):\n            heapq.heappush(heap, (row[0], i, 0))\n            if row[0] > cur_max:\n                cur_max = row[0]\n\n        best = [heap[0][0], cur_max]\n        while True:\n            cur_min, list_idx, idx = heapq.heappop(heap)\n            if cur_max - cur_min < best[1] - best[0] or (\n                cur_max - cur_min == best[1] - best[0] and cur_min < best[0]\n            ):\n                best = [cur_min, cur_max]\n            if idx + 1 == len(nums[list_idx]):\n                break\n            nxt = nums[list_idx][idx + 1]\n            heapq.heappush(heap, (nxt, list_idx, idx + 1))\n            if nxt > cur_max:\n                cur_max = nxt\n        return best\n"
      }
    },
