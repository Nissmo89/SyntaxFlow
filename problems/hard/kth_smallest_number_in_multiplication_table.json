    "oracle": {
      "python3": {
        "call": "Checker().findKthNumber(m, n, k, result)",
        "checker": "class Checker:\n    def findKthNumber(self, m, n, k, result):\n        if not isinstance(result, int):\n            return False\n        if result < 1 or result > m * n:\n            return False\n\n        def count_le(x):\n            total = 0\n            for i in range(1, m + 1):\n                total += min(n, x // i)\n            return total\n\n        def count_lt(x):\n            return count_le(x - 1)\n\n        return count_le(result) >= k and count_lt(result) < k\n"
      }
    },
