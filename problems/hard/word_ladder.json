    "oracle": {
      "python3": {
        "call": "Checker().ladderLength(beginWord, endWord, wordList, {result})",
        "checker": "import copy\n\nfrom typing import List\n\nfrom collections import deque\n\n\nclass Solution:\n    def ladderLength(self, beginWord: str, endWord: str, wordList: List[str]) -> int:\n        word_set = set(wordList)\n        if endWord not in word_set:\n            return 0\n\n        queue = deque([(beginWord, 1)])\n        while queue:\n            word, steps = queue.popleft()\n            if word == endWord:\n                return steps\n\n            for i in range(len(word)):\n                prefix = word[:i]\n                suffix = word[i + 1 :]\n                for code in range(ord(\"a\"), ord(\"z\") + 1):\n                    candidate = prefix + chr(code) + suffix\n                    if candidate in word_set:\n                        word_set.remove(candidate)\n                        queue.append((candidate, steps + 1))\n\n        return 0\n\ndef array_to_list_node_local(values):\n    dummy = ListNode(0)\n    tail = dummy\n    for value in values:\n        tail.next = ListNode(value)\n        tail = tail.next\n    return dummy.next\n\ndef array_to_tree_node_local(values):\n    if not values:\n        return None\n    root = TreeNode(values[0])\n    queue = deque([root])\n    index = 1\n    while queue and index < len(values):\n        node = queue.popleft()\n        if index < len(values) and values[index] is not None:\n            node.left = TreeNode(values[index])\n            queue.append(node.left)\n        index += 1\n        if index < len(values) and values[index] is not None:\n            node.right = TreeNode(values[index])\n            queue.append(node.right)\n        index += 1\n    return root\n\ndef list_node_to_array_local(node):\n    out = []\n    seen = 0\n    while node is not None and seen < 100000:\n        out.append(node.val)\n        node = node.next\n        seen += 1\n    return out\n\ndef tree_node_to_array_local(root):\n    if root is None:\n        return []\n    out = []\n    q = deque([root])\n    while q:\n        node = q.popleft()\n        if node is None:\n            out.append(None)\n            continue\n        out.append(node.val)\n        q.append(node.left)\n        q.append(node.right)\n    while out and out[-1] is None:\n        out.pop()\n    return out\n\ndef deep_sort(value):\n    if isinstance(value, list):\n        normalized = [deep_sort(item) for item in value]\n        return sorted(normalized, key=lambda item: json.dumps(item, sort_keys=True))\n    if isinstance(value, dict):\n        return {key: deep_sort(val) for key, val in sorted(value.items())}\n    return value\n\ndef normalize_expected(value):\n    kind = \"int\"\n    if kind == \"list_node\":\n        return list_node_to_array_local(value)\n    if kind == \"tree_node\":\n        return tree_node_to_array_local(value)\n    return value\n\ndef normalize_actual(value):\n    return value\n\ndef prepare_input(value, kind):\n    if kind == \"tree_node\":\n        return array_to_tree_node_local(value)\n    if kind == \"list_node\":\n        return array_to_list_node_local(value)\n    return copy.deepcopy(value)\n\nclass Checker:\n    def ladderLength(self, beginWord, endWord, wordList, result):\n        prepared_beginWord = prepare_input(beginWord, \"string\"); prepared_endWord = prepare_input(endWord, \"string\"); prepared_wordList = prepare_input(wordList, \"array[string]\")\n        expected = Solution().ladderLength(prepared_beginWord, prepared_endWord, prepared_wordList)\n        expected = normalize_expected(expected)\n        actual = normalize_actual(result)\n        return deep_sort(expected) == deep_sort(actual)\n"
      }
    },
