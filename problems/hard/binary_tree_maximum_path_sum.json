    "oracle": {
      "python3": {
        "call": "Checker().maxPathSum(root, {result})",
        "checker": "class Checker:\n    def maxPathSum(self, root, result):\n        if not isinstance(result, int):\n            return False\n\n        best = -10**18\n\n        def dfs(node):\n            nonlocal best\n            if node is None:\n                return 0\n            left = max(dfs(node.left), 0)\n            right = max(dfs(node.right), 0)\n            best = max(best, node.val + left + right)\n            return node.val + max(left, right)\n\n        dfs(root)\n        return result == best\n"
      }
    },
