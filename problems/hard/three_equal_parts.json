    "oracle": {
      "python3": {
        "call": "Checker().threeEqualParts(arr, {result})",
        "checker": "class Checker:\n    def threeEqualParts(self, arr, result):\n        if not isinstance(result, list) or len(result) != 2:\n            return False\n        n = len(arr)\n        if result == [-1, -1]:\n            for i in range(n):\n                for j in range(i + 2, n):\n                    a = arr[:i + 1]\n                    b = arr[i + 1:j]\n                    c = arr[j:]\n                    def norm(x):\n                        k = 0\n                        while k < len(x) and x[k] == 0:\n                            k += 1\n                        return x[k:]\n                    if len(a) and len(b) and len(c) and norm(a) == norm(b) == norm(c):\n                        return False\n            return True\n        i, j = result\n        if not (0 <= i < j - 1 < n):\n            return False\n        a = arr[:i + 1]\n        b = arr[i + 1:j]\n        c = arr[j:]\n        def norm(x):\n            k = 0\n            while k < len(x) and x[k] == 0:\n                k += 1\n            return x[k:]\n        return len(a) > 0 and len(b) > 0 and len(c) > 0 and norm(a) == norm(b) == norm(c)\n"
      }
    },
