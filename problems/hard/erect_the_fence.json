    "oracle": {
      "python3": {
        "call": "Checker().outerTrees(trees, {result})",
        "checker": "class Checker:\n    def outerTrees(self, trees, result):\n        try:\n            points = [tuple(p) for p in trees]\n            returned = [tuple(p) for p in result]\n        except Exception:\n            return False\n\n        if any(len(p) != 2 for p in returned):\n            return False\n        if len(set(returned)) != len(returned):\n            return False\n\n        all_points = set(points)\n        if not set(returned).issubset(all_points):\n            return False\n\n        expected = self.boundary_points(points)\n        return set(returned) == expected\n\n    def cross(self, o, a, b):\n        return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])\n\n    def on_segment(self, a, b, p):\n        if self.cross(a, b, p) != 0:\n            return False\n        return (\n            min(a[0], b[0]) <= p[0] <= max(a[0], b[0]) and\n            min(a[1], b[1]) <= p[1] <= max(a[1], b[1])\n        )\n\n    def boundary_points(self, points):\n        pts = sorted(set(points))\n        if len(pts) <= 2:\n            return set(pts)\n\n        def build(seq):\n            hull = []\n            for p in seq:\n                while len(hull) >= 2 and self.cross(hull[-2], hull[-1], p) <= 0:\n                    hull.pop()\n                hull.append(p)\n            return hull\n\n        lower = build(pts)\n        upper = build(reversed(pts))\n        hull = lower[:-1] + upper[:-1]\n\n        vertices = []\n        seen = set()\n        for p in hull:\n            if p not in seen:\n                vertices.append(p)\n                seen.add(p)\n\n        if len(vertices) <= 2:\n            return set(pts)\n\n        boundary = set()\n        m = len(vertices)\n        for p in pts:\n            for i in range(m):\n                if self.on_segment(vertices[i], vertices[(i + 1) % m], p):\n                    boundary.add(p)\n                    break\n        return boundary\n"
      }
    },
