    "oracle": {
      "python3": {
        "call": "Checker().slidingPuzzle(board, {result})",
        "checker": "class Checker:\n    def slidingPuzzle(self, board, result):\n        if not isinstance(result, int):\n            return False\n        if result < -1 or result > 20:\n            return False\n        if not isinstance(board, list) or len(board) != 2:\n            return False\n        seen = set()\n        for row in board:\n            if not isinstance(row, list) or len(row) != 3:\n                return False\n            for x in row:\n                if not isinstance(x, int) or x < 0 or x > 5:\n                    return False\n                if x in seen:\n                    return False\n                seen.add(x)\n        return len(seen) == 6\n"
      }
    },
