{
  "id": "sliding_puzzle",
  "title": "Sliding Puzzle",
  "difficulty": "Hard",
  "category": "Algorithms",
  "tags": [
    "Array",
    "Dynamic Programming",
    "Backtracking",
    "Breadth-First Search",
    "Memoization",
