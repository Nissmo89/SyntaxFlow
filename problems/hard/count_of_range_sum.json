    "oracle": {
      "python3": {
        "call": "Checker().check(nums, lower, upper, {result})",
        "checker": "class Checker:\n    def check(self, nums, lower, upper, result):\n        if not isinstance(result, int):\n            return False\n        if not isinstance(nums, list):\n            return False\n        if not isinstance(lower, int) or not isinstance(upper, int):\n            return False\n        if lower > upper:\n            return False\n\n        prefix = [0]\n        total = 0\n        for x in nums:\n            if not isinstance(x, int):\n                return False\n            total += x\n            prefix.append(total)\n\n        def sort_count(arr):\n            n = len(arr)\n            if n <= 1:\n                return arr, 0\n            mid = n // 2\n            left, left_count = sort_count(arr[:mid])\n            right, right_count = sort_count(arr[mid:])\n            count = left_count + right_count\n\n            lo = 0\n            hi = 0\n            for value in left:\n                while lo < len(right) and right[lo] - value < lower:\n                    lo += 1\n                while hi < len(right) and right[hi] - value <= upper:\n                    hi += 1\n                count += hi - lo\n\n            merged = []\n            i = 0\n            j = 0\n            while i < len(left) and j < len(right):\n                if left[i] <= right[j]:\n                    merged.append(left[i])\n                    i += 1\n                else:\n                    merged.append(right[j])\n                    j += 1\n            if i < len(left):\n                merged.extend(left[i:])\n            if j < len(right):\n                merged.extend(right[j:])\n            return merged, count\n\n        expected = sort_count(prefix)[1]\n        return result == expected\n"
      }
    },
