    "judge": {
      "type": "exact"
    },
    "limits": {
      "time_ms": 2000,
      "memory_mb": 512
    },
    "oracle": {
      "python3": {
        "call": "Checker().check(rectangles, {result})",
        "checker": "class Checker:\n    def check(self, rectangles, result):\n        if not rectangles:\n            return result is False\n        area = 0\n        corners = set()\n        min_x = min(r[0] for r in rectangles)\n        min_y = min(r[1] for r in rectangles)\n        max_x = max(r[2] for r in rectangles)\n        max_y = max(r[3] for r in rectangles)\n        for x1, y1, x2, y2 in rectangles:\n            if x1 >= x2 or y1 >= y2:\n                return result is False\n            area += (x2 - x1) * (y2 - y1)\n            for pt in ((x1, y1), (x1, y2), (x2, y1), (x2, y2)):\n                if pt in corners:\n                    corners.remove(pt)\n                else:\n                    corners.add(pt)\n        expected = {\n            (min_x, min_y),\n            (min_x, max_y),\n            (max_x, min_y),\n            (max_x, max_y),\n        }\n        ok = area == (max_x - min_x) * (max_y - min_y) and corners == expected\n        return result == ok\n"
      }
    },
