    "oracle": {
      "python3": {
        "call": "Checker().check(expression, {result})",
        "checker": "class Checker(object):\n    def check(self, expression, result):\n        stack = []\n        res = []\n        cur = []\n        for ch in expression:\n            if ch.isalpha():\n                cur = [c + ch for c in (cur or [''])]\n            elif ch == '{':\n                stack.append(res)\n                stack.append(cur)\n                res, cur = [], []\n            elif ch == '}':\n                pre = stack.pop()\n                pre_res = stack.pop()\n                cur = [p + c for c in res + cur for p in (pre or [''])]\n                res = pre_res\n            elif ch == ',':\n                res += cur\n                cur = []\n        expected = sorted(set(res + cur))\n        return result == expected\n"
      }
    },
