    "oracle": {
      "python3": {
        "call": "Checker().splitArray(nums, k, {result})",
        "checker": "class Checker:\n    def splitArray(self, nums, k, result):\n        if not isinstance(result, int):\n            return False\n        low = max(nums)\n        high = sum(nums)\n        ans = high\n        while low <= high:\n            mid = low + (high - low) // 2\n            groups = 1\n            curr = 0\n            for num in nums:\n                if curr + num > mid:\n                    groups += 1\n                    curr = num\n                else:\n                    curr += num\n            if groups <= k:\n                ans = mid\n                high = mid - 1\n            else:\n                low = mid + 1\n        return result == ans\n"
      }
    },
